{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "allthingsbanana",
	"main": "worker/index.js",
	"compatibility_date": "2026-09-01",
	// the built Astro site; anything that isn't a file (like /api/feed) goes to the worker
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page"
	},
	"kv_namespaces": [
		// create with: npx wrangler kv namespace create FEED  (then paste the id here)
		{
			"binding": "FEED",
			"id": "8f9c453f65864182bf77b201f28f3ae2",
			"remote": true
		}
	],
	// serve the site on the real domain (Cloudflare creates the DNS records and certificate)
	"routes": [
		{ "pattern": "allthingsbanana.com", "custom_domain": true },
		{ "pattern": "www.allthingsbanana.com", "custom_domain": true }
	],
	// Banana Clicker: one shared tally of peeled bananas per country.
	// Bananadle: everyone's daily results, anonymously. Banana popularity: page views per day, anonymously
	"durable_objects": {
		"bindings": [
			{ "name": "PEELS", "class_name": "PeelCounter" },
			{ "name": "DEGREES", "class_name": "DegreesStats" },
			{ "name": "VISITS", "class_name": "VisitCounter" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["PeelCounter"] },
		{ "tag": "v2", "new_sqlite_classes": ["DegreesStats"] },
		{ "tag": "v3", "new_sqlite_classes": ["VisitCounter"] }
	],
	"triggers": {
		"crons": [
			"*/10 * * * *"
		]
	},
	"observability": {
		"enabled": true
	}
}