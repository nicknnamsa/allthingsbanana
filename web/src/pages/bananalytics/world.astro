---
import Base from '../../layouts/Base.astro';
import fao from '../../data/world/fao-bananas.json';
import hotspots from '../../data/world/hotspots.json';
const L = fao.years.length - 1;
const sat = (h: { lat: number; lon: number }) => `https://www.google.com/maps/@${h.lat},${h.lon},9000m/data=!3m1!1e3`;
const year = fao.years[L];
const banT = fao.world.banana.prod[L]!, plT = fao.world.plantain.prod[L]!;
const fmtMt = (t: number) => (t / 1e6).toFixed(1);
---
<Base wide section="world" image="/og/bananalytics.jpg"
      title="Banana World: where the world's bananas grow, on a map · All Things Banana"
      description={`An interactive map of banana and plantain farming in every country, 1961–${year}: production, area harvested and yield, from the UN's FAOSTAT data.`}>
  <header class="head">
    <div>
      <h1>Banana World</h1>
      <p>Where the world's bananas grow. In {year}, farms harvested <b>{fmtMt(banT)} million tonnes of bananas</b> and <b>{fmtMt(plT)} million tonnes of plantains and cooking bananas</b>.</p>
    </div>
    <div class="counter" title="World banana production divided evenly over the year, at about 118 g per banana">
      <span class="c-n num" id="counter">0</span>
      <span class="c-l">bananas grown since you opened this page</span>
    </div>
  </header>

  <div class="controls">
    <div class="seg" id="crop" role="group" aria-label="Crop">
      <button data-v="banana" class="on">Bananas</button><button data-v="plantain">Plantains &amp; cooking bananas</button><button data-v="both">Both</button>
    </div>
    <div class="seg" id="metric" role="group" aria-label="Measure">
      <button data-v="prod" class="on">Production</button><button data-v="area">Area harvested</button><button data-v="yield">Yield</button>
    </div>
    <button class="layer-btn" id="layerBtn" aria-pressed="false" title="Where bananas grow inside each country, from satellite-derived crop maps (MapSPAM 2020)">🛰 Where exactly?</button>
    <div class="years">
      <button id="play" aria-label="Play through the years">▶</button>
      <input id="year" type="range" min={fao.years[0]} max={year} value={year} step="1" aria-label="Year">
      <b class="num" id="yearLbl">{year}</b>
    </div>
  </div>

  <div class="layout">
    <section class="mapbox">
      <div id="map" class="map" aria-label="World map of banana farming"></div>
      <div class="zoom"><button id="zin" aria-label="Zoom in">+</button><button id="zout" aria-label="Zoom out">−</button><button id="zreset" aria-label="Reset view">⟲</button></div>
      <div class="legend" id="legend"></div>
      <div class="tip" id="tip" hidden></div>
    </section>

    <aside class="panel">
      <div class="card">
        <div class="p-top"><h2 id="pName">World</h2><button id="pWorld" class="link" hidden>Show world</button></div>
        <div class="p-sub" id="pSub"></div>
        <dl class="stats">
          <div><dt>Production</dt><dd class="num" id="sProd">—</dd></div>
          <div><dt>Area harvested</dt><dd class="num" id="sArea">—</dd></div>
          <div><dt>Yield</dt><dd class="num" id="sYield">—</dd></div>
          <div><dt id="sRankL">World rank</dt><dd class="num" id="sRank">—</dd></div>
        </dl>
        <div id="pChart" class="chart-box" style="height:160px"></div>
        <p class="p-note" id="pNote"></p>
      </div>
      <div class="card">
        <h2 id="topTitle">Top producers</h2>
        <ol class="top" id="top"></ol>
      </div>
    </aside>
  </div>

  <section class="spots">
    <div class="spots-head">
      <h2>Zoom into the plantations</h2>
      <p>The most densely planted spots in MapSPAM's satellite-derived map. Click a place to fly there on the map, or open the real satellite view.</p>
    </div>
    <div class="spot-grid">
      {hotspots.bananas.map(h => (
        <div class="spot">
          <button class="spot-go" data-lon={h.lon} data-lat={h.lat} data-crop="banana"><b>{h.region}</b><span>{h.country}</span></button>
          <div class="spot-meta"><span class="dotb"></span>Bananas · {h.ha.toLocaleString('en-US')} ha in one ~10 km square</div>
          <a href={sat(h)} target="_blank" rel="noopener">Satellite view ↗</a>
        </div>
      ))}
      {hotspots.plantains.slice(0, 4).map(h => (
        <div class="spot">
          <button class="spot-go" data-lon={h.lon} data-lat={h.lat} data-crop="plantain"><b>{h.region}</b><span>{h.country}</span></button>
          <div class="spot-meta"><span class="dotp"></span>Plantains · {h.ha.toLocaleString('en-US')} ha in one ~10 km square</div>
          <a href={sat(h)} target="_blank" rel="noopener">Satellite view ↗</a>
        </div>
      ))}
    </div>
    <p class="spot-note">These are model estimates, so at the level of a single square they can be off. Satellite links open Google Maps.</p>
  </section>

  <section class="about">
    <h2>About this map</h2>
    <p>Figures are the UN Food and Agriculture Organization's official statistics (FAOSTAT), reported by each country, for <b>bananas</b> (mostly dessert bananas like the Cavendish) and <b>plantains and cooking bananas</b> (like matoke). Yield is production per hectare harvested. Some small islands are shown as dots. The French overseas regions of Guadeloupe, Martinique, Réunion and French Guiana are reported separately from France.</p>
    <p><b>🛰 Where exactly?</b> switches to a map of where bananas and plantains grow <i>inside</i> each country, for 2020. It comes from IFPRI's MapSPAM, which spreads each country's official farm statistics across the land using satellite maps of cropland, terrain and growing conditions, on a roughly 10 km grid. Its totals (5.2 million hectares of bananas, 6.9 million of plantains) closely match FAO's figures for 2020.</p>
    <p class="src">Data: FAOSTAT, Crops and livestock products, © FAO, CC BY 4.0 (updated {fao.updated}). MapSPAM 2020 v2.0 r2, © IFPRI, CC BY 4.0 (adapted: we merged its 10 km cells into 20 km cells for the web). Country borders: Natural Earth via world-atlas (public domain). Bananas-per-second assumes a medium banana of about 118 g.</p>
  </section>
</Base>

<script>
  import { geoEqualEarth, geoPath, geoGraticule10 } from 'd3-geo';
  import { feature } from 'topojson-client';
  import { zoom as d3zoom, zoomIdentity } from 'd3-zoom';
  import { select } from 'd3-selection';
  import fao from '../../data/world/fao-bananas.json';
  import worldTopo from 'world-atlas/countries-50m.json';
  import { lineChart } from '../../scripts/charts';

  type Series = { area?: (number | null)[]; yield?: (number | null)[]; prod?: (number | null)[] };
  type Country = { name: string; banana?: Series; plantain?: Series };
  const countries = fao.countries as Record<string, Country>;
  const years = fao.years;
  const $ = (s: string) => document.querySelector(s) as HTMLElement;

  // places too small for the country outlines, or reported separately from the country they belong to
  const DOTS: Record<string, [number, number]> = { '312': [-61.55, 16.25], '474': [-61.02, 14.64], '638': [55.53, -21.11], '254': [-53.13, 3.93], '798': [179.2, -8.52] };

  let crop: 'banana' | 'plantain' | 'both' = 'banana', metric: 'prod' | 'area' | 'yield' = 'prod';
  let yi = years.length - 1, selected: string | null = null, playing: number | null = null;
  let layerOn = false;

  // ---------- numbers ----------
  function value(c: Country | typeof fao.world, m: 'prod' | 'area' | 'yield', i: number): number | null {
    const get = (s?: Series) => s?.[m]?.[i] ?? null;
    if (crop !== 'both') return get((c as Country)[crop]);
    if (m === 'yield') {   // combined yield = combined production / combined area
      const p = value2(c, 'prod', i), a = value2(c, 'area', i);
      return p != null && a ? Math.round((p / a) * 10) / 10 : null;
    }
    return value2(c, m, i);
  }
  function value2(c: any, m: 'prod' | 'area', i: number) {
    const a = c.banana?.[m]?.[i], b = c.plantain?.[m]?.[i];
    return a == null && b == null ? null : (a || 0) + (b || 0);
  }
  const fmt = (v: number | null, m: string) => v == null ? '—'
    : m === 'yield' ? `${v.toFixed(1)} t/ha`
    : m === 'area' ? (v >= 1e6 ? `${(v / 1e6).toFixed(2)}m ha` : v >= 1e3 ? `${Math.round(v / 1e3).toLocaleString('en-US')}k ha` : `${v} ha`)
    : v >= 1e6 ? `${(v / 1e6).toFixed(1)}m t` : v >= 1e3 ? `${Math.round(v / 1e3).toLocaleString('en-US')}k t` : `${v} t`;
  const LABEL = { prod: 'Production', area: 'Area harvested', yield: 'Yield' };

  // colour: dark to bright banana yellow. Production and area span many orders of magnitude, so use a log scale.
  const STOPS = ['#3a2f12', '#6b5312', '#a9800f', '#e0ad1a', '#ffe27a'].map(h => [1, 3, 5].map(k => parseInt(h.slice(k, k + 2), 16)));
  const colourAt = (t: number) => {
    t = Math.max(0, Math.min(1, t)) * (STOPS.length - 1);
    const i = Math.min(STOPS.length - 2, Math.floor(t)), f = t - i, a = STOPS[i], b = STOPS[i + 1];
    return `rgb(${a.map((v, k) => Math.round(v + (b[k] - v) * f)).join(',')})`;
  };
  function scale() {
    const vals = Object.values(countries).map(c => value(c, metric, yi)).filter((v): v is number => v != null && v > 0);
    const max = Math.max(...vals, 1);
    if (metric === 'yield') { const hi = Math.min(max, 70); return { t: (v: number) => v / hi, ticks: [0, hi / 2, hi].map(Math.round), log: false }; }
    const lo = 1e3;   // 1,000 t or ha and below share the darkest colour
    const t = (v: number) => Math.log10(Math.max(v, lo) / lo) / Math.log10(max / lo);
    const ticks: number[] = []; for (let p = 3; 10 ** p <= max * 1.01; p++) ticks.push(10 ** p);
    return { t, ticks, log: true };
  }

  // ---------- map ----------
  const geo = feature(worldTopo as any, (worldTopo as any).objects.countries) as any;
  const mapEl = $('#map');
  const W = 960, H = 500;
  const projection = geoEqualEarth().fitExtent([[6, 6], [W - 6, H - 6]], { type: 'Sphere' } as any);
  const path = geoPath(projection);
  mapEl.innerHTML = `<svg viewBox="0 0 ${W} ${H}" role="img"><g id="zoomLayer">
    <path class="sphere" d="${path({ type: 'Sphere' } as any)}"/>
    <path class="grat" d="${path(geoGraticule10())}"/>
    ${geo.features.map((f: any) => `<path class="cty" data-id="${f.id}" d="${path(f) || ''}"><title>${f.properties.name}</title></path>`).join('')}
    ${Object.entries(DOTS).map(([id, ll]) => { const [x, y] = projection(ll)!; return `<circle class="cty dot" data-id="${id}" cx="${x}" cy="${y}" r="3.5"/>`; }).join('')}
  </g></svg>`;
  const svg = select(mapEl.querySelector('svg')!), layer = svg.select('#zoomLayer');
  const zoomer = d3zoom<SVGSVGElement, unknown>().scaleExtent([1, 12]).translateExtent([[0, 0], [W, H]])
    .on('zoom', e => { layer.attr('transform', e.transform); layer.selectAll('.dot').attr('r', 3.5 / e.transform.k); layer.selectAll('.cty').style('stroke-width', `${0.5 / e.transform.k}px`); });
  (svg as any).call(zoomer);
  $('#zin').onclick = () => (svg as any).call(zoomer.scaleBy, 1.6);
  $('#zout').onclick = () => (svg as any).call(zoomer.scaleBy, 1 / 1.6);
  $('#zreset').onclick = () => (svg as any).call(zoomer.transform, zoomIdentity);

  const shapes = [...mapEl.querySelectorAll<SVGElement>('.cty')];
  function paint() {
    const sc = scale();
    for (const el of shapes) {
      const c = countries[el.dataset.id!], v = c ? value(c, metric, yi) : null;
      el.style.fill = v != null && v > 0 ? colourAt(sc.t(v)) : '';
      el.classList.toggle('nodata', !(v != null && v > 0));
      el.classList.toggle('sel', el.dataset.id === selected);
    }
    mapEl.classList.toggle('dim', layerOn);
    if (layerOn) {
      $('#legend').innerHTML = `<span class="lg-t">Where they grow, 2020 (MapSPAM)</span>
        ${crop !== 'plantain' ? '<span class="lg-row"><i class="sw b"></i>Bananas</span>' : ''}${crop !== 'banana' ? '<span class="lg-row"><i class="sw p"></i>Plantains &amp; cooking bananas</span>' : ''}
        <span class="lg-small">Brighter = more hectares per ~20 km square</span>`;
      return;
    }
    // legend
    const grad = Array.from({ length: 11 }, (_, i) => colourAt(i / 10)).join(',');
    const label = (v: number) => metric === 'yield' ? `${v}` : v >= 1e6 ? `${v / 1e6}m` : `${v / 1e3}k`;
    $('#legend').innerHTML = `<span class="lg-t">${LABEL[metric]}${metric === 'yield' ? ' (t/ha)' : metric === 'area' ? ' (ha)' : ' (tonnes)'}</span>
      <span class="lg-bar" style="background:linear-gradient(90deg,${grad})"></span>
      <span class="lg-ticks">${sc.ticks.map(v => `<i style="left:${(sc.t(Math.max(v, 1)) * 100).toFixed(1)}%">${label(v)}</i>`).join('')}</span>
      <span class="lg-nd"><i></i>No data</span>`;
  }

  // tooltip
  const tip = $('#tip');
  mapEl.addEventListener('pointermove', e => {
    const el = (e.target as Element).closest('.cty') as SVGElement | null;
    if (!el) { tip.hidden = true; return; }
    const c = countries[el.dataset.id!], name = c?.name ?? el.querySelector('title')?.textContent ?? '';
    const v = c ? value(c, metric, yi) : null;
    tip.innerHTML = `<b>${name}</b><span>${LABEL[metric]} ${years[yi]}: ${fmt(v, metric)}</span>`;
    const r = mapEl.getBoundingClientRect();
    tip.hidden = false;
    tip.style.left = `${Math.min(e.clientX - r.left + 14, r.width - tip.offsetWidth - 4)}px`;
    tip.style.top = `${e.clientY - r.top + 14}px`;
  });
  mapEl.addEventListener('pointerleave', () => (tip.hidden = true));
  mapEl.addEventListener('click', e => {
    const el = (e.target as Element).closest('.cty') as SVGElement | null;
    if (el && countries[el.dataset.id!]) { selected = el.dataset.id!; update(); }
  });

  // ---------- side panel ----------
  let chart: ReturnType<typeof lineChart> | null = null;
  function ranked(m: 'prod' | 'area' | 'yield') {
    return Object.entries(countries).map(([id, c]) => [id, value(c, m, yi)] as const)
      .filter((r): r is readonly [string, number] => r[1] != null && r[1] > 0 && (m !== 'yield' || (value(countries[r[0]], 'area', yi) ?? 0) >= 1000))
      .sort((a, b) => b[1] - a[1]);
  }
  function panel() {
    const c: any = selected ? countries[selected] : fao.world;
    $('#pName').textContent = selected ? countries[selected].name : 'World';
    $('#pWorld').hidden = !selected;
    $('#pSub').textContent = `${crop === 'banana' ? 'Bananas' : crop === 'plantain' ? 'Plantains & cooking bananas' : 'Bananas and plantains'}, ${years[yi]}`;
    $('#sProd').textContent = fmt(value(c, 'prod', yi), 'prod');
    $('#sArea').textContent = fmt(value(c, 'area', yi), 'area');
    $('#sYield').textContent = fmt(value(c, 'yield', yi), 'yield');
    const r = ranked(metric), worldV = value(fao.world as any, metric, yi);
    if (selected) {
      const pos = r.findIndex(x => x[0] === selected);
      $('#sRankL').textContent = `World rank (${LABEL[metric].toLowerCase()})`;
      $('#sRank').textContent = pos >= 0 ? `#${pos + 1} of ${r.length}` : '—';
      const v = value(c, metric, yi);
      $('#pNote').textContent = metric !== 'yield' && v && worldV ? `${((v / worldV) * 100).toFixed(1)}% of the world's ${LABEL[metric].toLowerCase()} in ${years[yi]}.` : '';
    } else {
      $('#sRankL').textContent = 'Countries growing them';
      $('#sRank').textContent = String(r.length);
      $('#pNote').textContent = 'Click any country on the map.';
    }
    const pts = years.map((y, i) => ({ x: Date.UTC(y, 6, 1), y: value(c, metric, i) })).filter((p): p is { x: number; y: number } => p.y != null);
    const opts = { height: 160, color: 'var(--brand)', label: `${LABEL[metric]} over time`, fmt: (v: number) => fmt(v, metric), axisFmt: (v: number) => fmt(v, metric).replace(/ (t|ha|t\/ha)$/, ''), dateFmt: (x: number) => String(new Date(x).getUTCFullYear()) };
    if (pts.length > 1) { if (!chart) chart = lineChart($('#pChart'), pts, opts); else chart.update(pts, opts); }
    $('#topTitle').textContent = metric === 'prod' ? 'Top producers' : metric === 'area' ? 'Largest growing areas' : 'Highest yields (1,000+ ha)';
    $('#top').innerHTML = r.slice(0, 10).map(([id, v], i) => `<li class="${id === selected ? 'sel' : ''}"><button data-id="${id}"><span class="num">${i + 1}</span>${countries[id].name}<b class="num">${fmt(v, metric)}</b></button></li>`).join('');
  }
  $('#top').addEventListener('click', e => { const b = (e.target as HTMLElement).closest('button'); if (b) { selected = b.dataset.id!; update(); } });
  $('#pWorld').onclick = () => { selected = null; update(); };

  // ---------- the satellite-derived layer (MapSPAM 2020) ----------
  let cells: Uint16Array | null = null, n = 0;
  const layerImg = document.createElementNS('http://www.w3.org/2000/svg', 'image');
  layerImg.setAttribute('width', String(W)); layerImg.setAttribute('height', String(H));
  layerImg.setAttribute('class', 'layer');
  layer.node()!.appendChild(layerImg);
  const drawn: Record<string, string> = {};
  async function drawLayer() {
    if (!cells) {
      const buf = await (await fetch('/world/spam-bananas.bin')).arrayBuffer();
      cells = new Uint16Array(buf); n = cells.length / 4;
    }
    if (!drawn[crop]) {
      const S = 3, cv = document.createElement('canvas');
      cv.width = W * S; cv.height = H * S;
      const g = cv.getContext('2d')!;
      const draw = (col: number, rgb: string) => {
        for (let i = 0; i < n; i++) {
          const ha = cells![col * n + i];
          if (!ha) continue;
          const lon = cells![i] / 6 - 180 + 1 / 12, lat = cells![n + i] / 6 - 90 + 1 / 12;
          const pt = projection([lon, lat]); if (!pt) continue;
          // 10 ha is faint, 10,000+ ha is solid
          const a = Math.max(0.08, Math.min(0.95, (Math.log10(ha) - 1) / 3));
          g.fillStyle = `rgba(${rgb},${a.toFixed(2)})`;
          g.fillRect(pt[0] * S - 1.3, pt[1] * S - 1.3, 2.6, 2.6);
        }
      };
      if (crop !== 'banana') draw(3, '120,220,110');
      if (crop !== 'plantain') draw(2, '255,214,60');
      drawn[crop] = cv.toDataURL('image/png');
    }
    layerImg.setAttribute('href', drawn[crop]);
  }
  function showLayer(on: boolean) {
    layerOn = on;
    $('#layerBtn').classList.toggle('on', on);
    $('#layerBtn').setAttribute('aria-pressed', String(on));
    layerImg.style.display = on ? '' : 'none';
    if (on) { stop(); drawLayer(); }
    paint();
  }
  $('#layerBtn').onclick = () => showLayer(!layerOn);
  layerImg.style.display = 'none';

  // fly to a hotspot
  document.querySelectorAll<HTMLButtonElement>('.spot-go').forEach(b => b.onclick = () => {
    crop = b.dataset.crop as typeof crop;
    $('#crop').querySelectorAll('button').forEach(x => x.classList.toggle('on', x.dataset.v === crop));
    showLayer(true);
    const pt = projection([+b.dataset.lon!, +b.dataset.lat!])!, k = 7;
    (svg as any).call(zoomer.transform, zoomIdentity.translate(W / 2 - pt[0] * k, H / 2 - pt[1] * k).scale(k));
    mapEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
    update();
  });

  function update() { paint(); panel(); if (layerOn) drawLayer(); $('#yearLbl').textContent = String(years[yi]); ($('#year') as HTMLInputElement).value = String(years[yi]); }

  // ---------- controls ----------
  const seg = (id: string, set: (v: string) => void) => $(id).addEventListener('click', e => {
    const b = (e.target as HTMLElement).closest('button'); if (!b) return;
    $(id).querySelectorAll('button').forEach(x => x.classList.toggle('on', x === b));
    set(b.dataset.v!); update();
  });
  seg('#crop', v => (crop = v as typeof crop));
  seg('#metric', v => (metric = v as typeof metric));
  $('#year').addEventListener('input', e => { yi = +(e.target as HTMLInputElement).value - years[0]; stop(); update(); });
  const stop = () => { if (playing) { clearInterval(playing); playing = null; $('#play').textContent = '▶'; } };
  $('#play').onclick = () => {
    if (playing) return stop();
    if (yi === years.length - 1) yi = 0;
    $('#play').textContent = '❚❚';
    playing = window.setInterval(() => { if (yi >= years.length - 1) return stop(); yi++; update(); }, 180);
  };

  // ---------- bananas grown since you arrived ----------
  const L = years.length - 1;
  const perSecond = (fao.world.banana.prod[L]! * 1000) / (365.25 * 86400) / 0.118;
  const t0 = performance.now(), counter = $('#counter');
  const tick = () => { counter.textContent = Math.floor(((performance.now() - t0) / 1000) * perSecond).toLocaleString('en-US'); requestAnimationFrame(tick); };
  requestAnimationFrame(tick);

  update();
</script>

<style>
  .head { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; padding: 22px 0 12px; flex-wrap: wrap; }
  .back { color: var(--link); text-decoration: none; font-size: 13px; font-weight: 600; }
  .head h1 { margin: 4px 0 4px; font-size: 36px; font-weight: 900; letter-spacing: -0.03em; }
  .head h1::first-letter { color: var(--brand); }
  .head p { margin: 0; color: var(--ink-2); font-size: 15.5px; max-width: 720px; }
  .counter { text-align: right; }
  .c-n { display: block; font-size: 34px; font-weight: 900; color: var(--brand); letter-spacing: -0.02em; }
  .c-l { font-size: 12.5px; color: var(--ink-3); font-weight: 600; }

  .controls { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; padding: 12px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .seg { display: inline-flex; background: var(--field); border-radius: 999px; padding: 3px; }
  .seg button { font: 700 13px 'Inter', sans-serif; color: var(--ink-2); background: none; border: none; border-radius: 999px; padding: 6px 12px; cursor: pointer; white-space: nowrap; }
  .seg button.on { background: var(--brand); color: #1d1600; }
  .layer-btn { font: 700 13px 'Inter', sans-serif; color: var(--ink); background: var(--field); border: 1px solid var(--border); border-radius: 999px; padding: 7px 14px; cursor: pointer; white-space: nowrap; }
  .layer-btn:hover { border-color: var(--brand); }
  .layer-btn.on { background: #1f3b2a; border-color: #5cc46e; color: #c9f5cf; }
  .map.dim :global(.cty) { fill: #262b33 !important; }
  .map.dim :global(.cty.sel) { fill: #343b45 !important; }
  .map :global(.layer) { pointer-events: none; }
