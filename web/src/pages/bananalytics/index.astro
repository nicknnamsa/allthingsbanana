---
import Base from '../../layouts/Base.astro';
---
<Base image="/og/bananalytics.jpg" wide section="bananalytics" title="Bananalytics · banana prices, charts and statistics · All Things Banana"
      description="Banana price charts and statistics: the global banana benchmark, US shop prices, fruit and soft commodities and banana company stocks.">
  <header class="page-head">
    <h1>Bananalytics</h1>
    <p>Banana prices, charts and statistics, plus the fruit and soft commodities around them.</p>
    <a class="world-link" href="/bananalytics/world/">🌍 Banana World: the map of where bananas grow →</a>
  </header>
  <div class="layout">
    <div class="main-col">
      <section class="quote">
        <div class="q-src" id="qSrc">IMF · World price · Monthly</div>
        <h1><span id="qName">Bananas</span> <span class="q-code" id="qCode"></span></h1>
        <div class="q-desc" id="qDesc"></div>
        <div class="q-price">
          <span class="num q-big" id="qPrice">—</span>
          <span class="q-chg num" id="qChg"></span>
        </div>
        <div class="q-asof" id="qAsOf">Loading…</div>

        <div class="q-bar">
          <div class="seg" id="ranges" role="group" aria-label="Time range">
            <button data-y="1">1Y</button><button data-y="3">3Y</button><button data-y="5" class="on">5Y</button><button data-y="10">10Y</button><button data-y="0">Max</button>
          </div>
          <span class="q-perf" id="qPerf"></span>
        </div>
        <div id="qChart" class="chart-box" style="height:340px"></div>

        <h2 class="sub-h">Key statistics</h2>
        <div class="kstats" id="qStats"></div>
        <p class="src" id="qNote"></p>
      </section>

      <section class="block" id="board">
        <div class="block-head">
          <h2>Fruit &amp; softs</h2>
          <span class="h-sub">World prices · monthly · select a row to chart it</span>
        </div>
        <div class="tbl-wrap">
          <table class="board">
            <thead><tr>
              <th>Name</th><th class="r">Last</th><th class="r">1M %</th><th class="r">1Y %</th>
              <th class="hide-s">12-month range</th><th class="hide-s r">2Y trend</th>
            </tr></thead>
            <tbody id="boardRows"><tr><td colspan="6" class="muted">Loading…</td></tr></tbody>
          </table>
        </div>
        <p class="src">Source: IMF Primary Commodity Prices.</p>
      </section>
    </div>

    <aside class="side-col">
      <section class="block" id="shops">
        <div class="block-head"><h2>US shop prices</h2><span class="h-sub">monthly</span></div>
        <table class="mini">
          <thead><tr><th>Fruit</th><th class="r">Last</th><th class="r">1Y %</th><th class="r">1Y</th></tr></thead>
          <tbody id="retail"><tr><td colspan="4" class="muted">Loading…</td></tr></tbody>
        </table>
        <p class="src">Average prices in US cities. Source: US Bureau of Labor Statistics.</p>
      </section>

      <section class="block" id="stocksCard" hidden>
        <div class="block-head"><h2>Banana stocks</h2><span class="h-sub">delayed</span></div>
        <table class="mini"><tbody id="watch"></tbody></table>
        <p class="src">Not financial advice.</p>
      </section>

      <section class="block">
        <div class="block-head"><h2>Banana maths</h2></div>
        <dl class="facts" id="facts">
          <div><dt>One banana in US shops</dt><dd>—</dd></div>
          <div><dt>A dozen bananas</dt><dd>—</dd></div>
          <div><dt>One banana at import price</dt><dd>—</dd></div>
          <div><dt>Shop price vs import price</dt><dd>—</dd></div>
          <div><dt>Bananas in a tonne</dt><dd>—</dd></div>
        </dl>
        <p class="src">Assumes a medium banana of 118 g (0.26 lb).</p>
      </section>
    </aside>
  </div>
</Base>

<script>
  import { lineChart, sparkline } from '../../scripts/charts';
  import {
    getMarket, getFeed, lookup, allSeries, money, signed, num, pctHtml, change, lastChange, lastYear, sliceYears, at,
    fmtDate, shortDate, STOCK_NAMES, YEAR, type Market, type Feed, type Sel,
  } from '../../scripts/market';

  const BANANA_KG = 0.118;   // a medium banana (USDA)
  const $ = (s: string) => document.querySelector(s) as HTMLElement;
  let market: Market | null = null, feed: Feed | null = null, selected = 'PBANSOP', years = 5;
  let chart: ReturnType<typeof lineChart> | null = null;

  function rangeBar(s: { cur: string; dec: number }, lo: number, hi: number, v: number) {
    const pos = hi > lo ? ((v - lo) / (hi - lo)) * 100 : 50;
    return `<div class="rng"><span class="num">${money(s, lo)}</span><div class="rng-bar"><i style="left:${pos.toFixed(1)}%"></i></div><span class="num">${money(s, hi)}</span></div>`;
  }

  function renderQuote() {
    const s = lookup(market, selected) || lookup(market, 'PBANSOP');
    if (!s) return;
    selected = s.code;
    const pts = s.pts, last = pts[pts.length - 1], prev = pts[pts.length - 2];
    const unit = s.per === 'share' ? '' : ` / ${s.per}`;
    document.title = `${s.kind === 'US shop price' ? s.name + ' (US shops)' : s.name} price · Bananalytics · All Things Banana`;
    $('#qSrc').textContent = `${s.kind === 'Stock' ? 'NYSE' : s.source.replace(' Primary Commodity Prices', '').replace('US Bureau of Labor Statistics', 'US BLS')} · ${s.kind} · ${s.daily ? 'Daily' : 'Monthly'} · ${s.kind === 'Stock' ? 'USD' : `${s.cur === '¢' ? 'US cents' : s.cur === '€' ? 'EUR' : 'USD'} per ${s.per}`}`;
    $('#qName').textContent = s.kind === 'US shop price' ? `${s.name} (US shops)` : s.name;
    $('#qCode').textContent = `(${s.code})`;
    $('#qDesc').textContent = s.desc;
    $('#qPrice').textContent = money(s, last.y);
    const ch = last.y - prev.y, chp = (ch / prev.y) * 100;
    $('#qChg').innerHTML = `<span class="${ch >= 0 ? 'up' : 'down'}">${signed(ch, s.dec)} (${signed(chp)}%)</span>`;
    $('#qAsOf').textContent = `As of ${fmtDate(last.x, s.daily)}. ${s.daily ? 'Closing price.' : 'Monthly average; change vs previous month.'}`;

    const view = sliceYears(pts, years);
    const up = view[view.length - 1].y >= view[0].y;
    $('#qPerf').innerHTML = `${years ? `${years}Y` : 'Since ' + new Date(pts[0].x).getUTCFullYear()} ${pctHtml(((view[view.length - 1].y - view[0].y) / view[0].y) * 100)}`;
    const opts = {
      height: 340, color: `var(${up ? '--up' : '--down'})`, baseline: true, label: `${s.name} price`,
      fmt: (v: number) => `${money(s, v)}${unit}`,
      axisFmt: (v: number) => money(s, v, Number.isInteger(v) ? 0 : Math.min(s.dec, 2)),
      dateFmt: (x: number) => fmtDate(x, s.daily),
    };
    if (!chart) chart = lineChart($('#qChart'), view, opts);
    else chart.update(view, opts);

    const yr = lastYear(pts), yLo = Math.min(...yr.map(p => p.y)), yHi = Math.max(...yr.map(p => p.y));
    const hi = pts.reduce((a, b) => (b.y > a.y ? b : a)), lo = pts.reduce((a, b) => (b.y < a.y ? b : a));
    const five = pts.filter(p => p.x > last.x - 5 * YEAR), avg5 = five.reduce((a, p) => a + p.y, 0) / five.length;
    const moves = yr.slice(1).map((p, i) => Math.abs((p.y - yr[i].y) / yr[i].y) * 100);
    const ytdBase = at(pts, Date.UTC(new Date(last.x).getUTCFullYear(), 0, 1) - 864e5);
    const d = (x: number) => (s.daily ? fmtDate(x, true) : shortDate(x));
    const rows: [string, string][] = [
      [s.daily ? 'Previous close' : 'Previous month', money(s, prev.y)],
      ['3-month change', pctHtml(change(pts, 0.25 * YEAR))],
      ['Year to date', pctHtml(ytdBase ? ((last.y - ytdBase.y) / ytdBase.y) * 100 : null)],
      ['1-year change', pctHtml(change(pts, YEAR))],
      ['5-year change', pctHtml(change(pts, 5 * YEAR))],
      ['5-year average', money(s, avg5)],
      ['12-month range', rangeBar(s, yLo, yHi, last.y)],
      ['Record high', `${money(s, hi.y)} <small>${d(hi.x)}</small>`],
      ['Record low', `${money(s, lo.y)} <small>${d(lo.x)}</small>`],
      [`Average ${s.daily ? 'daily' : 'monthly'} move`, `${num(moves.reduce((a, b) => a + b, 0) / (moves.length || 1), 2)}%`],
      ['Data since', d(pts[0].x)],
      ['Source', s.source.replace('Primary Commodity Prices', 'commodity prices')],
    ];
    $('#qStats').innerHTML = rows.map(([k, v]) => `<div><span>${k}</span><b class="num">${v}</b></div>`).join('');
    $('#qNote').textContent = `Records and ranges cover the data shown here, since ${new Date(pts[0].x).getUTCFullYear()}.`;
    document.querySelectorAll('[data-code]').forEach(el => el.classList.toggle('sel', (el as HTMLElement).dataset.code === s.code));
  }

  function select(code: string, scroll = true) {
    selected = code;
    history.replaceState(null, '', '#' + code);
    renderQuote();
    if (scroll) window.scrollTo({ top: 0, behavior: 'smooth' });
  }
  function fromHash() {
    const h = decodeURIComponent(location.hash.slice(1));
    if (!h) return;
    if (lookup(market, h)) { selected = h; renderQuote(); window.scrollTo({ top: 0 }); }
    else document.getElementById(h)?.scrollIntoView();
  }

  function row(s: Sel, mini: boolean) {
    const pts = s.pts, last = pts[pts.length - 1], yr = lastYear(pts);
    const lo = Math.min(...yr.map(p => p.y)), hi = Math.max(...yr.map(p => p.y));
    if (mini) return `<tr data-code="${s.code}" tabindex="0">
      <td><b>${s.name}</b><span>per ${s.per}</span></td>
      <td class="r num">${money(s, last.y)}</td><td class="r num">${pctHtml(change(pts, YEAR), 1)}</td>
      <td class="r">${sparkline(yr.map(p => p.y), 64, 24)}</td></tr>`;
    return `<tr data-code="${s.code}" tabindex="0">
      <td><b>${s.name}</b><span>${s.desc}</span></td>
      <td class="r num"><b>${money(s, last.y)}</b><span>per ${s.per}</span></td>
      <td class="r num">${pctHtml(lastChange(pts))}</td>
      <td class="r num">${pctHtml(change(pts, YEAR))}</td>
      <td class="hide-s">${rangeBar(s, lo, hi, last.y)}</td>
      <td class="hide-s r">${sparkline(pts.slice(-24).map(p => p.y), 96, 28)}</td></tr>`;
  }
  function renderTables() {
    const all = allSeries(market);
    const com = all.filter(s => s.kind === 'World price'), ret = all.filter(s => s.kind === 'US shop price');
    $('#boardRows').innerHTML = com.length ? com.map(s => row(s, false)).join('') : '<tr><td colspan="6" class="muted">Unavailable right now.</td></tr>';
    $('#retail').innerHTML = ret.length ? ret.map(s => row(s, true)).join('') : '<tr><td colspan="4" class="muted">Unavailable right now.</td></tr>';
  }
  function renderFacts() {
    const dd = $('#facts').querySelectorAll('dd');
    const perLb = lookup(market, 'APU0000711211')?.pts.at(-1)?.y, perT = lookup(market, 'PBANSOP')?.pts.at(-1)?.y;
    const shopEach = perLb != null ? perLb * BANANA_KG * 2.20462 : null, impEach = perT != null ? (perT / 1000) * BANANA_KG : null;
    if (shopEach != null) { dd[0].innerHTML = `${num(shopEach * 100, 1)}¢`; dd[1].innerHTML = `$${num(shopEach * 12, 2)}`; }
    if (impEach != null) dd[2].innerHTML = `${num(impEach * 100, 1)}¢`;
    if (shopEach != null && impEach != null) dd[3].innerHTML = `${num(shopEach / impEach, 1)}× <small>(+${num((shopEach / impEach - 1) * 100, 0)}%)</small>`;
    dd[4].innerHTML = `≈ ${num(1000 / BANANA_KG, 0)}`;
  }
  function renderStocks() {
    const quotes = new Map((feed?.stocks || []).map(s => [s.symbol, s])), hist = market?.history || {};
    const symbols = Object.keys(STOCK_NAMES).filter(s => quotes.has(s) || hist[s]?.length);
    $('#stocksCard').hidden = !symbols.length;
    $('#watch').innerHTML = symbols.map(sym => {
      const q = quotes.get(sym), h = hist[sym] || [];
      const price = q?.price ?? h[h.length - 1]?.[1];
      const chp = q?.changePct ?? (h.length > 1 ? ((h[h.length - 1][1] - h[h.length - 2][1]) / h[h.length - 2][1]) * 100 : null);
      return `<tr ${h.length ? `data-code="${sym}" tabindex="0"` : ''}><td><b>${sym}</b><span>${STOCK_NAMES[sym]}</span></td>
        <td class="r">${sparkline(h.slice(-60).map(p => p[1]), 64, 24)}</td>
        <td class="r num"><b>$${num(price, 2)}</b>${pctHtml(chp)}</td></tr>`;
    }).join('');
  }

  document.addEventListener('click', e => {
    const r = (e.target as HTMLElement).closest('tr[data-code]') as HTMLElement | null;
    if (r) select(r.dataset.code!);
  });
  document.addEventListener('keydown', e => {
    const r = (e.target as HTMLElement).closest?.('tr[data-code]') as HTMLElement | null;
    if (r && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); select(r.dataset.code!); }
  });
  $('#ranges').addEventListener('click', e => {
    const b = (e.target as HTMLElement).closest('button'); if (!b) return;
    years = Number(b.dataset.y);
    $('#ranges').querySelectorAll('button').forEach(c => c.classList.toggle('on', c === b));
    renderQuote();
  });
  addEventListener('hashchange', fromHash);   // ticker strip links on this page

  getMarket().then(m => {
    market = m;
    renderTables(); renderFacts();
    const h = decodeURIComponent(location.hash.slice(1));
    if (lookup(market, h)) selected = h;
    renderQuote();
    if (h && !lookup(market, h)) document.getElementById(h)?.scrollIntoView();
  }).catch(() => { $('#qAsOf').textContent = 'Price data is unavailable right now.'; });
  getFeed().then(f => { feed = f; renderStocks(); }).catch(() => {});
  getMarket().then(() => renderStocks()).catch(() => {});
</script>

<style>
  .page-head { padding: 24px 0 4px; display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; border-bottom: 1px solid var(--border); padding-bottom: 14px; }
  .page-head h1 { margin: 0; font-size: 30px; font-weight: 800; letter-spacing: -0.02em; }
  .page-head h1::first-letter { color: var(--brand); }
  .page-head p { margin: 0; color: var(--ink-3); font-size: 14px; }
  .world-link { margin-left: auto; color: #1d1600; background: var(--brand); font-weight: 800; font-size: 13.5px; text-decoration: none; border-radius: 999px; padding: 7px 14px; }
  .world-link:hover { filter: brightness(1.06); }
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 40px; align-items: start; padding-top: 22px; }
  .main-col, .side-col { display: flex; flex-direction: column; gap: 32px; min-width: 0; }
  .block-head { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; margin-bottom: 8px; flex-wrap: wrap; border-bottom: 1px solid var(--border); padding-bottom: 8px; }
  .block h2, .sub-h { font-size: 18px; font-weight: 800; margin: 0; }
  .sub-h { margin-top: 24px; padding-bottom: 8px; }
  .h-sub { color: var(--ink-3); font-size: 12px; }
  .src { margin: 10px 0 0; color: var(--ink-3); font-size: 11.5px; }
  .chart-box { position: relative; }

  .q-src { font-size: 12px; color: var(--ink-3); }
  .quote h1 { font-size: 28px; font-weight: 800; margin: 4px 0 0; letter-spacing: -0.02em; }
  .q-code { font-size: 18px; font-weight: 600; color: var(--ink-3); letter-spacing: 0; }
  .q-desc { font-size: 13px; color: var(--ink-2); }
  .q-price { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; margin-top: 14px; }
  .q-big { font-size: 40px; font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; }
  .q-chg { font-size: 19px; font-weight: 600; }
  .q-asof { font-size: 12px; color: var(--ink-3); margin-top: 4px; }
  .q-bar { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin: 18px 0 8px; flex-wrap: wrap; }
  .q-perf { font-size: 13px; color: var(--ink-2); }

  .kstats { display: grid; grid-template-columns: 1fr 1fr; column-gap: 36px; border-top: 1px solid var(--border); }
  .kstats > :global(div) { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 9px 0; border-bottom: 1px solid var(--border-2); font-size: 13.5px; }
  .kstats > :global(div > span) { color: var(--ink-2); white-space: nowrap; }
  .kstats > :global(div > b) { font-weight: 700; text-align: right; }
  .kstats :global(small) { color: var(--ink-3); font-weight: 500; }
  .kstats :global(.rng) { min-width: 0; flex: 1; justify-content: flex-end; }

  .seg { display: inline-flex; gap: 4px; }
  .seg button { font: 600 13px 'Inter', sans-serif; color: var(--ink-2); background: transparent; border: 1px solid transparent; padding: 5px 12px; border-radius: 999px; cursor: pointer; }
  .seg button:hover { color: var(--ink); background: var(--chip); }
  .seg button.on { color: var(--ink); border-color: var(--ink-3); }

  :global(.rng) { display: flex; align-items: center; gap: 8px; font-size: 11.5px; color: var(--ink-2); font-weight: 500; }
  :global(.rng-bar) { position: relative; flex: 1; min-width: 50px; height: 4px; border-radius: 2px; background: var(--border); }
  :global(.rng-bar i) { position: absolute; top: 50%; width: 3px; height: 12px; border-radius: 2px; background: var(--ink); transform: translate(-50%, -50%); }

  .tbl-wrap { overflow-x: auto; }
  .board, .mini { width: 100%; border-collapse: collapse; font-size: 13px; }
  .board th, .mini th { text-align: left; font-size: 11.5px; font-weight: 600; color: var(--ink-3); padding: 6px 8px; border-bottom: 1px solid var(--border); white-space: nowrap; }
  .board :global(td), .mini :global(td) { padding: 9px 8px; border-bottom: 1px solid var(--border-2); vertical-align: middle; }
  .board th:first-child, .mini th:first-child, .board :global(td:first-child), .mini :global(td:first-child) { padding-left: 0; }
  .board th:last-child, .mini th:last-child, .board :global(td:last-child), .mini :global(td:last-child) { padding-right: 0; }
  .board :global(td b), .mini :global(td b) { display: block; font-weight: 700; }
  .board :global(td span:not(.up):not(.down):not(.num):not(.muted)), .mini :global(td span:not(.up):not(.down):not(.muted)) { display: block; font-size: 11.5px; color: var(--ink-3); }
  .board :global(.rng) { min-width: 180px; }
  :global(.r) { text-align: right !important; }
  :global(tr[data-code]) { cursor: pointer; }
  :global(tr[data-code]:hover td) { background: var(--hover); }
  :global(tr[data-code].sel td) { background: color-mix(in srgb, var(--brand) 12%, transparent); }
  :global(tr[data-code].sel td:first-child) { box-shadow: inset 3px 0 0 var(--brand); padding-left: 8px; }
  :global(tr[data-code]:focus-visible) { outline: 2px solid var(--series); outline-offset: -2px; }
  .mini :global(td.r .up), .mini :global(td.r .down) { display: block; font-size: 11.5px; }
  .mini :global(.spark) { display: inline-block; vertical-align: middle; }

  .facts { margin: 0; }
  .facts div { display: flex; justify-content: space-between; gap: 10px; padding: 8px 0; border-bottom: 1px solid var(--border-2); font-size: 13px; }
  .facts dt { color: var(--ink-2); }
  .facts dd { margin: 0; font-weight: 700; font-variant-numeric: tabular-nums; }
  .facts :global(dd small) { color: var(--ink-3); font-weight: 500; }

  @media (max-width: 1000px) { .layout { grid-template-columns: 1fr; } }
  @media (max-width: 640px) {
    .kstats { grid-template-columns: 1fr; }
    .q-big { font-size: 34px; }
    :global(.hide-s) { display: none; }
  }
</style>
