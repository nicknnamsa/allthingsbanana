---
import Base from '../../layouts/Base.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import { recipes, formatTime, MEALS, RIPENESS, recipePhoto, recipeNutrition, type Recipe } from '../../data/recipes';

export function getStaticPaths() {
  return recipes.map(r => ({ params: { slug: r.slug }, props: { recipe: r } }));
}
const { recipe: r } = Astro.props as { recipe: Recipe };
const mealLabel = (id: string) => MEALS.find(m => m.id === id)?.label ?? id;
const ripe = RIPENESS.filter(x => r.ripeness.includes(x.id));
const dietLabel: Record<string, string> = { vegan: 'Vegan', vegetarian: 'Vegetarian', 'gluten-free': 'Gluten-free', 'dairy-free': 'Dairy-free', 'no-bake': 'No oven', alcohol: 'Contains alcohol' };
// four recipes for the same kind of meal, picked so they differ from page to page
const similar = recipes.filter(x => x.slug !== r.slug && x.meals.some(m => r.meals.includes(m)));
const start = similar.length ? (r.slug.length * 7) % similar.length : 0;
const more = [...similar.slice(start), ...similar.slice(0, start)].slice(0, 4);

const photo = recipePhoto(r.slug);
const nut = recipeNutrition(r.slug);
const g = (x: number) => (x < 10 ? x.toFixed(1).replace(/\.0$/, '') : Math.round(x).toString());
const nutRows = nut ? [
  ['Energy', `${nut.kcal} kcal`], ['Protein', `${g(nut.protein)} g`], ['Carbohydrate', `${g(nut.carbs)} g`], ['of which sugars', `${g(nut.sugars)} g`, 'sub'],
  ['Fat', `${g(nut.fat)} g`], ['of which saturates', `${g(nut.sat)} g`, 'sub'], ['Fibre', `${g(nut.fibre)} g`], ['Salt', `${nut.salt.toFixed(1)} g`],
] : [];
const perLabel = nut ? (nut.per === 'serving' ? `per serving (serves ${nut.servings})` : `per ${nut.per} (makes about ${nut.servings})`) : '';

// a step's name: its first clause, cut to a few words ("Mix the crushed biscuits with the melted butter")
const stepName = (text: string) => {
  const first = text.split(/[.,;:]\s/)[0].replace(/\.$/, '');
  const words = first.split(/\s+/);
  return words.length > 8 ? words.slice(0, 8).join(' ') + '…' : first;
};

// structured data so search engines can show it as a recipe
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Recipe',
  name: r.name, description: r.blurb, recipeYield: r.serves,
  totalTime: `PT${r.mins}M`, recipeCategory: r.meals.map(mealLabel).join(', '), recipeCuisine: r.origin,
  keywords: ['banana', ...r.meals, ...r.diet].join(', '),
  recipeIngredient: r.ingredients,
  // each step gets a short name (its opening words) and its own link, so search results can point at a step
  recipeInstructions: r.steps.map((text, i) => ({ '@type': 'HowToStep', name: stepName(text), text, url: `${new URL(`/recipes/${r.slug}/`, Astro.site).href}#step-${i + 1}` })),
  ...(r.diet.includes('vegan') ? { suitableForDiet: 'https://schema.org/VeganDiet' } : r.diet.includes('gluten-free') ? { suitableForDiet: 'https://schema.org/GlutenFreeDiet' } : {}),
  author: { '@type': 'Organization', name: 'All Things Banana' },
  ...(photo ? { image: new URL(photo.src, Astro.site).href } : {}),
  ...(nut ? { nutrition: {
    '@type': 'NutritionInformation', servingSize: nut.per === 'serving' ? `1 serving (of ${nut.servings})` : `1 ${nut.per}`,
    calories: `${nut.kcal} calories`, proteinContent: `${g(nut.protein)} g`, carbohydrateContent: `${g(nut.carbs)} g`, sugarContent: `${g(nut.sugars)} g`,
    fatContent: `${g(nut.fat)} g`, saturatedFatContent: `${g(nut.sat)} g`, fiberContent: `${g(nut.fibre)} g`, sodiumContent: `${Math.round(nut.salt * 400)} mg`,
  } } : {}),
};
---
<Base image={photo ? `/recipes/img/og/${r.slug}.jpg` : '/og/recipes.jpg'} wide section="recipes" title={`${r.name} · Banacipes banana recipes · All Things Banana`} description={`${r.blurb} ${formatTime(r.mins)}, serves ${r.serves}.`}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Banacipes', item: 'https://allthingsbanana.com/recipes/' },
      { '@type': 'ListItem', position: 2, name: mealLabel(r.meals[0]), item: `https://allthingsbanana.com/recipes/?meal=${r.meals[0]}` },
      { '@type': 'ListItem', position: 3, name: r.name, item: `https://allthingsbanana.com/recipes/${r.slug}/` },
    ],
  })} />
  <nav class="crumbs"><a href="/recipes/">Banacipes</a> › {mealLabel(r.meals[0])} › {r.name}</nav>

  <article class="recipe">
    <header class="top">
      {photo
        ? <figure class="photo">
            <img src={photo.src} alt={r.name} width={photo.w} height={photo.h} fetchpriority="high">
            <figcaption>Illustrative photo, not made from this recipe: <a href={photo.page} rel="nofollow noopener" target="_blank">{photo.author}</a>, <a href={photo.licenseUrl} rel="license nofollow noopener" target="_blank">{photo.license}</a>, via {photo.source}.</figcaption>
          </figure>
        : <div class="art" style={`background:${({ green: 'var(--r1)', yellow: 'var(--r4)', spotty: 'var(--r5)', brown: 'var(--r7)' } as Record<string, string>)[r.ripeness[0]] ?? 'var(--r4)'}`} aria-hidden="true">
            <svg viewBox="0 0 32 32"><path d="M5.5 8.5c1.5 11 11 18.5 22 14.5-1.5 3.5-5.5 5.5-10.5 5.5C9.5 28.5 4 20 5.5 8.5z" fill="#FFD23F" stroke="#231A10" stroke-width="1.4" stroke-linejoin="round"/><path d="M5.5 8.5 4.6 4.4l3 1.3" fill="none" stroke="#231A10" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>}
      <div class="intro">
        <div class="tags">
          {r.meals.map(m => <a href={`/recipes/?meal=${m}`}>{mealLabel(m)}</a>)}
          <span>{r.origin}</span>
        </div>
        <h1>{r.name}</h1>
        <p class="blurb">{r.blurb}</p>
        <dl class="facts">
          <div><dt>Time</dt><dd>{formatTime(r.mins)}</dd></div>
          <div><dt>Serves</dt><dd>{r.serves}</dd></div>
          <div><dt>Difficulty</dt><dd class="cap">{r.difficulty}</dd></div>
          <div><dt>Bananas</dt><dd>{r.bananaNote ?? `${r.bananas} ${r.bananas === 1 ? 'banana' : 'bananas'}`}</dd></div>
        </dl>
        <div class="row">
          <span class="meter" title={`Banana-o-meter: ${r.level} out of 5`}>
            <b>Banana-o-meter</b> <span class="pips" aria-label={`${r.level} of 5`}>{[1, 2, 3, 4, 5].map(i => <i class={i <= r.level ? 'on' : ''}></i>)}</span>
          </span>
          <span class="ripeness">
            <b>Best with</b>
            {ripe.map(x => <a href={`/recipes/?ripe=${x.id}`} class="ripe-chip"><i style={`background:${x.colour}`}></i>{x.label.toLowerCase()} bananas</a>)}
          </span>
        </div>
        {r.diet.length > 0 && <div class="diet">{r.diet.map(d => <span>{dietLabel[d]}</span>)}</div>}
      </div>
    </header>

    <div class="cols">
      <section class="ings">
        <div class="col-head"><h2>Ingredients</h2><button id="resetIngs" class="link">Untick all</button></div>
        <ul id="ings">
          {r.ingredients.map((x, i) => (
            <li><label><input type="checkbox" data-i={i}> <span>{x}</span></label></li>
          ))}
        </ul>
        {nut && (
          <section class="nutrition" aria-labelledby="nut-h">
            <div class="col-head"><h2 id="nut-h">Nutrition</h2><span class="per">{perLabel}</span></div>
            <div class="kcal"><b>{nut.kcal}</b> kcal</div>
            <table>
              {nutRows.map(([k, v, cls]) => <tr class={cls}><th scope="row">{k}</th><td>{v}</td></tr>)}
            </table>
            <p class="nut-note">
              An estimate, worked out from the ingredient amounts above using <a href="https://fdc.nal.usda.gov/" rel="noopener" target="_blank">USDA FoodData Central</a>.
              {nut.notes.map(n => <> {n}</>)}
            </p>
          </section>
        )}
      </section>
      <section class="method">
        <div class="col-head"><h2>Method</h2><button class="link" onclick="window.print()">Print</button></div>
        <ol id="steps">
          {r.steps.map((s, i) => <li id={`step-${i + 1}`}><button>{s}</button></li>)}
        </ol>
        {r.tip && <aside class="tip"><b>Tip</b> {r.tip}</aside>}
        {/banana-bread/.test(r.slug) && <a class="hub" href="/topics/banana-bread/">Everything about banana bread: history, the science of ripeness and the internet's favourite recipes →</a>}
        <p class="note">Tap a step to mark it done.</p>
      </section>
    </div>
  </article>

  {more.length > 0 && (
    <section class="more">
      <div class="more-head"><h2>More {mealLabel(r.meals[0]).toLowerCase()} ideas</h2><a href={`/recipes/?meal=${r.meals[0]}`}>See them all →</a></div>
      <div class="grid">{more.map(x => <RecipeCard recipe={x} />)}</div>
    </section>
  )}
</Base>

<script>
  // ticked ingredients are remembered on this device, per recipe, while you cook
  const key = `atb-ings:${location.pathname}`;
  const boxes = [...document.querySelectorAll<HTMLInputElement>('#ings input')];
  let ticked: number[] = [];
  try { ticked = JSON.parse(localStorage.getItem(key) || '[]'); } catch {}
  boxes.forEach((b, i) => { b.checked = ticked.includes(i); });
  const save = () => { try { localStorage.setItem(key, JSON.stringify(boxes.flatMap((b, i) => (b.checked ? [i] : [])))); } catch {} };
  boxes.forEach(b => b.addEventListener('change', save));
  document.getElementById('resetIngs')!.addEventListener('click', () => { boxes.forEach(b => (b.checked = false)); save(); });
  document.getElementById('steps')!.addEventListener('click', e => {
    const li = (e.target as HTMLElement).closest('li');
    li?.classList.toggle('done');
  });
</script>

<style>
  .crumbs { padding-top: 22px; font-size: 14.5px; color: var(--ink-2); }
  .crumbs a { color: var(--ink); text-decoration-color: var(--banana-ink); text-underline-offset: 3px; }
  .top { display: grid; grid-template-columns: 320px minmax(0, 1fr); gap: 30px; margin-top: 16px; align-items: start; }
  .art { aspect-ratio: 1; display: grid; place-items: center; border: 2px solid var(--ink); }
  .art svg { width: 45%; transform: rotate(-8deg); }
  .photo { margin: 0; }
  .photo img { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border: 2px solid var(--ink); background: var(--paper-2); }
  .photo figcaption { margin-top: 6px; font-size: 13px; line-height: 1.45; color: var(--ink-3); }
  .photo figcaption a { color: var(--ink-3); }
  .nutrition { margin-top: 28px; }
  .nutrition .per { font-size: 14px; color: var(--ink-2); }
  .kcal { font-size: 15px; color: var(--ink-2); margin: 2px 0 8px; }
  .kcal b { font: 400 34px/1 var(--display); color: var(--ink); margin-right: 2px; }
  .nutrition table { width: 100%; border-collapse: collapse; font-size: 15.5px; border-top: 2px solid var(--ink); border-bottom: 2px solid var(--ink); }
  .nutrition th, .nutrition td { padding: 8px 2px; border-bottom: 1px solid var(--line); }
  .nutrition th { text-align: left; font-weight: 600; }
  .nutrition td { text-align: right; font-variant-numeric: tabular-nums; font-weight: 700; }
  .nutrition tr.sub th { font-weight: 500; color: var(--ink-2); padding-left: 14px; }
  .nutrition tr.sub td { font-weight: 500; color: var(--ink-2); }
  .nut-note { font-size: 14px; color: var(--ink-3); line-height: 1.5; margin: 10px 0 0; }
  .nut-note a { color: var(--ink-2); }
  .tags { display: flex; gap: 6px 12px; flex-wrap: wrap; font-size: 15px; font-weight: 600; }
  .tags a { color: var(--ink); text-decoration-color: var(--banana-ink); text-underline-offset: 3px; }
  .tags span { color: var(--ink-2); font-weight: 500; }
  h1 { font-size: var(--t-1); margin: 8px 0 8px; }
  .blurb { font-size: 18px; color: var(--ink-2); margin: 0; }
  .facts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 20px 0 0; border: 2px solid var(--ink); background: var(--card); }
  .facts div { padding: 10px 12px; border-right: 2px solid var(--ink); }
  .facts div:last-child { border-right: 0; }
  .facts dt { font: 700 var(--t-label) var(--text); letter-spacing: .1em; text-transform: uppercase; color: var(--ink-2); }
  .facts dd { margin: 2px 0 0; font: 400 20px/1.2 var(--display); }
  .cap { text-transform: capitalize; }
  .row { display: flex; gap: 10px 24px; flex-wrap: wrap; align-items: center; margin-top: 16px; font-size: 15px; }
  .row b { font-weight: 700; margin-right: 8px; }
  .meter { display: inline-flex; align-items: center; }
  .ripe-chip { display: inline-flex; align-items: center; gap: 8px; color: var(--ink); text-decoration: none; border: 2px solid var(--ink); border-radius: var(--r-ctl); padding: 4px 10px 4px 5px; margin-right: 6px; font-weight: 600; min-height: 40px; }
  .ripe-chip:hover { background: var(--paper-2); }
  .ripe-chip i { width: 26px; height: 26px; border: 2px solid var(--ink); border-radius: 50%; }
  .diet { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 12px; }
  .diet span { font-size: 14px; font-weight: 700; color: var(--leaf); border: 2px solid currentColor; border-radius: var(--r-ctl); padding: 2px 10px; }

  .cols { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr); gap: 40px; margin-top: 32px; padding-top: 22px; border-top: 2px solid var(--ink); }
  .col-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8px; }
  .col-head h2 { font-size: var(--t-2); margin: 0; }
  .link { font: 600 15px var(--text); color: var(--ink-2); background: none; border: none; cursor: pointer; padding: 10px 0; text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 3px; }
  .ings ul { list-style: none; margin: 0; padding: 0; }
  .ings li { border-bottom: 1px solid var(--line); }
  .ings label { display: flex; gap: 12px; align-items: flex-start; padding: 11px 2px; cursor: pointer; font-size: 16px; min-height: 44px; }
  .ings input { width: 22px; height: 22px; margin-top: 1px; accent-color: var(--leaf); flex: none; }
  .ings input:checked + span { color: var(--ink-3); text-decoration: line-through; }
  .method ol { margin: 0; padding: 0; list-style: none; counter-reset: step; }
  .method li { counter-increment: step; }
  .method li button { display: grid; grid-template-columns: 38px 1fr; gap: 12px; width: 100%; text-align: left; font: 400 16.5px/1.55 var(--text); color: var(--ink);
    background: none; border: none; border-bottom: 1px solid var(--line); padding: 13px 2px; cursor: pointer; }
  .method li button::before { content: counter(step); display: grid; place-items: center; width: 34px; height: 34px; border: 2px solid var(--ink); border-radius: 50%; background: var(--banana); color: #231A10; font: 400 17px var(--display); }
  .method li.done button { color: var(--ink-3); }
  .method li.done button::before { content: '✓'; background: var(--paper-2); color: var(--leaf); font-family: var(--text); font-weight: 700; }
  .tip { margin-top: 18px; border: 2px dashed var(--ink); padding: 12px 14px; font-size: 16px; }
  .tip b { margin-right: 6px; }
  .note { color: var(--ink-3); font-size: 14px; }
  .hub { display: block; margin-top: 18px; padding: 12px 14px; border: 2px solid var(--ink); color: var(--ink); font-weight: 600; text-decoration: none; font-size: 16px; background: var(--card); }
  .hub:hover { background: var(--paper-2); }

  .more { margin-top: 44px; padding-top: 20px; border-top: 2px solid var(--ink); }
  .more-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 14px; gap: 12px; flex-wrap: wrap; }
  .more-head h2 { font-size: var(--t-2); margin: 0; }
  .more-head a { color: var(--ink); font-weight: 600; font-size: 15px; text-decoration-color: var(--banana-ink); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 18px; }

  @media (max-width: 860px) {
    .top { grid-template-columns: 1fr; }
    .art { aspect-ratio: auto; height: 200px; }
    .art svg { width: 110px; }
    .photo img { aspect-ratio: 3 / 2; }
    .cols { grid-template-columns: 1fr; }
    .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .facts div:nth-child(2) { border-right: 0; }
    .facts div:nth-child(-n+2) { border-bottom: 2px solid var(--ink); }
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  }
  @media print {
    :global(.mast), :global(.board-strip), :global(.foot), .crumbs, .art, .photo, .more, .link, .note { display: none !important; }
    :global(:root) { --paper: #fff; --card: #fff; --ink: #000; --ink-2: #222; --ink-3: #555; --line: #ccc; }
  }
</style>
