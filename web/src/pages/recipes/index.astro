---
import Base from '../../layouts/Base.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import { recipes, MEALS, RIPENESS } from '../../data/recipes';
const count = (meal: string) => recipes.filter(r => r.meals.includes(meal as never)).length;
---
<Base wide section="recipes" title="Peelicious · banana recipes for breakfast, lunch, dinner and more · All Things Banana"
      description={`${recipes.length} banana recipes from around the world: banana bread, pancakes, smoothies, plantain dishes, desserts and more. Filter by meal, by how ripe your bananas are, or by how much banana you want.`}>
  <header class="head">
    <div>
      <h1>Peelicious</h1>
      <p><b>{recipes.length} banana recipes</b> from around the world, from breakfast to cocktails. Pick a meal, tell us how ripe your bananas are, or just browse.</p>
    </div>
    <button class="surprise" id="surprise">🎲 Surprise me</button>
  </header>

  <section class="ripe" aria-label="How ripe are your bananas?">
    <h2>What are your bananas like?</h2>
    <div class="ripe-row" id="ripe">
      {RIPENESS.map(r => (
        <button data-ripe={r.id} aria-pressed="false">
          <span class="swatch" style={`background:${r.colour}`}></span>
          <b>{r.label}</b><span class="ripe-hint">{r.hint}</span>
        </button>
      ))}
    </div>
  </section>

  <div class="tools">
    <div class="meals" id="meals" role="group" aria-label="Meal">
      <button data-meal="" class="on">All <span>{recipes.length}</span></button>
      {MEALS.map(m => <button data-meal={m.id}>{m.label} <span>{count(m.id)}</span></button>)}
    </div>
    <div class="row2">
      <input id="find" type="search" placeholder="Search recipes or ingredients (e.g. oats, coconut, chocolate)" aria-label="Search recipes">
      <div class="toggles" id="diet" role="group" aria-label="Diet and time">
        <button data-diet="vegan">Vegan</button>
        <button data-diet="gluten-free">Gluten-free</button>
        <button data-diet="no-bake">No oven</button>
        <button data-quick="30">Under 30 min</button>
      </div>
      <label class="sort">Sort
        <select id="sort">
          <option value="banana">Most banana first</option>
          <option value="quick">Quickest first</option>
          <option value="az">A–Z</option>
          <option value="few">Fewest ingredients</option>
        </select>
      </label>
    </div>
  </div>

  <p class="status" id="status" aria-live="polite"></p>
  <div class="grid" id="grid">
    {recipes.map(r => <RecipeCard recipe={r} />)}
  </div>
  <div class="none" id="none" hidden>
    <p>No recipes match all of that.</p>
    <button id="clear">Clear filters</button>
  </div>
</Base>

<script>
  const $ = (s: string) => document.querySelector(s) as HTMLElement;
  const grid = $('#grid');
  const cards = [...grid.querySelectorAll<HTMLAnchorElement>('.rc')];
  const state = { meal: '', ripe: '', diet: new Set<string>(), quick: 0, q: '', sort: 'banana' };

  // filters live in the address, so a filtered view can be shared or bookmarked
  function readUrl() {
    const p = new URLSearchParams(location.search);
    state.meal = p.get('meal') || '';
    state.ripe = p.get('ripe') || '';
    state.diet = new Set((p.get('diet') || '').split(',').filter(Boolean));
    state.quick = Number(p.get('quick')) || 0;
    state.q = p.get('q') || '';
    state.sort = p.get('sort') || 'banana';
  }
  function writeUrl() {
    const p = new URLSearchParams();
    if (state.meal) p.set('meal', state.meal);
    if (state.ripe) p.set('ripe', state.ripe);
    if (state.diet.size) p.set('diet', [...state.diet].join(','));
    if (state.quick) p.set('quick', String(state.quick));
    if (state.q) p.set('q', state.q);
    if (state.sort !== 'banana') p.set('sort', state.sort);
    history.replaceState(null, '', p.size ? `?${p}` : location.pathname);
  }

  function apply() {
    const words = state.q.toLowerCase().split(/\s+/).filter(Boolean);
    const shown = cards.filter(c => {
      const d = c.dataset;
      const ok = (!state.meal || d.meals!.split(' ').includes(state.meal))
        && (!state.ripe || d.ripe!.split(' ').includes(state.ripe))
        && [...state.diet].every(x => d.diet!.split(' ').includes(x))
        && (!state.quick || Number(d.mins) <= state.quick)
        && words.every(w => d.search!.includes(w));
      c.hidden = !ok;
      return ok;
    });
    const by: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
      banana: (a, b) => Number(b.dataset.level) - Number(a.dataset.level) || Number(a.dataset.mins) - Number(b.dataset.mins),
      quick: (a, b) => Number(a.dataset.mins) - Number(b.dataset.mins),
      az: (a, b) => a.dataset.name!.localeCompare(b.dataset.name!),
      few: (a, b) => Number(a.dataset.ings) - Number(b.dataset.ings),
    };
    [...cards].sort(by[state.sort]).forEach(c => grid.append(c));

    $('#none').hidden = shown.length > 0;
    const bits = [state.meal && document.querySelector(`[data-meal="${state.meal}"]`)?.firstChild?.textContent?.trim().toLowerCase(),
      state.ripe && `for ${state.ripe} bananas`, state.q && `matching “${state.q}”`].filter(Boolean);
    $('#status').textContent = `${shown.length} ${shown.length === 1 ? 'recipe' : 'recipes'}${bits.length ? ' · ' + bits.join(' · ') : ''}`;

    document.querySelectorAll<HTMLButtonElement>('#meals button').forEach(b => b.classList.toggle('on', (b.dataset.meal || '') === state.meal));
    document.querySelectorAll<HTMLButtonElement>('#ripe button').forEach(b => { const on = b.dataset.ripe === state.ripe; b.classList.toggle('on', on); b.setAttribute('aria-pressed', String(on)); });
    document.querySelectorAll<HTMLButtonElement>('#diet button').forEach(b => b.classList.toggle('on', b.dataset.diet ? state.diet.has(b.dataset.diet) : state.quick === Number(b.dataset.quick)));
    ($('#sort') as HTMLSelectElement).value = state.sort;
    if (($('#find') as HTMLInputElement).value !== state.q) ($('#find') as HTMLInputElement).value = state.q;
    writeUrl();
  }

  $('#meals').addEventListener('click', e => { const b = (e.target as HTMLElement).closest('button'); if (b) { state.meal = b.dataset.meal || ''; apply(); } });
  $('#ripe').addEventListener('click', e => { const b = (e.target as HTMLElement).closest('button'); if (b) { state.ripe = state.ripe === b.dataset.ripe ? '' : b.dataset.ripe!; apply(); } });
  $('#diet').addEventListener('click', e => {
    const b = (e.target as HTMLElement).closest('button'); if (!b) return;
    if (b.dataset.diet) { state.diet.has(b.dataset.diet) ? state.diet.delete(b.dataset.diet) : state.diet.add(b.dataset.diet); }
    else state.quick = state.quick ? 0 : Number(b.dataset.quick);
    apply();
  });
  $('#find').addEventListener('input', e => { state.q = (e.target as HTMLInputElement).value.trim(); apply(); });
  $('#sort').addEventListener('change', e => { state.sort = (e.target as HTMLSelectElement).value; apply(); });
  $('#clear').addEventListener('click', () => { Object.assign(state, { meal: '', ripe: '', diet: new Set(), quick: 0, q: '' }); apply(); });
  $('#surprise').addEventListener('click', () => {
    const pool = cards.filter(c => !c.hidden);
    const pick = (pool.length ? pool : cards)[Math.floor(Math.random() * (pool.length || cards.length))];
    location.href = pick.href;
  });

  readUrl();
  apply();
</script>

<style>
  .head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; padding: 26px 0 6px; flex-wrap: wrap; }
  .head h1 { margin: 0; font-size: 34px; font-weight: 900; letter-spacing: -0.03em; }
  .head h1::first-letter { color: var(--brand); }
  .head p { margin: 6px 0 0; color: var(--ink-2); max-width: 640px; font-size: 15.5px; }
  .surprise { font: 800 14px 'Inter', sans-serif; color: #1d1600; background: var(--brand); border: none; border-radius: 999px; padding: 10px 18px; cursor: pointer; }
  .surprise:hover { filter: brightness(1.06); }

  .ripe { margin-top: 18px; }
  .ripe h2 { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--ink-3); margin: 0 0 8px; }
  .ripe-row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
  .ripe-row button { display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto auto; gap: 0 10px; align-items: center; text-align: left;
    font: inherit; color: var(--ink); background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 10px 12px; cursor: pointer; }
  .ripe-row button:hover { border-color: var(--ink-3); }
  .ripe-row button.on { border-color: var(--brand); box-shadow: inset 0 0 0 1px var(--brand); }
  .swatch { grid-row: 1 / span 2; width: 26px; height: 26px; border-radius: 50%; box-shadow: inset 0 -3px 0 rgba(0, 0, 0, .2); }
  .ripe-row b { font-size: 14px; }
  .ripe-hint { font-size: 12px; color: var(--ink-3); }

  .tools { margin-top: 16px; padding: 12px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); display: flex; flex-direction: column; gap: 10px;
    position: sticky; top: 0; z-index: 5; background: var(--bg); }
  .meals { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; }
  .meals::-webkit-scrollbar { display: none; }
  .meals button, .toggles button { font: 700 13.5px 'Inter', sans-serif; color: var(--ink-2); background: transparent; border: 1px solid var(--border); border-radius: 999px; padding: 7px 14px; cursor: pointer; white-space: nowrap; }
  .meals button span { color: var(--ink-3); font-weight: 600; margin-left: 2px; }
  .meals button:hover, .toggles button:hover { color: var(--ink); background: var(--chip); }
  .meals button.on { color: #1d1600; background: var(--brand); border-color: var(--brand); }
  .meals button.on span { color: #5a4100; }
  .toggles button.on { color: var(--ink); border-color: var(--brand); background: color-mix(in srgb, var(--brand) 14%, transparent); }
  .row2 { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
  #find { flex: 1; min-width: 220px; height: 36px; border: 1px solid var(--border); border-radius: 999px; background: var(--field); color: var(--ink); padding: 0 16px; font: 500 14px 'Inter', sans-serif; outline: none; }
  #find:focus { border-color: var(--brand); }
  .toggles { display: flex; gap: 6px; flex-wrap: wrap; }
  .sort { font-size: 13px; color: var(--ink-3); font-weight: 600; display: flex; align-items: center; gap: 6px; }
  .sort select { font: 600 13px 'Inter', sans-serif; color: var(--ink); background: var(--field); border: 1px solid var(--border); border-radius: 8px; padding: 6px 8px; }

  .status { color: var(--ink-3); font-size: 13px; margin: 14px 0 10px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 16px; }
  .none { text-align: center; padding: 40px 0; color: var(--ink-2); }
  .none button { font: 700 14px 'Inter', sans-serif; color: #1d1600; background: var(--brand); border: none; border-radius: 999px; padding: 9px 18px; cursor: pointer; }

  @media (max-width: 860px) { .ripe-row { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .head h1 { font-size: 28px; }
    .ripe-hint { display: none; }
    .tools { position: static; }
  }
</style>
