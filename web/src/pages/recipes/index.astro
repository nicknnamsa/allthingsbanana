---
import Base from '../../layouts/Base.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import { recipes, MEALS, RIPENESS } from '../../data/recipes';
import { readFileSync } from 'node:fs';
// recipes from other sites, found by scripts/crawl-recipes.mjs (loaded in the browser, counted here)
let web: { meals: string[]; s: string }[] = [];
try { web = JSON.parse(readFileSync(new URL('../../../public/recipes/web.json', import.meta.url), 'utf8')); } catch {}
const webSites = new Set(web.map(w => w.s)).size;
const count = (meal: string) => recipes.filter(r => r.meals.includes(meal as never)).length + web.filter(w => w.meals.includes(meal)).length;
---
<Base image="/og/recipes.jpg" wide section="recipes" title="Banacipes · banana recipes for breakfast, lunch, dinner and more · All Things Banana"
      description={`${recipes.length} banana recipes from around the world: banana bread, pancakes, smoothies, plantain dishes, desserts and more. Filter by meal, by how ripe your bananas are, or by how much banana you want.`}>
  <header class="head">
    <div>
      <h1>Banacipes</h1>
      <p><b>{recipes.length} banana recipes</b> of our own{web.length > 0 && <> plus <b>{web.length.toLocaleString('en-US')} more</b> from {webSites} recipe sites</>}, from breakfast to cocktails. Pick a meal, tell us how ripe your bananas are, or just browse.</p>
    </div>
    <button class="btn banana" id="surprise">Surprise me</button>
  </header>

  <section class="ripe" aria-label="How ripe are your bananas?">
    <h2>What are your bananas like?</h2>
    <div class="ripe-row" id="ripe">
      {RIPENESS.map(r => (
        <button data-ripe={r.id} aria-pressed="false" class={`seg-${r.id}`}>
          <b>{r.label}</b><span class="ripe-hint">{r.hint}</span>
        </button>
      ))}
    </div>
  </section>

  <div class="tools">
    <div class="meals" id="meals" role="group" aria-label="Meal">
      <button data-meal="" class="tog on">All <span class="n">{(recipes.length + web.length).toLocaleString('en-US')}</span></button>
      {MEALS.map(m => <button class="tog" data-meal={m.id}>{m.label} <span class="n">{count(m.id)}</span></button>)}
    </div>
    <div class="row2">
      <input id="find" type="search" placeholder="Search recipes or ingredients (e.g. oats, coconut, chocolate)" aria-label="Search recipes">
      <div class="toggles" id="diet" role="group" aria-label="Diet and time">
        <button class="tog" data-diet="vegan">Vegan</button>
        <button class="tog" data-diet="gluten-free">Gluten-free</button>
        <button class="tog" data-diet="no-bake">No oven</button>
        <button class="tog" data-quick="30">Under 30 min</button>
      </div>
      <div class="src" id="src" role="group" aria-label="Whose recipes" hidden={web.length === 0}>
        <button class="tog on" data-src="">All</button><button class="tog" data-src="ours">Ours</button><button class="tog" data-src="web">Other sites</button>
      </div>
      <label class="sort">Sort
        <select id="sort">
          <option value="banana">Most banana first</option>
          <option value="quick">Quickest first</option>
          <option value="az">A–Z</option>
          <option value="rated">Top rated</option>
          <option value="few">Fewest ingredients</option>
        </select>
      </label>
    </div>
  </div>

  <p class="status" id="status" aria-live="polite"></p>
  <h2 class="sec-h" id="ourHead">Our recipes</h2>
  <div class="grid clip" id="grid">
    {recipes.map(r => <RecipeCard recipe={r} />)}
  </div>
  <button class="btn plain more-ours" id="moreOurs" type="button">Show all {recipes.length} of ours</button>
  <section class="web" id="web" hidden>
    <div class="web-head"><h2 class="sec-h">From around the web</h2><span id="webCount"></span></div>
    <div class="grid" id="webGrid"></div>
    <button id="webMore" class="btn plain more-btn" hidden>Show more recipes</button>
    <p class="web-note">These link to recipes on other sites. We show the name, photo, time and rating each site publishes; the full recipe is on their site.</p>
  </section>
  <div class="none" id="none" hidden>
    <p>No recipes match all of that.</p>
    <button class="btn banana" id="clear">Clear filters</button>
  </div>
</Base>

<script>
  const $ = (s: string) => document.querySelector(s) as HTMLElement;
  const grid = $('#grid');
  const cards = [...grid.querySelectorAll<HTMLAnchorElement>('.rc')];
  const state = { meal: '', ripe: '', diet: new Set<string>(), quick: 0, q: '', sort: 'banana', src: '' };

  // ---------- recipes from other sites ----------
  type Web = { n: string; u: string; s: string; i?: string; m?: number; meals: string[]; d: string[]; l: number; r?: number; c?: number; k?: string };
  let web: Web[] = [], webShown = 24, showAllOurs = false;
  const MEAL_LABEL: Record<string, string> = { breakfast: 'Breakfast', lunch: 'Lunch', dinner: 'Dinner', snack: 'Snacks', dessert: 'Desserts', drink: 'Drinks' };
  // other sites don't say how ripe the bananas should be, so match on the kind of dish
  const RIPE_HINT: Record<string, RegExp> = {
    green: /tostone|green|mofongo|matoke|chips|mang[uú]|patacon|fried plantain|plantain chips|curry|raw banana/i,
    yellow: /split|foster|caramel|grill|salad|foster|boat|pudding|banoffee|cream pie|dipped|sushi|sandwich/i,
    spotty: /smoothie|pancake|muffin|shake|waffle|oat|nice cream|ice cream|lassi|french toast|crepe/i,
    brown: /banana bread|bread|muffin|cake|cookie|brownie|smoothie|nice cream|blondie|loaf|pancake/i,
  };
  const esc = (t: string) => t.replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  const fmtMins = (m?: number) => !m ? '' : m < 60 ? `${m} min` : m % 60 ? `${Math.floor(m / 60)} h ${m % 60} min` : `${m / 60} h`;
  function webCard(w: Web) {
    const art = w.i
      ? `<img src="${esc(w.i)}" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.parentElement.classList.add('noimg');this.remove()">`
      : '';
    return `<a class="wc" href="${esc(w.u)}" target="_blank" rel="noopener">
      <div class="wc-art ${w.i ? '' : 'noimg'}">${art}</div>
      <div class="wc-body">
        <div class="wc-tags">${w.meals.slice(0, 2).map(m => `<span>${MEAL_LABEL[m] || m}</span>`).join('')}</div>
        <h3>${esc(w.n)}</h3>
        <div class="wc-src">on ${esc(w.s)} ↗</div>
        <div class="wc-foot">
          <span class="pips" aria-label="Banana-o-meter ${w.l} of 5">${[1, 2, 3, 4, 5].map(i => `<i class="${i <= w.l ? 'on' : ''}"></i>`).join('')}</span>
          <span>${w.r ? `★ ${w.r.toFixed(1)}${w.c ? ` <small>(${w.c.toLocaleString('en-US')})</small>` : ''}` : ''}${w.r && w.m ? ' · ' : ''}${fmtMins(w.m)}</span>
        </div>
      </div></a>`;
  }
  fetch('/recipes/web.json').then(r => r.json()).then((d: Web[]) => { web = d; apply(); }).catch(() => {});

  // filters live in the address, so a filtered view can be shared or bookmarked
  function readUrl() {
    const p = new URLSearchParams(location.search);
    state.meal = p.get('meal') || '';
    state.ripe = p.get('ripe') || '';
    state.diet = new Set((p.get('diet') || '').split(',').filter(Boolean));
    state.quick = Number(p.get('quick')) || 0;
    state.q = p.get('q') || '';
    state.sort = p.get('sort') || 'banana';
    state.src = p.get('from') || '';
  }
  function writeUrl() {
    const p = new URLSearchParams();
    if (state.meal) p.set('meal', state.meal);
    if (state.ripe) p.set('ripe', state.ripe);
    if (state.diet.size) p.set('diet', [...state.diet].join(','));
    if (state.quick) p.set('quick', String(state.quick));
    if (state.q) p.set('q', state.q);
    if (state.sort !== 'banana') p.set('sort', state.sort);
    if (state.src) p.set('from', state.src);
    history.replaceState(null, '', p.size ? `?${p}` : location.pathname);
  }

  function apply() {
    const words = state.q.toLowerCase().split(/\s+/).filter(Boolean);
    // our recipes: shown or hidden in place
    const shown = cards.filter(c => {
      const d = c.dataset;
      const ok = state.src !== 'web'
        && (!state.meal || d.meals!.split(' ').includes(state.meal))
        && (!state.ripe || d.ripe!.split(' ').includes(state.ripe))
        && [...state.diet].every(x => d.diet!.split(' ').includes(x))
        && (!state.quick || Number(d.mins) <= state.quick)
        && words.every(w => d.search!.includes(w));
      c.hidden = !ok;
      return ok;
    });
    const by: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
      banana: (a, b) => Number(b.dataset.level) - Number(a.dataset.level) || Number(a.dataset.mins) - Number(b.dataset.mins),
      quick: (a, b) => Number(a.dataset.mins) - Number(b.dataset.mins),
      az: (a, b) => a.dataset.name!.localeCompare(b.dataset.name!),
      few: (a, b) => Number(a.dataset.ings) - Number(b.dataset.ings),
      rated: (a, b) => Number(b.dataset.level) - Number(a.dataset.level),
    };
    [...cards].sort(by[state.sort]).forEach(c => grid.append(c));
    $('#ourHead').hidden = !shown.length || !web.length;
    const filtering = !!(state.meal || state.ripe || state.diet.size || state.quick || state.q || state.src === 'web');
    grid.classList.toggle('clip', !filtering && !showAllOurs);
    $('#moreOurs').hidden = filtering || showAllOurs || state.src === 'web';

    // other sites: filtered, sorted, then shown a page at a time
    const webList = state.src === 'ours' ? [] : web.filter(w =>
      (!state.meal || w.meals.includes(state.meal))
      && (!state.ripe || RIPE_HINT[state.ripe].test(w.n))
      && [...state.diet].every(x => w.d.includes(x))
      && (!state.quick || (w.m != null && w.m <= state.quick))
      && words.every(x => `${w.n} ${w.s} ${w.k || ''}`.toLowerCase().includes(x)));
    const wBy: Record<string, (a: Web, b: Web) => number> = {
      banana: (a, b) => b.l - a.l || (b.c || 0) - (a.c || 0),
      quick: (a, b) => (a.m ?? 1e9) - (b.m ?? 1e9),
      az: (a, b) => a.n.localeCompare(b.n),
      rated: (a, b) => ((b.r || 0) * Math.log10((b.c || 0) + 10)) - ((a.r || 0) * Math.log10((a.c || 0) + 10)),
      few: (a, b) => (b.c || 0) - (a.c || 0),
    };
    webList.sort(wBy[state.sort]);
    $('#web').hidden = !webList.length;
    $('#webGrid').innerHTML = webList.slice(0, webShown).map(webCard).join('');
    $('#webMore').hidden = webList.length <= webShown;
    $('#webCount').textContent = `${webList.length.toLocaleString('en-US')} from ${new Set(webList.map(w => w.s)).size} sites`;

    const total = shown.length + webList.length;
    $('#none').hidden = total > 0 || (!web.length && shown.length > 0);
    const bits = [state.meal && MEAL_LABEL[state.meal]?.toLowerCase(),
      state.ripe && `for ${state.ripe} bananas`, state.q && `matching “${state.q}”`].filter(Boolean);
    $('#status').textContent = `${total.toLocaleString('en-US')} ${total === 1 ? 'recipe' : 'recipes'}${web.length && state.src === '' ? ` (${shown.length} ours, ${webList.length.toLocaleString('en-US')} from other sites)` : ''}${bits.length ? ' · ' + bits.join(' · ') : ''}`;

    document.querySelectorAll<HTMLButtonElement>('#meals button').forEach(b => b.classList.toggle('on', (b.dataset.meal || '') === state.meal));
    document.querySelectorAll<HTMLButtonElement>('#ripe button').forEach(b => { const on = b.dataset.ripe === state.ripe; b.classList.toggle('on', on); b.setAttribute('aria-pressed', String(on)); });
    document.querySelectorAll<HTMLButtonElement>('#diet button').forEach(b => b.classList.toggle('on', b.dataset.diet ? state.diet.has(b.dataset.diet) : state.quick === Number(b.dataset.quick)));
    document.querySelectorAll<HTMLButtonElement>('#src button').forEach(b => b.classList.toggle('on', (b.dataset.src || '') === state.src));
    ($('#sort') as HTMLSelectElement).value = state.sort;
    if (($('#find') as HTMLInputElement).value !== state.q) ($('#find') as HTMLInputElement).value = state.q;
    writeUrl();
  }
  const reset = () => { webShown = 24; apply(); };
  $('#moreOurs').addEventListener('click', () => { showAllOurs = true; apply(); });

  $('#meals').addEventListener('click', e => { const b = (e.target as HTMLElement).closest('button'); if (b) { state.meal = b.dataset.meal || ''; reset(); } });
  $('#ripe').addEventListener('click', e => { const b = (e.target as HTMLElement).closest('button'); if (b) { state.ripe = state.ripe === b.dataset.ripe ? '' : b.dataset.ripe!; reset(); } });
  $('#src').addEventListener('click', e => { const b = (e.target as HTMLElement).closest('button'); if (b) { state.src = b.dataset.src || ''; reset(); } });
  $('#webMore').addEventListener('click', () => { webShown += 24; apply(); });
  $('#diet').addEventListener('click', e => {
    const b = (e.target as HTMLElement).closest('button'); if (!b) return;
    if (b.dataset.diet) { state.diet.has(b.dataset.diet) ? state.diet.delete(b.dataset.diet) : state.diet.add(b.dataset.diet); }
    else state.quick = state.quick ? 0 : Number(b.dataset.quick);
    reset();
  });
  $('#find').addEventListener('input', e => { state.q = (e.target as HTMLInputElement).value.trim(); reset(); });
  $('#sort').addEventListener('change', e => { state.sort = (e.target as HTMLSelectElement).value; reset(); });
  $('#clear').addEventListener('click', () => { Object.assign(state, { meal: '', ripe: '', diet: new Set(), quick: 0, q: '', src: '' }); reset(); });
  // surprise me: one of our recipes (it has a page here), from whatever the filters show
  $('#surprise').addEventListener('click', () => {
    const pool = cards.filter(c => !c.hidden);
    const pick = (pool.length ? pool : cards)[Math.floor(Math.random() * (pool.length || cards.length))];
    location.href = pick.href;
  });

  readUrl();
  apply();
</script>

<style>
  .head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; padding: 34px 0 6px; flex-wrap: wrap; }
  .head h1 { margin: 0; font-size: var(--t-1); }
  .head p { margin: 8px 0 0; color: var(--ink-2); max-width: 640px; }
  .head p b { color: var(--ink); }

  /* the ripeness scale as a picker: green → yellow → spotty → brown */
  .ripe { margin-top: 22px; }
  .ripe h2 { font: 600 21px var(--display); margin: 0 0 8px; }
  .ripe-row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
  .ripe-row button { position: relative; display: flex; flex-direction: column; gap: 2px; text-align: left; font: inherit; border: 0; border-radius: var(--r-lg); padding: 12px 16px; cursor: pointer; min-height: 64px; color: var(--ink); }
    .seg-green { background: var(--r1); color: #fff !important; }
  .seg-yellow { background: var(--r4); color: #231A10 !important; }
  .seg-spotty { background: var(--r5) radial-gradient(circle at 80% 30%, #5a3416 0 3px, transparent 3.5px), radial-gradient(circle at 90% 70%, #5a3416 0 2.5px, transparent 3px); background-color: var(--r5); color: #231A10 !important; }
  .seg-brown { background: var(--r7); color: #fff !important; }
  .ripe-row b { font-size: 17px; }
  .ripe-hint { font-size: 14px; opacity: .92; }
  .ripe-row button.on { box-shadow: 0 0 0 3px var(--paper), 0 0 0 6px var(--ink); }
  .ripe-row button.on b::after { content: ' ✓'; }

  .tools { margin-top: 18px; padding: 12px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); display: flex; flex-direction: column; gap: 10px;
    position: sticky; top: 0; z-index: 5; background: var(--paper); }
  .meals { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; }
  .meals::-webkit-scrollbar { display: none; }
  .row2 { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  #find { flex: 1; min-width: 220px; height: 44px; border: 1px solid var(--line); border-radius: var(--r-ctl); background: var(--card); color: var(--ink); padding: 0 14px; font: 500 16px var(--text); outline: none; }
  #find:focus { box-shadow: 0 0 0 3px var(--banana); }
  .toggles { display: flex; gap: 6px; flex-wrap: wrap; }
  .src { display: inline-flex; gap: 0; }
  .src .tog { border-radius: 0; margin-left: -2px; }
  .src .tog:first-child { border-radius: var(--r-ctl) 0 0 var(--r-ctl); margin-left: 0; }
  .src .tog:last-child { border-radius: 0 var(--r-ctl) var(--r-ctl) 0; }
  .sort { font-size: 15px; color: var(--ink-2); font-weight: 600; display: flex; align-items: center; gap: 6px; }
  .sort select { font: 600 15px var(--text); color: var(--ink); background: var(--card); border: 1px solid var(--line); border-radius: var(--r-ctl); padding: 0 8px; height: 40px; }

  .status { color: var(--ink-2); font-size: 15px; margin: 14px 0 10px; }
  .sec-h { font-size: var(--t-2); margin: 6px 0 14px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 18px; }
  .more-ours { display: none; margin: 16px auto 0; }
  .web { margin-top: 40px; }
  .web-head { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .web-head span { color: var(--ink-2); font-size: 15px; }
  .web-note { color: var(--ink-3); font-size: 14px; margin-top: 14px; }
  .more-btn { display: flex; margin: 18px auto 0; }
  .web :global(.wc) { display: flex; flex-direction: column; background: var(--card); border: 1px solid var(--line); text-decoration: none; color: var(--ink); min-width: 0; }
  .web :global(.wc:hover h3) { text-decoration: underline; text-decoration-color: var(--banana-ink); }
  .web :global(.wc-art) { height: 150px; background: var(--paper-2); border-bottom: 1px solid var(--line); overflow: hidden; }
  .web :global(.wc-art img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .web :global(.wc-art.noimg) { background: var(--r4); }
  .web :global(.wc-body) { padding: 11px 13px 13px; display: flex; flex-direction: column; gap: 3px; flex: 1; }
  .web :global(.wc-tags) { display: flex; gap: 6px; font-size: 13px; font-weight: 600; color: var(--ink-2); }
  .web :global(.wc-tags span + span::before) { content: '· '; }
  .web :global(.wc h3) { margin: 2px 0 0; font: 700 16.5px/1.3 var(--text); }
  .web :global(.wc-src) { color: var(--ink-2); font-size: 14px; }
  .web :global(.wc-foot) { margin-top: auto; padding-top: 8px; display: flex; justify-content: space-between; align-items: center; gap: 6px; font-size: 13.5px; color: var(--ink-2); font-weight: 600; }
  .web :global(.wc-foot small) { font-weight: 500; }
  .none { text-align: center; padding: 40px 0; color: var(--ink-2); }

  @media (max-width: 860px) { .ripe-row { grid-template-columns: repeat(2, minmax(0, 1fr)); } .ripe-row button:nth-child(2) { border-right: 0; } .ripe-row button:nth-child(-n+2) { border-bottom: 1px solid var(--line); } }
  @media (max-width: 600px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .grid.clip > :global(.rc:nth-child(n+9)) { display: none; }
    .more-ours { display: flex; }
    .more-ours[hidden] { display: none; }
    .web :global(.wc-art) { height: 96px; }
    .web :global(.wc h3) { font-size: 15px; }
    .web :global(.wc-foot) { flex-wrap: wrap; font-size: 12.5px; }
    .web :global(.wc-src) { font-size: 12.5px; }
    .ripe-hint { display: none; }
    .ripe-row button { min-height: 52px; }
    .tools { position: static; }
  }
</style>
