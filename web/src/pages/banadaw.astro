  function drawRackPreviews() {
    const steps = stepsOf(song);
    $('rack').querySelectorAll<HTMLCanvasElement>('canvas.rk-prev').forEach(cv => {
      const c = song.ch.find(x => x.id === cv.closest<HTMLElement>('.rk')!.dataset.id)!;
      const dpr = devicePixelRatio || 1, W = 150, H = 30;
      cv.width = W * dpr; cv.height = H * dpr;
      const g = cv.getContext('2d')!; g.scale(dpr, dpr);
