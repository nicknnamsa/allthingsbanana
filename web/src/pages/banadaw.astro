  // the computer keyboard plays the selected synth, like a little piano: A W S E D F T G Y H U J K
  const KEYMAP = 'awsedftgyhujk';
  const SLICE_KEYS = 'qwertyui', STUTTER_KEYS: Record<string, [number, string]> = { z: [4, '1 beat'], x: [2, '1/8'], c: [1, '1/16'] };
  addEventListener('keydown', e => {
    const typing = (e.target as HTMLElement).closest('input, select, textarea, .knob, dialog');
    if (typing) return;
    const k = e.key.toLowerCase(), mod = e.metaKey || e.ctrlKey;
    if (e.code === 'Space') { e.preventDefault(); toggle(); return; }
    if (mod && k === 'z') { e.preventDefault(); e.shiftKey ? redo() : undo(); return; }
    if (k === 'm' && !mod && !e.altKey) { toggleMetro(); return; }
