      const sw = W / steps;
      for (let b = 0; b < song.bars * 4; b++) if (b % 2) { g.fillStyle = C.black; g.fillRect(b * 4 * sw, 0, 4 * sw, H); }
      g.fillStyle = COLORS[c.color];
      if (c.kind === 'drum') c.steps.forEach((v, i) => { if (v) { g.globalAlpha = 0.35 + v * 0.65; g.fillRect(i * sw + 0.5, 6, Math.max(1, sw - 1), H - 12); } });
