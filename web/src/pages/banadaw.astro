---
import Base from '../layouts/Base.astro';
---
<Base wide section="banadaw" image="/og/banadaw.jpg" title="BanaDAW · make banana beats in your browser · All Things Banana"
      description="BanaDAW: a one-loop music studio in your browser. Program drums, draw melodies in a piano roll, tweak synths with knobs, then share a link or download a WAV. Lo-fi to dark club.">
  <header class="bd-intro">
    <div class="bd-tags"><span class="tag"><i class="dot d-butter"></i>Beta</span><span class="tag soft">Works best with headphones</span></div>
    <h1>BanaDAW</h1>
    <p>A banana-powered loop studio. Pick a sound from the bunch, draw notes in the piano roll, turn the knobs. Space plays. <a href="/banadaw/how-to/">How BanaDAW works →</a></p>
  </header>

  <div class="bdaw" id="app" data-view="notes" data-no-banana>
    <!-- toolbar -->
    <div class="tb">
      <div class="tb-g">
        <button class="t-btn play" id="play" title="Play / stop (Space)" aria-label="Play"><svg viewBox="0 0 20 20"><path d="M6 4l10 6-10 6z"/></svg></button>
        <button class="t-btn" id="stop" title="Stop" aria-label="Stop"><svg viewBox="0 0 20 20"><rect x="5" y="5" width="10" height="10" rx="1"/></svg></button>
        <button class="t-btn" id="metro" aria-pressed="false" title="Metronome (M)" aria-label="Metronome"><svg viewBox="0 0 20 20"><path d="M7.2 2.5h5.6l3.2 15H4z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M10 13.5 14.5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M5 14.5h10" stroke="currentColor" stroke-width="1.6"/></svg></button>
        <output class="lcd" id="lcd" aria-label="Position">1.1.1</output>
        <span class="mascot" id="mascot" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M5.5 8.5c1.5 11 11 18.5 22 14.5-1.5 3.5-5.5 5.5-10.5 5.5C9.5 28.5 4 20 5.5 8.5z" fill="var(--banana)" stroke="var(--ink)" stroke-width="2" stroke-linejoin="round"/><path d="M5.5 8.5 4.6 4.4l3 1.3" fill="none" stroke="var(--ink)" stroke-width="2" stroke-linecap="round"/></svg></span>
      </div>
      <label class="tb-f lcd-f">BPM <input class="lcd" id="bpm" type="number" min="60" max="200" step="1"></label>
      <div class="tb-f"><span>Loop</span><span class="seg" id="bars" role="group" aria-label="Loop length in bars"></span><span>bars</span></div>
      <label class="tb-f">Key <select id="root"></select></label>
      <label class="tb-f">Scale <select id="scale"></select></label>
      <div class="tb-knobs" id="masterKnobs"></div>
      <canvas class="meter" id="meter" width="14" height="40" aria-hidden="true"></canvas>
      <span class="sp"></span>
      <div class="tb-g">
        <button class="t-btn txt" id="undo" title="Undo (Ctrl/Cmd+Z)">Undo</button>
        <button class="t-btn txt" id="redo" title="Redo (Shift+Ctrl/Cmd+Z)">Redo</button>
      </div>
      <button class="t-btn txt" id="fresh" title="Empty every channel and start again (undo brings it back)">Start from scratch</button>
      <label class="tb-f"><span class="sr-only">Load a starter loop</span><select id="starter"></select></label>
      <button class="t-btn txt hl" id="post" title="Put your loop on the board for everyone to hear and vote on">Post to the board</button>
      <button class="t-btn txt" id="share">Share link</button>
      <button class="t-btn txt" id="wav" title="Download the loop, played a few times, as a WAV file">WAV</button>
    </div>

    <div class="main">
      <!-- channel rack -->
      <aside class="rack" aria-label="Channel rack">
        <div class="pane-h"><input class="song-name" id="songName" aria-label="Loop name" maxlength="40"></div>
        <div class="rack-t"><span>The bunch</span><small id="rackCount"></small><button class="mini-tog" id="compact" aria-pressed="false" title="Make the rows smaller">Compact</button></div>
        <div class="rack-list" id="rack"></div>
        <label class="rack-add"><span class="sr-only">Add a channel</span><select id="add"></select></label>
      </aside>

      <!-- piano roll / drum roll -->
      <section class="editor" aria-label="Editor">
        <div class="pane-h ed-h">
          <span class="ed-tabs" role="tablist" aria-label="Editor">
            <button role="tab" data-view="notes" aria-selected="true">Notes</button>
            <button role="tab" data-view="auto" aria-selected="false">Automation</button>
            <button role="tab" data-view="pads" aria-selected="false">Pads</button>
          </span>
          <span class="ed-title notes-only"><i id="edSw"></i><b id="edName"></b><small id="edKind"></small></span>
          <span class="ed-tools">
            <button class="tog auto-only" id="condense" aria-pressed="false" title="Make every lane small">Condense all</button>
            <label class="tb-f syn">Draw <select id="chord"></select></label>
            <label class="tb-f syn">Length <select id="len"><option value="1">1/16</option><option value="2">1/8</option><option value="4">1/4</option><option value="8">1/2</option><option value="16">1 bar</option></select></label>
            <label class="tb-f not-pads">Snap <select id="snap"><option value="1">1/16</option><option value="2">1/8</option><option value="4">1/4</option><option value="16">Bar</option></select></label>
            <button class="tog syn" id="lock" aria-pressed="true" title="New and moved notes stay in the key">Scale lock</button>
            <button class="tog syn" id="ghost" aria-pressed="true" title="Show the other instruments' notes faintly">Ghosts</button>
            <span class="zoom notes-only"><button class="tog" id="zOut" aria-label="Zoom out">−</button><button class="tog" id="zIn" aria-label="Zoom in">+</button></span>
            <button class="tog notes-only" id="clear">Clear</button>
          </span>
        </div>
        <div class="roll" id="roll">
          <div class="corner"></div>
          <canvas id="ruler" aria-hidden="true"></canvas>
          <canvas id="keys" aria-label="Keyboard: click a key to hear it"></canvas>
          <div class="view" id="view">
            <div class="scroll" id="scroll"><div id="spacer"></div></div>
            <canvas id="grid" aria-hidden="true"></canvas>
          </div>
          <div class="vel-l" title="How hard each note or hit plays: green is soft, brown hits hardest">Ripeness</div>
          <canvas id="vel" aria-label="Velocity: drag up and down"></canvas>
        </div>
        <div class="auto-view" id="autoView" hidden>
          <div class="av-top"><div class="av-corner">Track and knob</div><canvas id="avRuler" aria-hidden="true"></canvas></div>
          <div class="av-lanes" id="lanes"></div>
        </div>
        <div class="pad-view" id="padView" hidden>
          <div class="pv-grid" id="padGrid" aria-label="Pads: keys 1 to 9"></div>
          <div class="pv-side">
            <div class="pv-box">
              <div class="pv-sel"><b id="padSelName">Pad 1</b><small id="padSelMeta"></small></div>
              <div class="pv-acts">
                <button class="tog" id="padSave">Save the editor's loop here</button>
                <button class="tog" id="padOpen">Open in the editor</button>
                <button class="tog" id="padClear">Empty this pad</button>
              </div>
            </div>
            <div class="pv-box pv-row">
              <label class="tb-f">Launch on <select id="padQ"><option value="bar">the next bar</option><option value="beat">the next beat</option><option value="now">straight away</option></select></label>
              <button class="tog" id="padTempo" aria-pressed="true" title="Every pad plays at the BPM in the toolbar">Same tempo</button>
              <button class="tog" id="padStop" title="Stop at the end of the bar (0)">Stop <kbd>0</kbd></button>
              <button class="tog rec" id="padRec" aria-pressed="false">● Record</button>
            </div>
            <div class="pv-box">
              <div class="pv-l"><b>Slices</b> <small>hold a key to repeat that part of the loop</small></div>
              <canvas id="padStrip" aria-hidden="true"></canvas>
              <div class="pv-keys" id="slices"></div>
              <div class="pv-l"><b>Stutter</b> <small>hold to repeat what's playing</small></div>
              <div class="pv-keys" id="stutters"></div>
            </div>
          </div>
        </div>
        <p class="help" id="help"></p>
      </section>
    </div>

    <!-- the selected channel -->
    <section class="chan" id="chan" aria-label="Channel settings">
      <div class="chan-id">
        <i class="sw" id="chSw"></i>
        <input class="ch-name" id="chName" aria-label="Channel name" maxlength="24">
        <select id="inst" aria-label="Instrument"></select>
        <button class="tog" id="dup">Duplicate</button>
        <button class="tog" id="del">Delete</button>
      </div>
      <div class="knob-row"><span class="kr-l">Sound</span><div class="knobs" id="soundKnobs"></div></div>
      <div class="knob-row"><span class="kr-l">Mix</span><div class="knobs" id="mixKnobs"></div></div>
    </section>
    <div class="toast" id="toast" role="status" hidden></div>
  </div>

  <section class="bd-board" id="board" aria-labelledby="boardH">
    <div class="bd-start-h">
      <div><h2 id="boardH">The board</h2><p id="boardSub">Loops people made here. Play one, remix it, and give the best ones a banana.</p></div>
      <div class="bd-tabs" role="tablist" aria-label="Sort the board">
        <button role="tab" data-sort="week" aria-selected="true">Top this week</button>
        <button role="tab" data-sort="all" aria-selected="false">Top ever</button>
        <button role="tab" data-sort="new" aria-selected="false">Newest</button>
      </div>
    </div>
    <div class="bd-list" id="boardList" aria-live="polite"></div>
    <button class="btn plain bd-more" id="boardMore" hidden>Show more</button>
  </section>

  <dialog class="bd-dialog" id="postDlg" aria-labelledby="postH">
    <form method="dialog" id="postForm">
      <h2 id="postH">Post to the board</h2>
      <p>Everyone can play your loop, remix it and vote for it. Names are public, so keep them friendly.</p>
      <label>Loop name <input id="postName" maxlength="40" required></label>
      <label>Your name <small>(optional)</small> <input id="postAuthor" maxlength="24" placeholder="Anonymous banana"></label>
      <p class="bd-err" id="postErr" role="alert" hidden></p>
      <div class="bd-dlg-acts"><button class="btn plain" value="cancel" formnovalidate>Cancel</button><button class="btn banana" id="postGo" value="post">Post it</button></div>
    </form>
  </dialog>

  <section class="bd-start" aria-labelledby="startH">
    <div class="bd-start-h"><h2 id="startH">Start from a bunch</h2><p>Every loop is yours to change. Undo brings back whatever you had.</p></div>
    <div class="bd-cards" id="starterCards"></div>
  </section>
</Base>

<script>
  import { Engine, renderWav } from '../scripts/banadaw/engine';
  import {
    type Song, type Channel, type Note, type Bars, type Chord, type DrumSound, type SynthPreset,
    STARTERS, SCALES, NOTE_NAMES, COLORS, DRUMS, SYNTHS, DRUM_KNOBS, SYNTH_KNOBS, BAR_CHOICES, CHORDS, STEPS_PER_BAR,
    blankSong, newId, stepsOf, setBars, encodeSong, decodeSong, validSong, noteName, inScale, snapToScale, chordAt, drumChannel, synthChannel, drumDefaults,
    type AutoParam, MASTER_AUTO, autoParams, autoParam, autoKey, autoAt, knobValue, scaleStep,
  } from '../scripts/banadaw/song';

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const esc = (s: string) => s.replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  const clamp = (x: number, a: number, b: number) => Math.max(a, Math.min(b, x));
  const store = { get: (k: string) => { try { return localStorage.getItem(k); } catch { return null; } }, set: (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} } };
  const coarse = matchMedia('(pointer: coarse)').matches;

  const engine = new Engine();
  let song: Song;
  let selId = '';
  let lastLen = 2, lastVel = 0.8, snap = 1, chord: Chord = 'note', lock = true, ghosts = true, zoom = 1;
  const past: string[] = [], future: string[] = [];
  const sel = () => song.ch.find(c => c.id === selId) ?? song.ch[0];
  const drums = () => song.ch.filter(c => c.kind === 'drum');

  // ---------- every edit goes through here, so undo and autosave just work ----------
  const snapshot = () => JSON.stringify(song);
  function commit(before: string) {
    if (before === snapshot()) return;
    past.push(before); if (past.length > 150) past.shift();
    future.length = 0;
    save();
  }
  function save() { engine.setSong(song); store.set('banadaw2', snapshot()); }
  function edit(fn: () => void) { const b = snapshot(); fn(); commit(b); refresh(); }
  function load(s: Song) {
    song = s; selection = new Set();
    if (!song.ch.some(c => c.id === selId)) selId = song.ch.find(c => c.kind === 'synth')?.id ?? song.ch[0]?.id ?? '';
    engine.setSong(song);
    refresh(true);
  }
  function undo() { const p = past.pop(); if (!p) return; future.push(snapshot()); song = JSON.parse(p); load(song); save(); }
  function redo() { const f = future.pop(); if (!f) return; past.push(snapshot()); song = JSON.parse(f); load(song); save(); }
  function refresh(recenter = false) { drawTop(); drawRack(); drawChan(); layout(recenter); if (tab === 'auto') drawLanes(); }
  let selection = new Set<Note>();   // notes picked with Alt-drag in the piano roll
  let tab: 'notes' | 'auto' | 'pads' = 'notes';

  let toastT = 0;
  function toast(msg: string) { const t = $('toast'); t.textContent = msg; t.hidden = false; clearTimeout(toastT); toastT = window.setTimeout(() => (t.hidden = true), 2600); }

  // ---------- knobs: drag up and down (Shift for fine), double-click to reset, arrow keys work too ----------
  type Knob = { label: string; get: () => number; set: (v: number) => void; def: number; min?: number; max?: number; fmt: (v: number) => string; bi?: boolean };
  const knobs = new Map<string, Knob>();
  const pct = (v: number) => `${Math.round(v * 100)}%`;
  const isAuto = (ak?: string) => !!(ak && song.auto?.[ak]?.length);
  function knobHTML(key: string, k: Knob, size = '', ak?: string) {
    knobs.set(key, k);
    return `<div class="knob ${size}${isAuto(ak) ? ' auto' : ''}" data-k="${key}"${ak ? ` data-ak="${ak}"` : ''} role="slider" tabindex="0" aria-label="${esc(k.label)}"><svg viewBox="0 0 40 40" aria-hidden="true"><circle class="k-bg" cx="20" cy="20" r="15"/><path class="k-tr" d="${arc(-135, 135)}"/><path class="k-arc"/><line class="k-tick" x1="20" y1="20" x2="20" y2="8"/></svg><span class="k-l">${esc(k.label)}</span><span class="k-v"></span></div>`;
  }
  function arc(a0: number, a1: number) {
    const p = (a: number) => [20 + 15 * Math.sin((a * Math.PI) / 180), 20 - 15 * Math.cos((a * Math.PI) / 180)];
    if (Math.abs(a1 - a0) < 0.5) return '';
    const [x0, y0] = p(a0), [x1, y1] = p(a1);
    return `M${x0.toFixed(2)} ${y0.toFixed(2)}A15 15 0 ${Math.abs(a1 - a0) > 180 ? 1 : 0} ${a1 > a0 ? 1 : 0} ${x1.toFixed(2)} ${y1.toFixed(2)}`;
  }
  function paintKnob(el: HTMLElement, over?: number) {
    const k = knobs.get(el.dataset.k!); if (!k) return;
    const min = k.min ?? 0, max = k.max ?? 1, v = over ?? k.get(), n = (v - min) / (max - min), a = -135 + n * 270;
    el.querySelector('.k-arc')!.setAttribute('d', k.bi ? arc(Math.min(0, a), Math.max(0, a)) : arc(-135, a));
    el.querySelector('.k-tick')!.setAttribute('transform', `rotate(${a} 20 20)`);
    el.querySelector('.k-v')!.textContent = k.fmt(v);
    el.setAttribute('aria-valuemin', String(min)); el.setAttribute('aria-valuemax', String(max));
    el.setAttribute('aria-valuenow', v.toFixed(2)); el.setAttribute('aria-valuetext', k.fmt(v));
    el.title = el.classList.contains('auto') ? `${k.label} is automated: the line in the Automation tab turns it while the loop plays` : '';
  }
  // knobs with a line in the Automation tab get a pink dot (and follow the line while playing)
  function refreshAutoMarks() {
    $('app').querySelectorAll<HTMLElement>('.knob[data-ak]').forEach(el => { el.classList.toggle('auto', isAuto(el.dataset.ak)); paintKnob(el); });
  }
  const paintKnobs = (root: ParentNode) => root.querySelectorAll<HTMLElement>('.knob').forEach(paintKnob);
  function setKnob(el: HTMLElement, v: number) {
    const k = knobs.get(el.dataset.k!)!;
    k.set(clamp(v, k.min ?? 0, k.max ?? 1)); paintKnob(el); engine.setSong(song);
    if (el.closest('.rack')) drawRackPreviews();
  }
  $('app').addEventListener('pointerdown', e => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('.knob'); if (!el) return;
    e.preventDefault(); el.focus(); el.setPointerCapture(e.pointerId); el.classList.add('turning');
    const k = knobs.get(el.dataset.k!)!, range = (k.max ?? 1) - (k.min ?? 0), y0 = e.clientY, v0 = k.get(), before = snapshot();
    const move = (ev: PointerEvent) => setKnob(el, v0 + ((y0 - ev.clientY) / (ev.shiftKey ? 700 : 160)) * range);
    const up = () => { el.removeEventListener('pointermove', move); el.classList.remove('turning'); commit(before); };
    el.addEventListener('pointermove', move); el.addEventListener('pointerup', up, { once: true }); el.addEventListener('pointercancel', up, { once: true });
  });
  $('app').addEventListener('dblclick', e => { const el = (e.target as HTMLElement).closest<HTMLElement>('.knob'); if (!el) return; const b = snapshot(); setKnob(el, knobs.get(el.dataset.k!)!.def); commit(b); });
  $('app').addEventListener('keydown', e => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('.knob'); if (!el) return;
    const k = knobs.get(el.dataset.k!)!, r = (k.max ?? 1) - (k.min ?? 0);
    const d = { ArrowUp: 0.02, ArrowRight: 0.02, ArrowDown: -0.02, ArrowLeft: -0.02, PageUp: 0.1, PageDown: -0.1 }[e.key];
    if (d == null) return;
    e.preventDefault(); const b = snapshot(); setKnob(el, k.get() + d * r); commit(b);
  });

  // ---------- toolbar ----------
  $('root').innerHTML = NOTE_NAMES.map((n, i) => `<option value="${i}">${n}</option>`).join('');
  $('scale').innerHTML = SCALES.map(s => `<option value="${s.id}">${s.label}</option>`).join('');
  $('bars').innerHTML = BAR_CHOICES.map(b => `<button data-b="${b}">${b}</button>`).join('');
  $('starter').innerHTML = `<option value="">Loops…</option>` + STARTERS.map(s => `<option value="${s.id}">${esc(s.label)}: ${esc(s.blurb)}</option>`).join('') + `<option value="blank">Empty loop</option>`;
  $('chord').innerHTML = CHORDS.map(c => `<option value="${c.id}">${c.label}</option>`).join('');
  $('add').innerHTML = `<option value="">+ Add channel</option><optgroup label="Drums">${(Object.keys(DRUMS) as DrumSound[]).map(d => `<option value="d:${d}">${DRUMS[d].label}</option>`).join('')}</optgroup>`
    + ['Bass', 'Lead', 'Chords', 'Keys', 'FX'].map(gr => `<optgroup label="${gr}">${(Object.keys(SYNTHS) as SynthPreset[]).filter(p => SYNTHS[p].group === gr).map(p => `<option value="s:${p}">${SYNTHS[p].label}</option>`).join('')}</optgroup>`).join('');

  const fmtFilter = (v: number) => (v < -0.02 ? `Dark ${pct(-v)}` : v > 0.02 ? `Thin ${pct(v)}` : 'Open');
  const fmtPan = (v: number) => (Math.abs(v) < 0.04 ? 'Centre' : `${pct(Math.abs(v))} ${v < 0 ? 'L' : 'R'}`);
  const hzFmt = (v: number) => { const f = 30 * 2 ** (v * 9.3); return f >= 1000 ? `${(f / 1000).toFixed(1)} kHz` : `${Math.round(f)} Hz`; };
  const secs = (s: number) => (s < 1 ? `${Math.round(s * 1000)} ms` : `${s.toFixed(2)} s`);
  const fmtTune = (v: number) => `${v >= 0.5 ? '+' : '−'}${Math.abs(Math.round((v - 0.5) * 14 * 1.2))} st`;
  // how a knob's value reads, for knobs and automation points alike
  function fmtParam(owner: string, k: string, v: number) {
    if (owner === 'm') return k === 'filter' ? fmtFilter(v) : pct(v);
    const c = song.ch.find(x => x.id === owner);
    if (k === 'pan') return fmtPan(v);
    if (k === 'duck') return v < 0.02 ? 'Off' : pct(v);
    if (c?.kind === 'drum' && k === 'tune') return fmtTune(v);
    if (k === 'cutoff') return hzFmt(v);
    if (k === 'attack') return secs(0.0015 + v ** 3 * 2.5);
    if (k === 'release') return secs(0.015 + v * v * 2.5);
    if (k === 'glide') return secs(0.035 + v * v * 0.4);
    return pct(v);
  }
  function drawTop() {
    $<HTMLInputElement>('songName').value = song.name;
    $<HTMLInputElement>('bpm').value = String(song.bpm);
    $<HTMLSelectElement>('root').value = String(song.root);
    $<HTMLSelectElement>('scale').value = song.scale;
    $('bars').querySelectorAll<HTMLButtonElement>('button').forEach(b => b.setAttribute('aria-pressed', String(+b.dataset.b! === song.bars)));
    $('masterKnobs').innerHTML = [
      knobHTML('swing', { label: 'Swing', get: () => song.swing, set: v => (song.swing = v), def: 0, max: 0.6, fmt: v => pct(v / 0.6) }, 'sm'),
      knobHTML('mfilter', { label: 'Filter', get: () => song.master.filter, set: v => (song.master.filter = Math.abs(v) < 0.03 ? 0 : v), def: 0, min: -1, max: 1, bi: true, fmt: fmtFilter }, 'sm', 'm:filter'),
      knobHTML('mdrive', { label: 'Drive', get: () => song.master.drive, set: v => (song.master.drive = v), def: 0.15, fmt: pct }, 'sm', 'm:drive'),
      knobHTML('mvol', { label: 'Master', get: () => song.master.vol, set: v => (song.master.vol = v), def: 0.8, fmt: pct }, 'sm', 'm:vol'),
    ].join('');
    paintKnobs($('masterKnobs'));
  }
  $('songName').addEventListener('change', e => edit(() => { song.name = (e.target as HTMLInputElement).value.trim() || 'Untitled bunch'; }));
  $('bpm').addEventListener('change', e => edit(() => { song.bpm = clamp(Math.round(+(e.target as HTMLInputElement).value) || 120, 60, 200); }));
  $('bars').addEventListener('click', e => { const b = (e.target as HTMLElement).closest('button'); if (b && +b.dataset.b! !== song.bars) edit(() => setBars(song, +b.dataset.b! as Bars)); });
  $('root').addEventListener('change', e => edit(() => {   // changing key moves the music with it
    const r = +(e.target as HTMLSelectElement).value, d = ((((r - song.root) % 12) + 18) % 12) - 6;
    for (const c of song.ch) if (c.kind === 'synth') c.notes.forEach(n => (n.m += d));
    song.root = r;
  }));
  $('scale').addEventListener('change', e => edit(() => { song.scale = (e.target as HTMLSelectElement).value as Song['scale']; }));
  $('starter').addEventListener('change', e => {
    const el = e.target as HTMLSelectElement, id = el.value; el.value = '';
    if (!id) return;
    const st = STARTERS.find(s => s.id === id);
    edit(() => { song = st ? st.make() : blankSong(); selId = ''; });
    load(song); toast(`Loaded ${st ? st.label : 'an empty loop'}. Undo brings your old one back.`);
