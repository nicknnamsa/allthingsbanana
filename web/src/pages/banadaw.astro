  const toggleMetro = () => { engine.metronome = !engine.metronome; store.set('banadaw-metro', engine.metronome ? '1' : '0'); metroBtn(); toast(engine.metronome ? 'Metronome on.' : 'Metronome off.'); };
  $('metro').addEventListener('click', toggleMetro); metroBtn();
