  $('len').addEventListener('change', e => (lastLen = +(e.target as HTMLSelectElement).value));
  $('snap').addEventListener('change', e => (snap = +(e.target as HTMLSelectElement).value));
  $('chord').addEventListener('change', e => (chord = (e.target as HTMLSelectElement).value as Chord));
  $('lock').addEventListener('click', () => { lock = !lock; $('lock').setAttribute('aria-pressed', String(lock)); });
  $('ghost').addEventListener('click', () => { ghosts = !ghosts; $('ghost').setAttribute('aria-pressed', String(ghosts)); dirty = true; });
  $('zIn').addEventListener('click', () => { zoom = Math.min(4, zoom * 1.4); layout(); });
  $('zOut').addEventListener('click', () => { zoom = Math.max(0.4, zoom / 1.4); layout(); });
  $('clear').addEventListener('click', () => {
    const c = sel();
    edit(() => { if (c.kind === 'drum') c.steps = c.steps.map(() => 0); else c.notes = []; });
    toast(`Cleared ${c.name}. Undo brings it back.`);
  });
  syncLen();

  // ---------- the frame loop: playhead, position display and level meter ----------
  const meterCv = $<HTMLCanvasElement>('meter');
  let shownPos = '', peakHold = 0;
  function frame() {
    const pos = engine.position();
    if (pos != null || dirty || (flash && performance.now() - flash.t < 300)) {
      // follow the playhead when the loop is wider than the screen
      if (pos != null && !drag) { const x = pos * cw; if (x > scroll.scrollLeft + scroll.clientWidth - 24 || x < scroll.scrollLeft) scroll.scrollLeft = Math.max(0, x - 24); }
      draw(pos); dirty = false;
    }
    const p = pos == null ? '1.1.1' : `${Math.floor(pos / 16) + 1}.${Math.floor((pos % 16) / 4) + 1}.${Math.floor(pos % 4) + 1}`;
    if (p !== shownPos) { $('lcd').textContent = p; shownPos = p; }
    const lv = engine.playing ? engine.level() : 0;
    peakHold = Math.max(lv, peakHold * 0.92);
    const g = fit(meterCv, 14, 40);
    g.fillStyle = '#1b1f22'; g.fillRect(0, 0, 14, 40);
    const h = Math.min(1, peakHold) * 38;
    g.fillStyle = peakHold > 0.97 ? '#FF5C5C' : peakHold > 0.8 ? '#FFD23F' : '#7BDA5B'; g.fillRect(3, 39 - h, 8, h);
    requestAnimationFrame(frame);
  }
  new ResizeObserver(() => layout()).observe(view);

  // ---------- start: a shared link, the last loop on this device, or Red Circle ----------
  (async () => {
    const m = location.hash.match(/s=([\w-]+)/);
    let s: Song | null = null;
    if (m) { s = await decodeSong(m[1]); if (!s) toast('That link is from an older BanaDAW, so here’s a starter loop instead.'); else toast('You opened someone’s loop. Change anything: it’s your remix now.'); }
    if (!s) { try { const saved = JSON.parse(store.get('banadaw2') || 'null'); if (validSong(saved)) s = saved; } catch {} }
    load(s ?? STARTERS[0].make());
    requestAnimationFrame(frame);
  })();
</script>

