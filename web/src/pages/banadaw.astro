      const d: { beats: Beat[]; more: boolean; total: number } = await r.json();
      const html = d.beats.map((b, i) => beatCard(b, i)).join('');
      if (more) list.insertAdjacentHTML('beforeend', html);
      else list.innerHTML = html || (boardSort === 'week' && d.total
        ? '<p class="bd-empty">Nothing new this week yet. Check “Top ever”, or post the first one.</p>'
        : '<p class="bd-empty">No loops yet. Make something, then press <b>Post to the board</b> to be the first.</p>');
