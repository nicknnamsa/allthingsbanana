---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found · All Things Banana" description="This page doesn't exist.">
  <article class="lost">
    <span class="stamp">Not found</span>
    <h1>Slipped on a banana skin.</h1>
    <p>This page doesn't exist, or it did and we ate it.</p>
    <div class="go"><a class="btn" href="/">Today's puzzle</a><a class="btn plain" href="/recipes/">Banana recipes</a></div>
  </article>
</Base>

<style>
  .lost { text-align: center; padding: 70px 0 30px; }
  .lost h1 { font-size: var(--t-1); margin: 22px 0 8px; }
  .lost p { color: var(--ink-2); margin: 0; }
  .go { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-top: 22px; }
</style>
