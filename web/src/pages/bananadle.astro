---
import Base from '../layouts/Base.astro';
import PopularityChart from '../components/PopularityChart.astro';
import degrees from '../data/games/degrees.json';
// only what the game needs in the browser
const starts = degrees.starts.map(s => ({ t: s.title }));
---
<Base wide section="bananadle" title="Bananadle · the daily Wikipedia puzzle · All Things Banana"
      description="Bananadle, a daily word puzzle: start on a Wikipedia article and get to Banana by naming articles each page links to, from memory. New start page every day.">
  <script type="application/json" id="degData" set:html={JSON.stringify(starts)} />

  <div class="sd">
    <div class="sd-layout">
      <section class="sd-stage" aria-live="polite">
        <header class="sd-top">
          <div class="sd-brand">
            <span class="sd-logo" aria-hidden="true">🍌</span>
            <div>
              <h1>Bananadle</h1>
              <div class="sd-day" id="dayNo"></div>
            </div>
          </div>
          <div class="sd-topBtns">
            <div class="sd-modes">
              <button id="modeDaily" class="on">Daily</button>
              <button id="modePractice">Practice</button>
            </div>
            <button id="helpBtn" class="sd-round" aria-label="How to play">?</button>
          </div>
        </header>

        <div class="sd-goal">
          <span class="sd-pill start" id="goalStart">…</span>
          <span class="sd-dots" aria-hidden="true"></span>
          <span class="sd-pill target">🍌 Banana</span>
        </div>

        <div class="sd-card" id="card">
          <div class="sd-label" id="whereLabel">You're on</div>
          <h2 id="current">…</h2>
          <div class="sd-desc" id="desc"></div>
          <p class="sd-extract" id="extract"></p>
          <div class="sd-warm" id="warm" hidden>🔥 This page links to Banana!</div>
        </div>

        <div id="playArea">
          <form id="guessForm" class="sd-guess" autocomplete="off">
            <input id="guess" type="text" placeholder="Type a page it links to…" aria-label="Your guess" autocapitalize="off" spellcheck="false" enterkeyhint="go">
            <button type="submit" id="goBtn">Go</button>
          </form>
          <div id="feedback" class="sd-feedback"></div>
        </div>

        <div class="sd-trail">
          <ol id="path"></ol>
        </div>

        <div class="sd-bottom">
          <div class="sd-stats">
            <span>Steps <b id="sSteps">0</b></span>
            <span>Par <b id="sPar">–</b></span>
            <span>Misses <b id="sMisses">0</b></span>
            <span>⏱ <b id="sTime">0:00</b></span>
          </div>
          <div class="sd-tools">
            <button id="hintBtn" class="sd-text">💡 Hint</button>
            <button id="giveUpBtn" class="sd-text">Give up</button>
          </div>
        </div>
        <div id="hintBox" class="sd-hint" hidden></div>

        <div id="done" class="sd-done" hidden>
          <div class="sd-doneEmoji" id="doneEmoji">🍌</div>
          <div class="sd-big" id="doneTitle"></div>
          <div class="sd-sub" id="doneSub"></div>
          <div class="sd-doneBtns">
            <button id="shareBtn" class="sd-primary">Share result</button>
            <button id="practiceBtn" class="sd-secondary">Practice round</button>
          </div>
          <p class="sd-best" id="best"></p>
          <div id="world" class="sd-world" hidden>
            <h3>Everyone today</h3>
            <div id="worldSummary" class="sd-worldSummary"></div>
            <div id="hist" class="sd-hist"></div>
          </div>
        </div>

        <p class="sd-credit">Page titles and summaries come live from <a href="https://en.wikipedia.org/" rel="noopener" target="_blank">Wikipedia</a> (<a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="license noopener" target="_blank">CC BY-SA 4.0</a>). Not affiliated with Wikipedia.</p>
      </section>

      <aside class="sd-side">
        <div class="sd-mini">
          <h3>Your streak</h3>
          <div class="sd-streak">
            <div><b id="streak">0</b><span>days</span></div>
            <div><b id="played">0</b><span>played</span></div>
            <div><b id="pars">0</b><span>on par</span></div>
          </div>
        </div>
        <PopularityChart theme="light" />
        <a class="sd-mini sd-peels" href="/more/banana-clicker/" id="peelCard" hidden>
          <h3>Banana Clicker <span>top peelers</span></h3>
          <ol id="peelList"></ol>
          <div class="sd-peelTotal" id="peelTotal"></div>
        </a>
      </aside>
    </div>

    <div class="sd-overlay" id="intro" hidden>
      <div class="sd-modal" role="dialog" aria-modal="true" aria-labelledby="introTitle">
        <div class="sd-modalEmoji" aria-hidden="true">🍌</div>
        <h2 id="introTitle">Bananadle</h2>
        <p class="sd-today" id="introToday"></p>
        <ol class="sd-rules">
          <li><span>🔗</span><div>Type a page that <b>the page you're on links to or mentions</b>.</div></li>
          <li><span>🧭</span><div>Hop from page to page until you reach a page that <b>links to Banana</b>, then type Banana.</div></li>
          <li><span>⛳</span><div><b>Par is 4</b>, like a golf hole: 3 is a birdie, 2 an eagle. A wrong page is a miss; typos are free.</div></li>
        </ol>
        <p class="sd-eg">e.g. <b>Napoleon</b> → <b>Haiti</b> → <b>Banana</b></p>
        <button id="introOk" class="sd-primary sd-wide">OK, let's go</button>
      </div>
    </div>
  </div>
</Base>

<script>
  type Start = { t: string };
  // par is the same for every puzzle, like a golf hole
  const PAR = 4;
  const golf = (n: number) => n === 1 ? { name: 'Hole in one', emoji: '🎯' } : n === 2 ? { name: 'Eagle', emoji: '🦅' } : n === 3 ? { name: 'Birdie', emoji: '🐦' }
    : n === 4 ? { name: 'Par', emoji: '🏆' } : n === 5 ? { name: 'Bogey', emoji: '🍌' } : n === 6 ? { name: 'Double bogey', emoji: '🍌' } : { name: `${n - PAR} over par`, emoji: '🍌' };
  type State = { day: number; start: string; path: string[]; misses: number; hints: number; secs: number; done: boolean; gaveUp: boolean; posted?: boolean };

  const STARTS: Start[] = JSON.parse(document.getElementById('degData')!.textContent!);
  const TARGET = 'Banana';
  const EPOCH = Date.UTC(2026, 9, 7);   // puzzle #1 (must match worker/degrees.js)
  const W = 'https://en.wikipedia.org/w/api.php';
  const $ = (id: string) => document.getElementById(id)!;
  const input = () => document.getElementById('guess') as HTMLInputElement;
  const esc = (s: string) => s.replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  const wikiUrl = (t: string) => 'https://en.wikipedia.org/wiki/' + encodeURIComponent(t.replace(/ /g, '_'));
  // compare titles loosely: case, accents, punctuation and underscores don't matter
  const key = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[_\s]+/g, ' ').replace(/[^\p{L}\p{N} ]/gu, '').replace(/\s+/g, ' ').trim();
  const fmtTime = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
  const plural = (n: number, one: string, many = one + 's') => `${n} ${n === 1 ? one : many}`;
  const store = {
    get<T>(k: string, d: T): T { try { const v = localStorage.getItem(k); return v ? JSON.parse(v) : d; } catch { return d; } },
    set(k: string, v: unknown) { try { localStorage.setItem(k, JSON.stringify(v)); } catch {} },
  };

  // today's puzzle number, by the player's own calendar day
  const now = new Date();
  const today = Math.max(1, Math.floor((Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()) - EPOCH) / 864e5) + 1);
  const dailyStart = STARTS[(today - 1) % STARTS.length];

  async function api(params: Record<string, string>) {
    const q = new URLSearchParams({ format: 'json', formatversion: '2', origin: '*', ...params });
    const res = await fetch(`${W}?${q}`);
    if (!res.ok) throw new Error('Wikipedia ' + res.status);
    return res.json();
  }

  // everything an article links to: loose key -> real title (also under the names it was linked by)
  const linkCache = new Map<string, Promise<Map<string, string>>>();
  function linksOf(title: string) {
    if (!linkCache.has(title)) linkCache.set(title, (async () => {
      const m = new Map<string, string>();
      let cont: Record<string, string> | null = {};
      while (cont) {
        const d = await api({ action: 'query', generator: 'links', titles: title, gplnamespace: '0', gpllimit: 'max', redirects: '1', ...cont });
        for (const p of d.query?.pages || []) if (!p.missing) m.set(key(p.title), p.title);
        for (const r of d.query?.redirects || []) m.set(key(r.from), r.to);
        cont = d.continue || null;
      }
      return m;
    })().catch(e => { linkCache.delete(title); throw e; }));
    return linkCache.get(title)!;
  }

  // articles one step from Banana, for hints (built by scripts/build-degrees.mjs)
  let intoBanana: Promise<Set<string>> | null = null;
  const nearBanana = () => (intoBanana ??= fetch('/games/banana-links-in.json').then(r => r.json()).then((a: string[]) => new Set(a)));

  async function summary(title: string) {
    try {
      const r = await fetch('https://en.wikipedia.org/api/rest_v1/page/summary/' + encodeURIComponent(title.replace(/ /g, '_')));
      if (!r.ok) return null;
      const d = await r.json();
      return { desc: d.description as string | undefined, extract: d.extract as string | undefined };
    } catch { return null; }
  }

  // edit distance where swapping two neighbouring letters ("napels") counts as one mistake
  function distance(a: string, b: string) {
    const d = Array.from({ length: a.length + 1 }, (_, i) => Array.from({ length: b.length + 1 }, (_, j) => (i ? (j ? 0 : i) : j)));
    for (let i = 1; i <= a.length; i++) for (let j = 1; j <= b.length; j++) {
      d[i][j] = Math.min(d[i - 1][j] + 1, d[i][j - 1] + 1, d[i - 1][j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1));
      if (i > 1 && j > 1 && a[i - 1] === b[j - 2] && a[i - 2] === b[j - 1]) d[i][j] = Math.min(d[i][j], d[i - 2][j - 2] + 1);
    }
    return d[a.length][b.length];
  }

  // the meanings of an ambiguous word that the current page links to: the articles listed on its
  // disambiguation page, plus titles that only add a qualifier ("Mercury" -> "Mercury (planet)")
  async function meaningsOf(g: string, real: string | null, ambiguous: boolean, links: Map<string, string>) {
    const k = key(g), linked = new Set(links.values()), out = new Set<string>();
    for (const t of linked) if (key(t.replace(/\s*\([^)]*\)$/, '')) === k) out.add(t);
    if (real && ambiguous) {
      // the meanings listed on the "may refer to" page that this page links to or mentions
      const text = await textOf(current());
      // (a bare mention of "Greek" can't tell "Greek (play)" from "Greek (opera)", so those need a real link)
      const base = (t: string) => key(t.replace(/\s*\([^)]*\)$/, ''));
      for (const t of new Set((await linksOf(real)).values())) if (t !== TARGET && (linked.has(t) || (base(t) !== k && mentions(text, [t])))) out.add(t);
    }
    // drop options that are themselves "may refer to" pages; shortest (usually the main meaning) first
    const list = [...out].filter(t => !/\(disambiguation\)$/.test(t)).sort((a, b) => a.length - b.length).slice(0, 12);
    if (!list.length) return list;
    const d = await api({ action: 'query', titles: list.join('|'), prop: 'pageprops', ppprop: 'disambiguation' });
    const vague = new Set((d.query?.pages || []).filter((p: any) => p.pageprops?.disambiguation !== undefined).map((p: any) => p.title));
    return list.filter(t => !vague.has(t)).slice(0, 6);
  }

  // the article's plain text, to check what it mentions (Wikipedia doesn't link very common things like England)
  const textCache = new Map<string, Promise<string>>();
  function textOf(title: string) {
    if (!textCache.has(title)) textCache.set(title, api({ action: 'query', prop: 'extracts', explaintext: '1', titles: title })
      .then(d => (d.query?.pages?.[0]?.extract as string) || '')
      .catch(e => { textCache.delete(title); throw e; }));
    return textCache.get(title)!;
  }
  // does the text name this article? One-word names must be capitalised ("England" counts, "water" doesn't),
  // so ordinary words only count when they're actually linked
  function mentions(text: string, names: string[]) {
    return names.some(n => {
      n = n.replace(/\s*\([^)]*\)$/, '').trim();
      if (n.length < 3) return false;
      const one = !/\s/.test(n);
      const word = one ? n[0].toUpperCase() + n.slice(1) : n;
      const re = new RegExp(`(?<![\\p{L}\\p{N}])${word.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}(?![\\p{L}\\p{N}])`, one ? 'gu' : 'giu');
      // a capital at the start of a sentence doesn't make a name ("Money is…"), so one-word names must appear mid-sentence
      for (const m of text.matchAll(re)) if (!one || !/(^|[.!?:;]\s*|\n\s*)$/.test(text.slice(Math.max(0, m.index! - 4), m.index))) return true;
      return false;
    });
  }
  // other names for an article (its redirects: "U.S." and "USA" for United States), so mentions by those count too
  async function otherNames(title: string) {
    const d = await api({ action: 'query', titles: title, prop: 'redirects', rdnamespace: '0', rdlimit: 'max' });
    return ((d.query?.pages?.[0]?.redirects || []) as { title: string }[]).map(x => x.title);
  }
  // does the other page link back to this one?
  async function linksBack(other: string, here: string) {
    const d = await api({ action: 'query', titles: other, prop: 'links', pltitles: here, redirects: '1' });
    return !!d.query?.pages?.[0]?.links?.length;
  }

  // ---------- game state ----------
  let mode: 'daily' | 'practice' = 'daily';
  let start: Start = dailyStart;
  let s: State;
  let busy = false;
  let running = false;   // the clock runs once the intro is closed
  let shownTitle = '';
  const saveKey = () => `atb-deg-${today}`;
  const save = () => { if (mode === 'daily') store.set(saveKey(), s); };
  const current = () => s.path[s.path.length - 1];
  const steps = () => s.path.length - 1;
  const newState = (st: Start): State => ({ day: today, start: st.t, path: [st.t], misses: 0, hints: 0, secs: 0, done: false, gaveUp: false });

  function begin(m: 'daily' | 'practice', intro = false) {
    mode = m;
    $('modeDaily').classList.toggle('on', m === 'daily');
    $('modePractice').classList.toggle('on', m === 'practice');
    if (m === 'daily') {
      start = dailyStart;
      const saved = store.get<State | null>(saveKey(), null);
      s = saved && saved.start === start.t ? saved : newState(start);
      $('dayNo').textContent = `Daily puzzle #${today}`;
    } else {
      const pool = STARTS.filter(x => x.t !== dailyStart.t && x.t !== s?.start);
      start = pool[Math.floor(Math.random() * pool.length)];
      s = newState(start);
      $('dayNo').textContent = 'Practice round';
    }
    $('goalStart').textContent = start.t;
    $('feedback').innerHTML = '';
    $('hintBox').hidden = true;
    input().value = '';
    shownTitle = '';
    render();
    if (s.done) { running = false; showDone(); return; }
    $('done').hidden = true;
    if (intro) showIntro();
    else { running = true; input().focus({ preventScroll: true }); }
  }

  function showIntro() {
    running = false;
    $('introToday').innerHTML = s.done
      ? `Today you went from <b>${esc(start.t)}</b> to <b>Banana</b>.`
      : `${mode === 'daily' ? 'Today' : 'This round'}: get from <b>${esc(start.t)}</b> to <b>Banana</b>.`;
    $('introOk').textContent = s.done ? 'Close' : s.path.length > 1 ? 'Carry on' : "OK, let's go";
    $('intro').hidden = false;
    ($('introOk') as HTMLButtonElement).focus();
  }
  function closeIntro() {
    $('intro').hidden = true;
    if (!s.done) { running = true; input().focus({ preventScroll: true }); }
  }

  function render() {
    const cur = current();
    $('current').textContent = cur;
    $('whereLabel').textContent = s.path.length === 1 ? 'Start here' : "You're on";
    $('card').classList.toggle('win', s.done && !s.gaveUp);
    $('sSteps').textContent = String(steps());
    $('sPar').textContent = String(PAR);
    $('sMisses').textContent = String(s.misses);
    $('sTime').textContent = fmtTime(s.secs);
    // the route so far; tapping an earlier page rewinds to it
    $('path').innerHTML = s.path.map((t, i) => {
      const last = i === s.path.length - 1;
      return `<li>${last || s.done ? `<span class="${last ? 'here' : ''}">${esc(t)}</span>` : `<button data-i="${i}" title="Go back to ${esc(t)}">${esc(t)}</button>`}</li>`;
    }).join('') + (s.done ? '' : '<li class="ghost"><span>🍌 Banana</span></li>');
    const playing = !s.done;
    $('playArea').hidden = !playing;
    if (!playing) $('warm').hidden = true;
    for (const id of ['hintBtn', 'giveUpBtn']) $(id).hidden = !playing;
    if (cur !== shownTitle) {
      shownTitle = cur;
      $('desc').textContent = ''; $('extract').textContent = '';
      summary(cur).then(d => {
        if (shownTitle !== cur || !d) return;
        $('desc').textContent = d.desc || '';
        // one sentence, as a reminder of what the page is about
        const ex = (d.extract || '').split(/(?<=\.)\s+/)[0] || '';
        $('extract').textContent = ex.length > 200 ? ex.slice(0, 197) + '…' : ex;
      });
      if (playing) { linksOf(cur).catch(() => {}); textOf(cur).catch(() => {}); }   // start loading, so the first guess is quick
      // one step from winning? say so, so the last move isn't a blind guess
      $('warm').hidden = true;
      if (playing) nearBanana().then(set => { if (shownTitle === cur && !s.done) $('warm').hidden = !set.has(cur); }).catch(() => {});
    }
    renderStreak();
  }

  function say(html: string, kind: 'ok' | 'miss' | 'info' = 'info') {
    $('feedback').innerHTML = `<div class="msg ${kind}">${html}</div>`;
  }

  function move(to: string, how: 'link' | 'mention' | 'back' = 'link') {
    s.path.push(to);
    $('hintBox').hidden = true;
    if (to === TARGET) {
      s.done = true;
      save(); render(); finish();
      return;
    }
    save(); render();
    const prev = esc(s.path[s.path.length - 2]), here = esc(to);
    say(how === 'mention' ? `✓ <b>${prev}</b> mentions <b>${here}</b>` : how === 'back' ? `✓ <b>${here}</b> links to <b>${prev}</b>` : `✓ <b>${prev}</b> links to <b>${here}</b>`, 'ok');
  }

  // going back to an earlier page undoes the steps after it
  function rewind(i: number) {
    if (s.done || i >= s.path.length - 1) return;
    s.path = s.path.slice(0, i + 1);
    $('hintBox').hidden = true;
    save(); render();
    say(`↩ Back on <b>${esc(current())}</b>`);
  }

  async function guess(raw: string) {
    const g = raw.trim();
    if (!g || busy || s.done) return;
    busy = true; $('goBtn').textContent = '…';
    const from = current();
    try {
      const links = await linksOf(from);
      const k = key(g);
      if (k === key(from)) { say(`You're already on <b>${esc(from)}</b>`); return; }
      // 1. one of this page's links, however it's capitalised or spelled with accents
      let hit = links.get(k);
      // 2. another name for an article (a redirect, like "Dubya")
      let real: string | null = null, ambiguous = false;
      if (!hit) {
        // Wikipedia titles are case-sensitive after the first letter, so also try Title Case ("satoshi nakamoto")
        const titleCase = g.replace(/(^|\s)(\p{Ll})/gu, (_, sp, c) => sp + c.toUpperCase());
        const d = await api({ action: 'query', titles: [...new Set([g, titleCase])].join('|'), redirects: '1', prop: 'pageprops', ppprop: 'disambiguation' });
        let p = (d.query?.pages || []).find((x: any) => !x.missing && !x.invalid);
        if (!p) {
          // last try: a search result whose title is exactly what was typed, ignoring case and accents
          const sr = await api({ action: 'query', list: 'search', srsearch: g, srlimit: '5', srprop: '' });
          const exact = (sr.query?.search || []).find((x: any) => key(x.title) === k);
          if (exact) p = (await api({ action: 'query', titles: exact.title, redirects: '1', prop: 'pageprops', ppprop: 'disambiguation' })).query?.pages?.[0];
        }
        if (p && !p.missing && !p.invalid) { real = p.title; ambiguous = p.pageprops?.disambiguation !== undefined; hit = links.get(key(p.title)); }
      }
      if (hit) { input().value = ''; move(hit); return; }
      // 3. not linked, but connected another way: the page mentions it, or it links back here.
      // (The last step must be a real link: Banana mentions or links back to far too much.)
      if (real && !ambiguous && real !== TARGET) {
        const text = await textOf(from);
        if (mentions(text, [real, g]) || mentions(text, await otherNames(real))) { input().value = ''; move(real, 'mention'); return; }
        if (await linksBack(real, from)) { input().value = ''; move(real, 'back'); return; }
      }
      // 4. a word with several meanings ("Greek", "Mercury"): offer the meanings this page does link to (not a miss)
      const meanings = await meaningsOf(g, real, ambiguous, links);
      if (meanings.length) {
        say(`Which one? ${meanings.map(t => `<button class="sugg" data-t="${esc(t)}">${esc(t)}</button>`).join(' ')} <span class="free">no miss</span>`);
        return;
      }
      if (real && ambiguous) {
        say(`“${esc(g)}” has lots of meanings and none are linked here. Try something more specific. <span class="free">no miss</span>`);
        return;
      }
      if (real) {
        s.misses++; save(); render();
        say(real === TARGET
          ? `✗ So close! To finish, the page has to <b>link</b> to Banana, and <b>${esc(from)}</b> doesn't.`
          : `✗ <b>${esc(from)}</b> doesn't link to or mention <b>${esc(real)}</b>`, 'miss');
        return;
      }
      // 5. not an article: suggest the nearest spelling (a typo isn't a miss)
      let near = '', best = 99;
      for (const [lk, title] of links) {
        if (Math.abs(lk.length - k.length) > 2) continue;
        const dist = distance(k, lk);
        if (dist < best) { best = dist; near = title; }
      }
      let suggest = best <= Math.max(1, Math.floor(k.length / 6)) ? near : '';
      if (!suggest) {
        // Wikipedia's own spelling suggestion first, otherwise the top search result if it looks like what was typed
        const d = await api({ action: 'query', list: 'search', srsearch: g, srlimit: '1', srinfo: 'suggestion', srprop: '' });
        const spelled = d.query?.searchinfo?.suggestion as string | undefined;
        const top = d.query?.search?.[0]?.title as string | undefined;
        if (spelled) {
          const sp = await api({ action: 'query', titles: spelled, redirects: '1' });
          const p = sp.query?.pages?.[0];
          if (p && !p.missing && !p.invalid) suggest = p.title;
        }
        if (!suggest && top && distance(key(top), k) <= Math.max(2, Math.floor(k.length / 3))) suggest = top;
      }
      say(suggest
        ? `No page called “${esc(g)}”. Did you mean <button class="sugg" data-t="${esc(suggest)}">${esc(suggest)}</button>? <span class="free">no miss</span>`
        : `No page called “${esc(g)}”. Check the spelling. <span class="free">no miss</span>`);
    } catch {
      say(`Couldn't reach Wikipedia just now. Try again in a moment.`, 'miss');
    } finally {
      busy = false; $('goBtn').textContent = 'Go';
    }
  }

  async function hint() {
    if (s.done) return;
    const from = current();
    $('hintBox').hidden = false;
    $('hintBox').innerHTML = 'Looking…';
    try {
      const [links, near] = await Promise.all([linksOf(from), nearBanana()]);
      const all = [...new Set(links.values())].filter(t => t !== from);
      const pick = <T,>(a: T[]) => a.splice(Math.floor(Math.random() * a.length), 1)[0];
      // one of the three gets you closer to Banana, if this page has such a link
      const closer = all.filter(t => t === TARGET || near.has(t));
      const shown = closer.length ? [pick(closer)] : [];
      const rest = all.filter(t => !shown.includes(t));
      while (shown.length < 3 && rest.length) shown.push(pick(rest));
      shown.sort(() => Math.random() - 0.5);
      s.hints++; save();
      $('hintBox').innerHTML = `${closer.length ? 'One of these gets you closer:' : 'This page links to:'} ${shown.map(t => `<button class="sugg" data-t="${esc(t)}">${esc(t)}</button>`).join(' ')}`;
    } catch {
      $('hintBox').innerHTML = `Couldn't reach Wikipedia just now.`;
    }
  }

  function giveUp() {
    if (s.done || !confirm('Give up and see a shortest route?')) return;
    s.done = true; s.gaveUp = true; save(); render(); finish();
  }

  // ---------- results ----------
  function finish() {
    running = false;
    showDone();
    if (mode !== 'daily') return;
    const hist = store.get<Record<number, { steps: number; solved: boolean; par: number }>>('atb-deg-history', {});
    hist[today] = { steps: steps(), solved: !s.gaveUp, par: PAR };
    store.set('atb-deg-history', hist);
    renderStreak();
    if (!s.posted) {
      s.posted = true; save();
      fetch('/api/degrees', { method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ day: today, steps: Math.max(1, steps()), secs: Math.max(1, s.secs), solved: !s.gaveUp }) })
        .then(r => r.json()).then(showWorld).catch(() => {});
    }
  }

  function showDone() {
    $('done').hidden = false;
    $('feedback').innerHTML = '';
    const g = golf(steps());
    $('doneEmoji').textContent = s.gaveUp ? '🙈' : g.emoji;
    $('doneTitle').textContent = s.gaveUp ? 'So close. Banana got away.' : `${g.name}! Banana in ${plural(steps(), 'step')}`;
    $('doneSub').textContent = s.gaveUp
      ? 'Tomorrow’s a new page.'
      : `Par is ${PAR}. ${plural(s.misses, 'miss', 'misses')} · ${fmtTime(s.secs)}`;
    const route = s.path.map(t => `<a href="${wikiUrl(t)}" target="_blank" rel="noopener">${esc(t)}</a>`).join(' → ');
    $('best').innerHTML = `Your route: ${route}`;
    if (s.gaveUp) {
      // a nudge for next time: some pages that are one step from Banana
      nearBanana().then(near => {
        const from = [...near].filter(t => /^(Ecuador|Costa Rica|Colombia|Panama|Fruit|Banana republic|Caribbean|Jamaica|Uganda|Potassium|Smoothie|Plantain)$/.test(t));
        $('best').innerHTML = `Your route: ${route}<br>Tip: pages like ${from.slice(0, 5).map(t => `<b>${esc(t)}</b>`).join(', ')} link straight to Banana.`;
      }).catch(() => {});
    }
    $('practiceBtn').textContent = mode === 'daily' ? 'Practice round' : 'Another round';
    if (mode === 'daily') fetch(`/api/degrees?day=${today}`).then(r => r.json()).then(showWorld).catch(() => {});
    else $('world').hidden = true;
  }

  function showWorld(w: { played: number; solved: number; steps: Record<string, number>; secs: number; best: number | null }) {
    if (!w || !w.played) return;
    $('world').hidden = false;
    const avg = w.solved ? Object.entries(w.steps).reduce((a, [k, n]) => a + +k * n, 0) / w.solved : 0;
    $('worldSummary').innerHTML = `<div><b>${w.played.toLocaleString('en-US')}</b><span>played</span></div><div><b>${Math.round((w.solved / w.played) * 100)}%</b><span>made it</span></div>` +
      (w.solved ? `<div><b>${avg.toFixed(1)}</b><span>avg steps</span></div><div><b>${w.best != null ? fmtTime(w.best) : '–'}</b><span>fastest</span></div>` : '');
    const max = Math.max(1, ...Object.values(w.steps));
    const mine = s.gaveUp ? -1 : Math.min(steps(), 10);
    const top = Math.max(6, mine, ...Object.keys(w.steps).map(Number));
    $('hist').innerHTML = Array.from({ length: top }, (_, i) => i + 1).map(k => {
      const n = w.steps[k] || 0;
      return `<div class="bar${k === mine ? ' me' : ''}"><span class="k">${k === 10 ? '10+' : k}${k === PAR ? ' <em>par</em>' : ''}</span><span class="track"><i style="width:${n ? Math.max(4, (n / max) * 100) : 0}%"></i></span><span class="n">${n}</span></div>`;
    }).join('');
  }

  function shareText() {
    const head = mode === 'daily' ? `🍌 Bananadle #${today}` : '🍌 Bananadle (practice)';
    const line = s.gaveUp ? `${start.t} → ❌ gave up` : `${start.t} → Banana in ${plural(steps(), 'step')} · ${golf(steps()).name} ${golf(steps()).emoji}`;
    const squares = s.gaveUp ? '' : '\n' + '🟨'.repeat(Math.max(0, steps() - 1)) + '🍌' + (s.misses ? ` ${'❌'.repeat(Math.min(s.misses, 8))}` : '') + (s.hints ? ` ${'💡'.repeat(Math.min(s.hints, 5))}` : '');
    return `${head}\n${line}${squares}\n⏱ ${fmtTime(s.secs)}\nhttps://allthingsbanana.com/bananadle/`;
  }

  async function share() {
    const text = shareText();
    try {
      if (navigator.share && matchMedia('(pointer: coarse)').matches) { await navigator.share({ text }); return; }
      await navigator.clipboard.writeText(text);
      $('shareBtn').textContent = 'Copied!';
      setTimeout(() => ($('shareBtn').textContent = 'Share result'), 2000);
    } catch {}
  }

  function renderStreak() {
    const hist = store.get<Record<number, { steps: number; solved: boolean; par: number }>>('atb-deg-history', {});
    let streak = 0;
    for (let d = hist[today]?.solved ? today : today - 1; hist[d]?.solved; d--) streak++;
    const all = Object.values(hist);
    $('streak').textContent = String(streak);
    $('played').textContent = String(all.length);
    $('pars').textContent = String(all.filter(h => h.solved && h.steps <= h.par).length);
  }

  // ---------- Banana Clicker leaderboard (small) ----------
  const regionName = new Intl.DisplayNames(['en'], { type: 'region' });
  const nameOf = (c: string) => (c === 'XX' ? 'Unknown' : (() => { try { return regionName.of(c) || c; } catch { return c; } })());
  const flag = (c: string) => (c === 'XX' ? '🏳️' : String.fromCodePoint(...[...c].map(ch => 127397 + ch.charCodeAt(0))));
  fetch('/api/peel').then(r => r.json()).then(d => {
    const rows = Object.entries(d.countries as Record<string, number>).sort((a, b) => b[1] - a[1]);
    if (!rows.length) return;
    $('peelList').innerHTML = rows.slice(0, 5).map(([c, n], i) => `<li class="${c === d.country ? 'you' : ''}"><span class="r">${i + 1}</span><span class="f">${flag(c)}</span><span class="nm">${esc(nameOf(c))}</span><b>${n.toLocaleString('en-US')}</b></li>`).join('');
    $('peelTotal').textContent = `${d.total.toLocaleString('en-US')} bananas peeled · play →`;
    $('peelCard').hidden = false;
  }).catch(() => {});

  // ---------- wiring ----------
  $('guessForm').addEventListener('submit', e => { e.preventDefault(); guess(input().value); });
  document.querySelector('.sd')!.addEventListener('click', e => {
    const b = (e.target as HTMLElement).closest('button');
    if (!b) return;
    if (b.classList.contains('sugg') && b.dataset.t) { input().value = b.dataset.t; guess(b.dataset.t); }
    else if (b.dataset.i && b.closest('#path')) rewind(+b.dataset.i);
  });
  $('hintBtn').addEventListener('click', hint);
  $('giveUpBtn').addEventListener('click', giveUp);
  $('shareBtn').addEventListener('click', share);
  $('helpBtn').addEventListener('click', showIntro);
  $('introOk').addEventListener('click', closeIntro);
  $('intro').addEventListener('click', e => { if (e.target === $('intro')) closeIntro(); });
  addEventListener('keydown', e => { if (e.key === 'Escape' && !$('intro').hidden) closeIntro(); });
  $('practiceBtn').addEventListener('click', () => { begin('practice'); scrollTo({ top: 0, behavior: 'smooth' }); });
  $('modeDaily').addEventListener('click', () => mode !== 'daily' && begin('daily'));
  $('modePractice').addEventListener('click', () => mode !== 'practice' && begin('practice'));
  // the clock only runs while you're playing and the page is visible
  setInterval(() => {
    if (!running || !s || s.done || document.hidden) return;
    s.secs++; $('sTime').textContent = fmtTime(s.secs);
    if (s.secs % 5 === 0) save();
  }, 1000);
  addEventListener('pagehide', () => s && save());

  begin('daily', true);
</script>

<style is:global>
