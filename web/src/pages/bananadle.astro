---
import Base from '../layouts/Base.astro';
import Bananadle from '../components/Bananadle.astro';
import PopularityChart from '../components/PopularityChart.astro';
---
<Base wide section="bananadle" title="Bananadle · the daily Wikipedia puzzle · All Things Banana"
      description="Bananadle, a daily puzzle: start on a Wikipedia page and get to Banana by naming pages each one links to or mentions, from memory. Par is 4. New crate every day.">
  <h1 class="sr-only">Bananadle: the daily Wikipedia puzzle</h1>
  <div class="bd-page">
    <div class="bd-main-col"><Bananadle variant="page" /></div>

    <aside class="bd-side">
      <section class="box">
        <div class="box-head"><h2>Your record</h2></div>
        <div class="record" data-bd-record></div>
      </section>

      <section class="box world" data-bd-world hidden>
        <div class="box-head"><h2>Everyone today</h2></div>
        <div class="world-sum" data-bd-world-sum></div>
        <div class="world-hist" data-bd-world-hist></div>
      </section>

      <a class="box league" href="/more/banana-clicker/" id="league" hidden>
        <div class="box-head"><h2>Clicker league</h2><span class="go">Peel →</span></div>
        <ol id="leagueList"></ol>
      </a>

      <PopularityChart />
    </aside>
  </div>
</Base>

<script>
  // the Banana Clicker's country table, small
  const esc = (s: string) => s.replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  const regionName = new Intl.DisplayNames(['en'], { type: 'region' });
  const nameOf = (c: string) => (c === 'XX' ? 'Somewhere' : (() => { try { return regionName.of(c) || c; } catch { return c; } })());
  const flag = (c: string) => (c === 'XX' ? '🏳️' : String.fromCodePoint(...[...c].map(ch => 127397 + ch.charCodeAt(0))));
  fetch('/api/peel').then(r => r.json()).then(d => {
    const rows = Object.entries(d.countries as Record<string, number>).sort((a, b) => b[1] - a[1]);
    if (!rows.length) return;
    document.getElementById('leagueList')!.innerHTML = rows.slice(0, 5).map(([c, n], i) =>
      `<li class="${c === d.country ? 'you' : ''}"><span class="r">${i + 1}</span><span aria-hidden="true">${flag(c)}</span><span class="nm">${esc(nameOf(c))}${c === d.country ? ' <em>you</em>' : ''}</span><b>${n.toLocaleString('en-US')}</b></li>`).join('');
    document.getElementById('league')!.hidden = false;
  }).catch(() => {});
</script>

<style>
  .bd-page { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 28px; align-items: start; padding-top: 34px; }
  .bd-side { display: flex; flex-direction: column; gap: 18px; }
  .record { display: grid; grid-template-columns: repeat(3, 1fr); text-align: center; padding: 12px 6px; }
  .record :global(b) { display: block; font: 400 28px/1.1 var(--display); }
  .record :global(span) { font-size: 13px; color: var(--ink-2); }
  .world-sum { display: grid; grid-template-columns: repeat(4, 1fr); text-align: center; padding: 10px 4px 4px; }
  .world-sum :global(b) { display: block; font: 400 20px/1.15 var(--display); }
  .world-sum :global(span) { font-size: 12.5px; color: var(--ink-2); }
  .world-hist { display: grid; gap: 4px; padding: 6px 14px 14px; }
  .world-hist :global(.bar) { display: grid; grid-template-columns: 48px 1fr 26px; align-items: center; gap: 8px; font-size: 13px; color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .world-hist :global(.k) { text-align: right; font-weight: 600; }
  .world-hist :global(.k em) { font-style: normal; font-size: 12px; color: var(--ink-3); }
  .world-hist :global(.track) { height: 16px; border: 2px solid var(--ink); border-radius: 999px; overflow: hidden; background: var(--paper); }
  .world-hist :global(i) { display: block; height: 100%; border-right: 2px solid var(--ink); }
  .world-hist :global(i[style*="width:0%"]) { border-right: 0; }
  .world-hist :global(.r1) { background: var(--r1); } .world-hist :global(.r2) { background: var(--r2); } .world-hist :global(.r3) { background: var(--r3); }
  .world-hist :global(.r4) { background: var(--r4); } .world-hist :global(.r5) { background: var(--r5); } .world-hist :global(.r6) { background: var(--r6); } .world-hist :global(.r7) { background: var(--r7); }
  .world-hist :global(.me) { color: var(--ink); font-weight: 700; }
  .league { display: block; text-decoration: none; color: var(--ink); }
  .league .go { font-weight: 700; font-size: var(--t-small); }
  .league:hover .go { text-decoration: underline; }
  .league ol { list-style: none; margin: 0; padding: 6px 14px 10px; }
  .league :global(li) { display: grid; grid-template-columns: 18px 26px minmax(0, 1fr) auto; align-items: center; gap: 4px; padding: 6px 0; border-bottom: 1px solid var(--line); font-size: 15px; }
  .league :global(li:last-child) { border-bottom: 0; }
  .league :global(.r) { color: var(--ink-3); font-weight: 700; font-size: 13px; }
  .league :global(.nm) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; }
  .league :global(.nm em) { font-style: normal; font-size: 12px; font-weight: 700; background: var(--banana); color: var(--on-banana); padding: 1px 6px; margin-left: 4px; }
  .league :global(b) { font-variant-numeric: tabular-nums; }
  @media (max-width: 900px) {
    .bd-page { grid-template-columns: 1fr; padding-top: 30px; }
  }
</style>
