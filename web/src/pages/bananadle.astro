  .sd-rules b { color: var(--p-ink); }
  .sd-eg { font-size: 13px; color: var(--p-ink-3); margin: 14px 0 18px; }
  .sd-wide { width: 100%; font-size: 17px; padding: 14px; }

  @media (max-width: 900px) {
    .sd-layout { grid-template-columns: 1fr; }
