---
import Base from '../layouts/Base.astro';
---
<Base wide section="home" title="All Things Banana · banana news, prices and games"
      description="Everything banana in one place: banana news as it happens, the global banana price and fruit markets, and banana games like the Banana Clicker and the Banana Cube.">
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'WebSite', name: 'All Things Banana', alternateName: 'allthingsbanana',
    url: 'https://allthingsbanana.com/', description: 'Banana news, banana prices, banana recipes and banana games.',
  })} />
  <div class="home">
    <!-- news: lead story, headlines, latest (columns appear only when there's something to put in them) -->
    <div class="news" id="news">
      <section class="lead" id="lead">
        <div class="sk-hero"></div>
        <div class="sk-item"><span></span><span></span></div>
      </section>
      <section class="mid" id="mid"></section>
      <section class="latest">
        <h2 class="col-h"><a href="/news/">Latest</a> <span class="upd" id="updated"></span></h2>
        <div id="latestList">{Array.from({ length: 6 }).map(() => <div class="sk-item"><span></span><span></span></div>)}</div>
        <a class="all-link" href="/news/">See all banana news →</a>
      </section>
      <section class="lab">
        <h2 class="col-h">Explore</h2>
        <div class="lab-grid">
          <a class="lab-card" id="rotd" href="/recipes/">
            <span class="lab-art recipe" aria-hidden="true">🍳</span>
            <span><span class="kicker">Recipe of the day</span><b>Banacipes</b><span class="lab-txt">Banana recipes for every meal.</span></span>
          </a>
          <a class="lab-card" href="/topics/banana-bread/">
            <span class="lab-art bread" aria-hidden="true">🍞</span>
            <span><span class="kicker">Topic</span><b>Everything banana bread</b><span class="lab-txt">History, the science of brown bananas and the internet's favourite recipes.</span></span>
          </a>
          <a class="lab-card" href="/more/banana-clicker/">
            <span class="lab-art clicker" aria-hidden="true">🍌</span>
            <span><span class="kicker">Game</span><b>Banana Clicker</b><span class="lab-txt">Peel bananas for your country and climb the world leaderboard.</span></span>
          </a>
          <a class="lab-card" href="/more/banana-cube/">
            <span class="lab-art cube" aria-hidden="true">🧩</span>
            <span><span class="kicker">Puzzle</span><b>Banana Cube solver</b><span class="lab-txt">Twist a 3D banana and see exactly how many moves from solved you are.</span></span>
          </a>
        </div>
      </section>
    </div>

    <!-- everything market- and number-related lives on the right -->
    <aside class="rail">
      <a class="card mkt" id="mkt" href="/bananalytics/" hidden>
        <div class="mkt-top">
          <div>
            <div class="mkt-name">Bananas <span>global benchmark</span></div>
            <div class="mkt-price"><b class="num" id="mPrice"></b> <span id="mUnit">/ tonne</span></div>
            <div class="num" id="mChg"></div>
          </div>
          <span class="mkt-asof" id="mAsOf"></span>
        </div>
        <div id="mChart" class="chart-box" style="height:130px"></div>
        <p class="mkt-story" id="mStory"></p>
      </a>

      <section class="card" id="trendCard" hidden>
        <h2><a href="/bananalytics/">Trending prices</a></h2>
        <div id="trend"></div>
      </section>

      <section class="card peel" id="peelCard">
        <div class="peel-head">
          <h2><a href="/more/banana-clicker/">Banana Clicker</a></h2>
          <span class="live"><i></i>live</span>
        </div>
        <p class="peel-total" id="peelTotal">Bananas peeled around the world</p>
        <ol class="peel-list" id="peelList"></ol>
        <a class="peel-btn" href="/more/banana-clicker/">🍌 Peel a banana for your country</a>
      </section>

      <section class="card" id="buzzCard" hidden>
        <h2>Banana buzz <span class="h-sub">stories per day</span></h2>
        <div id="buzz" class="chart-box" style="height:100px"></div>
      </section>

    </aside>
  </div>
</Base>

<script>
  import { lineChart, sparkline, barChart } from '../scripts/charts';
  import {
    getMarket, getFeed, lookup, allSeries, money, signed, num, lastChange, sliceYears, label,
    fmtDate, monthOnly, shortDate, marketLink, esc, ago, type Market, type Feed, type Item,
  } from '../scripts/market';
  import { BUSINESS, chips, meta, link, buzzDays, tickTimes } from '../scripts/news';

  const $ = (s: string) => document.querySelector(s) as HTMLElement;
  let market: Market | null = null, feedCache: Feed | null = null;

  // ---------- news ----------
  const img = (it: Item, cls: string) =>
    `<a class="${cls}" href="${esc(it.url)}" target="_blank" rel="noopener nofollow" tabindex="-1"><img src="${esc(it.thumb!)}" alt="" loading="lazy" onerror="this.closest('a').remove()"></a>`;

  function renderNews(f: Feed) {
    feedCache = f;
    const items = f.items;
    $('#updated').textContent = items.length ? `· updated ${ago(f.updated)}` : '';
    if (!items.length) {
      $('#lead').innerHTML = '<p class="empty">Collecting the first banana news… check back in a minute.</p>';
      $('#latestList').innerHTML = '';
      $('#news').classList.add('no-mid');
      return;
    }
    // Give the pictures to the lead column, then share the rest out. No column gets an empty box.
    const pics = items.filter(i => i.thumb);
    const used = new Set<string>();
    const take = (it?: Item) => { if (it) used.add(it.id); return it; };
    const hero = take(pics[0]) || take(items[0])!;
    const cards = pics.slice(1, 3).map(i => take(i)!);
    const midPic = take(pics[3]);
    const rest = items.filter(i => !used.has(i.id));
    const latest = rest.slice(0, 9);
    const after = rest.slice(9);
    const mid = (midPic ? [midPic] : []).concat((after.filter(i => BUSINESS.test(i.title)).length >= 3 ? after.filter(i => BUSINESS.test(i.title)) : after).slice(0, 6));

    $('#lead').innerHTML = `
      <article class="hero">
        ${hero.thumb ? img(hero, 'hero-img') : ''}
        <div class="hero-txt ${hero.thumb ? '' : 'plain'}">
          <h1>${link(hero)}</h1>${meta(hero)}${chips(market, hero.title)}
        </div>
      </article>
      ${cards.length ? `<div class="cards cards-${cards.length}">${cards.map(c => `<article class="card-story">${img(c, 'c-img')}${link(c)}${meta(c)}</article>`).join('')}</div>` : ''}`;

    $('#mid').innerHTML = mid.length
      ? `<h2 class="col-h">Banana business</h2>` + mid.map((it, i) => `<article class="m-item">${i === 0 && it.thumb ? img(it, 'm-img') : ''}${link(it)}${meta(it)}${chips(market, it.title)}</article>`).join('')
      : '';
    $('#news').classList.toggle('no-mid', !mid.length);
    $('#latestList').innerHTML = latest.map(it => `<article class="l-item">${link(it)}${meta(it)}${chips(market, it.title)}</article>`).join('')
      || '<p class="empty">More stories on the way.</p>';

    $('#buzzCard').hidden = items.length < 5;
    if (items.length >= 5) barChart($('#buzz'), buzzDays(items), 100);
  }

  // ---------- markets (right rail) ----------
  function renderMarkets() {
    const g = lookup(market, 'PBANSOP');
    if (g) {
      const last = g.pts[g.pts.length - 1], prev = g.pts[g.pts.length - 2], p = lastChange(g.pts) ?? 0;
      $('#mkt').hidden = false;
      $('#mkt').setAttribute('href', marketLink('PBANSOP'));
      $('#mPrice').textContent = money(g, last.y);
      $('#mChg').innerHTML = `<span class="${p >= 0 ? 'up' : 'down'}">${signed(last.y - prev.y, g.dec)} (${signed(p)}%)</span>`;
      $('#mAsOf').textContent = shortDate(last.x);
      $('#mStory').textContent = Math.abs(p) <= 0.5
        ? `Banana prices held steady in ${monthOnly(last.x)}.`
        : `Banana prices ${p > 0 ? 'rose' : 'fell'} ${num(Math.abs(p), 1)}% in ${monthOnly(last.x)}. See the full chart →`;
      const box = $('#mChart');
      box.innerHTML = '';
      lineChart(box, sliceYears(g.pts, 3), {
        height: 130, color: 'var(--brand)', label: 'Global banana price, last 3 years',
        fmt: v => `${money(g, v)} / tonne`, axisFmt: v => money(g, v, 0), dateFmt: x => fmtDate(x),
      });
    }
    const rows = allSeries(market).filter(s => s.code !== 'PBANSOP').slice(0, 8);
    $('#trendCard').hidden = !rows.length;
    $('#trend').innerHTML = rows.map(s => {
      const pts = s.pts, last = pts[pts.length - 1], p = lastChange(pts) ?? 0;
      return `<a class="tr" href="${marketLink(s.code)}">
        <span class="tr-n"><b>${esc(s.kind === 'US shop price' ? 'US ' + s.name : label(s))}</b><span>${esc(s.desc)}</span></span>
        ${sparkline(pts.slice(s.daily ? -40 : -12).map(q => q.y), 50, 22)}
        <span class="tr-v num"><b>${money(s, last.y)}</b><span class="${p >= 0 ? 'up' : 'down'}">${signed(p)}%</span></span>
      </a>`;
    }).join('');
  }

  // ---------- Banana Clicker leaderboard ----------
  const regionName = new Intl.DisplayNames(['en'], { type: 'region' });
  const nameOf = (c: string) => (c === 'XX' ? 'Unknown' : (() => { try { return regionName.of(c) || c; } catch { return c; } })());
  const flag = (c: string) => (c === 'XX' ? '🏳️' : String.fromCodePoint(...[...c].map(ch => 127397 + ch.charCodeAt(0))));
  async function renderPeels() {
    try {
      const d = await (await fetch('/api/peel')).json();
      const rows = Object.entries(d.countries as Record<string, number>).sort((a, b) => b[1] - a[1]);
      $('#peelTotal').innerHTML = d.total
        ? `<b class="num">${num(d.total, 0)}</b> bananas peeled in ${rows.length} ${rows.length === 1 ? 'country' : 'countries'}`
        : 'No bananas peeled yet. Be the first!';
      const top = rows.slice(0, 5);
      if (d.country && !top.some(([c]) => c === d.country) && d.countries[d.country]) top.push([d.country, d.countries[d.country]]);
      const max = top[0]?.[1] || 1;
      $('#peelList').innerHTML = top.map(([c, n]) => `<li class="${c === d.country ? 'you' : ''}">
        <span class="rank num">${rows.findIndex(r => r[0] === c) + 1}</span><span>${flag(c)}</span>
        <span class="nm">${nameOf(c)}${c === d.country ? ' <em>you</em>' : ''}</span><b class="num">${num(n, 0)}</b>
        <i style="width:${Math.max(3, (n / max) * 100)}%"></i></li>`).join('');
    } catch {
      $('#peelCard').hidden = true;
    }
  }

  // recipe of the day: the same one all day for everyone, a new one tomorrow
  try {
    const idx = JSON.parse(document.getElementById('recipe-index')!.textContent || '[]');
    if (idx.length) {
      const d = new Date(), day = Math.floor(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()) / 864e5);
      const r = idx[(day * 7919) % idx.length], el = $('#rotd');
      el.setAttribute('href', `/recipes/${r.s}/`);
      el.querySelector('.lab-art')!.textContent = r.e;
      el.querySelector('b')!.textContent = r.n;
      el.querySelector('.lab-txt')!.textContent = r.b;
    }
  } catch {}

  getMarket().then(m => {
    market = m;
    renderMarkets();
    if (feedCache) renderNews(feedCache);   // add price chips now that prices are here
  }).catch(() => {});
  getFeed().then(renderNews).catch(() => { $('#lead').innerHTML = '<p class="empty">Couldn’t load the news. We’ll keep trying.</p>'; });
  renderPeels();
  setInterval(() => getFeed(true).then(renderNews).catch(() => {}), 60_000);
  setInterval(renderPeels, 15_000);
  tickTimes();
</script>

<style>
  .home { display: grid; grid-template-columns: minmax(0, 1fr) 330px; gap: 32px; padding-top: 22px; align-items: start; }
  .news { display: grid; grid-template-columns: minmax(0, 1.9fr) minmax(0, 1fr) minmax(0, 1fr); gap: 0 24px; align-items: start; min-width: 0; }
  .news.no-mid { grid-template-columns: minmax(0, 1.9fr) minmax(0, 1.1fr); }
  .news.no-mid .mid { display: none; }
  .mid:not(:empty), .latest { border-left: 1px solid var(--border); padding-left: 22px; min-height: 100%; }
  .lead, .mid, .latest { min-width: 0; }
  .col-h, .home :global(.col-h) { font-size: 17px; font-weight: 800; margin: 0 0 12px; }
  .col-h a, .card h2 a { text-decoration: none; }
  .col-h a:hover, .card h2 a:hover { text-decoration: underline; }
  .upd { font-size: 12px; font-weight: 500; color: var(--ink-3); }
  .empty { color: var(--ink-3); font-size: 14px; }
  .all-link { display: inline-block; margin-top: 12px; color: var(--link); font-weight: 600; font-size: 13.5px; text-decoration: none; }
  .all-link:hover { text-decoration: underline; }

  /* shared story bits */
  .home :global(.meta) { font-size: 12px; color: var(--ink-3); margin-top: 5px; font-weight: 500; }
  .home :global(.vid) { color: var(--down); font-weight: 700; }
  .home :global(.hl) { text-decoration: none; font-weight: 700; font-size: 15.5px; line-height: 1.3; display: block; }
  .home :global(.hl:hover) { text-decoration: underline; }
  .home :global(.chips) { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 7px; }
  .home :global(.chip) { font-size: 11.5px; font-weight: 700; text-decoration: none; color: var(--link); border: 1px solid var(--border); border-radius: 999px; padding: 2px 9px; white-space: nowrap; }
  .home :global(.chip:hover) { border-color: var(--link); }
  .home :global(.chip span) { font-weight: 600; margin-left: 3px; }
  .home :global(img) { display: block; width: 100%; object-fit: cover; background: var(--chip); }

  /* lead */
  .lead :global(.hero-img img) { aspect-ratio: 16 / 9; border-radius: 10px; }
  .lead :global(.hero-txt) { text-align: center; padding: 16px 8px 0; }
  .lead :global(.hero-txt h1) { margin: 0; }
  .lead :global(.hero-txt .hl) { font-size: 30px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.18; }
  .lead :global(.hero-txt.plain) { text-align: left; padding: 0; }
  .lead :global(.hero-txt.plain .hl) { font-size: 34px; }
  .lead :global(.hero-txt .chips) { justify-content: center; }
  .lead :global(.hero-txt.plain .chips) { justify-content: flex-start; }
  .lead :global(.cards) { display: grid; gap: 20px; margin-top: 22px; padding-top: 20px; border-top: 1px solid var(--border); }
  .lead :global(.cards-2) { grid-template-columns: 1fr 1fr; }
  /* a lone card sits side by side, so a quiet news day doesn't leave a giant picture */
  .lead :global(.cards-1 .card-story) { display: grid; grid-template-columns: 42% 1fr; gap: 0 16px; align-items: start; }
  .lead :global(.cards-1 .c-img) { grid-row: 1 / span 3; }
  .lead :global(.cards-1 .c-img img) { margin-bottom: 0; }
  .lead :global(.c-img img) { aspect-ratio: 16 / 9; border-radius: 8px; margin-bottom: 9px; }
  .lead :global(.card-story .hl) { font-size: 16px; }

  /* middle and latest columns */
  .home :global(.m-item), .home :global(.l-item) { padding: 12px 0; border-bottom: 1px solid var(--border); }
  .home :global(.m-item:first-of-type), .home :global(.l-item:first-child) { padding-top: 0; }
  .home :global(.m-img img) { aspect-ratio: 16 / 9; border-radius: 8px; margin-bottom: 9px; }
  .latest :global(.hl) { font-weight: 600; font-size: 15px; }
  .sk-hero { aspect-ratio: 16 / 9; border-radius: 10px; background: var(--chip); margin-bottom: 14px; }
  .sk-item { padding: 12px 0; border-bottom: 1px solid var(--border); display: flex; flex-direction: column; gap: 7px; }
  .sk-item span { display: block; height: 11px; border-radius: 4px; background: var(--chip); width: 90%; }
  .sk-item span:last-child { width: 40%; height: 9px; }

  /* More Bananas row, under the news */
  .lab { grid-column: 1 / -1; margin-top: 28px; padding-top: 18px; border-top: 1px solid var(--border); }
  .lab-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px; }
  .lab-card { display: flex; gap: 14px; align-items: center; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 14px; text-decoration: none; transition: border-color .15s; }
  .lab-card:hover { border-color: var(--brand); }
  .lab-art { flex: none; width: 64px; height: 64px; border-radius: 12px; display: grid; place-items: center; font-size: 34px; }
  .lab-art.clicker { background: radial-gradient(circle at 30% 30%, #5a4812, #1f190a); }
  .lab-art.bread { background: radial-gradient(circle at 30% 30%, #6b4f12, #2a1f08); }
  .lab-art.recipe { background: radial-gradient(circle at 30% 30%, #6a2b54, #260f1f); }
  .lab-art.cube { background: radial-gradient(circle at 30% 30%, #24405e, #111a25); }
  .lab-card b { display: block; font-size: 15.5px; margin: 1px 0 2px; }
  .lab-txt { display: block; font-size: 13px; color: var(--ink-2); }
  .kicker { display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; color: var(--brand); }

  /* right rail */
  .rail { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 14px; }
  .card h2 { font-size: 15.5px; font-weight: 800; margin: 0 0 8px; }
  .h-sub { color: var(--ink-3); font-size: 12px; font-weight: 500; }
  .mkt { display: block; text-decoration: none; }
  .mkt:hover { border-color: var(--ink-3); }
  .mkt-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 6px; }
  .mkt-name { font-size: 12.5px; font-weight: 700; color: var(--link); text-transform: uppercase; letter-spacing: .02em; }
  .mkt-name span { color: var(--ink-3); text-transform: none; letter-spacing: 0; font-weight: 500; }
  .mkt-price b { font-size: 26px; font-weight: 800; letter-spacing: -0.02em; }
  .mkt-price span { color: var(--ink-3); font-size: 12.5px; }
  #mChg { font-size: 13px; font-weight: 600; }
  .mkt-asof { font-size: 11.5px; color: var(--ink-3); }
  .mkt-story { margin: 8px 0 0; font-size: 13px; color: var(--ink-2); }
  .rail :global(.tr) { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; gap: 10px; align-items: center; padding: 7px 0; border-top: 1px solid var(--border); text-decoration: none; }
  .rail :global(.tr:first-child) { border-top: none; }
  .rail :global(.tr-n) { min-width: 0; }
  .rail :global(.tr-n b) { display: block; font-size: 12px; color: var(--link); text-transform: uppercase; letter-spacing: .02em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rail :global(.tr-n span) { display: block; font-size: 11.5px; color: var(--ink-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rail :global(.tr-v) { text-align: right; font-size: 12.5px; }
  .rail :global(.tr-v b) { display: block; font-weight: 600; }
  .rail :global(.tr-v span) { font-size: 11.5px; font-weight: 600; }
  .rail :global(.tr:hover .tr-n b) { text-decoration: underline; }

  .peel-head { display: flex; justify-content: space-between; align-items: baseline; }
  .live { font-size: 12px; font-weight: 600; color: var(--ink-3); display: flex; align-items: center; gap: 6px; }
  .live i { width: 7px; height: 7px; border-radius: 50%; background: var(--up); animation: pulse 2s infinite; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--up) 55%, transparent); } 70% { box-shadow: 0 0 0 6px transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }
  .peel-total { margin: 0 0 8px; font-size: 13px; color: var(--ink-2); }
  .peel-total :global(b) { color: var(--brand); font-size: 15px; }
  .peel-list { list-style: none; margin: 0; padding: 0; }
  .peel-list :global(li) { position: relative; display: grid; grid-template-columns: 18px 22px minmax(0, 1fr) auto; gap: 6px; align-items: center; padding: 6px 4px 8px; font-size: 13.5px; border-radius: 6px; }
  .peel-list :global(.rank) { color: var(--ink-3); font-size: 11.5px; font-weight: 700; }
  .peel-list :global(.nm) { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: 600; }
  .peel-list :global(em) { font-style: normal; font-size: 10px; font-weight: 800; text-transform: uppercase; color: #1d1600; background: var(--brand); border-radius: 4px; padding: 0 4px; margin-left: 4px; }
  .peel-list :global(i) { position: absolute; left: 4px; bottom: 2px; height: 3px; border-radius: 2px; background: var(--brand); opacity: .5; max-width: calc(100% - 8px); }
  .peel-list :global(li.you) { background: color-mix(in srgb, var(--brand) 10%, transparent); }
  .peel-btn { display: block; margin-top: 10px; text-align: center; background: var(--brand); color: #1d1600; font-weight: 800; font-size: 13.5px; text-decoration: none; border-radius: 999px; padding: 9px 12px; }
  .peel-btn:hover { filter: brightness(1.06); }

  .promo { display: flex; gap: 12px; align-items: center; text-decoration: none; }
  .promo:hover { border-color: var(--ink-3); }
  .promo-art { font-size: 26px; }
  .promo b { display: block; font-size: 14px; }
  .promo span span { display: block; font-size: 12.5px; color: var(--ink-2); }

  @media (max-width: 1100px) {
    .news { grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); }
    .news .mid { display: none; }
  }
  @media (max-width: 960px) {
    .home { grid-template-columns: 1fr; }
  }
  @media (max-width: 700px) {
    .news, .news.no-mid { grid-template-columns: 1fr; }
    .latest { border-left: none; padding-left: 0; margin-top: 24px; }
    .lab { grid-column: auto; }
    .lead :global(.hero-txt .hl) { font-size: 24px; }
    .lead :global(.hero-txt.plain .hl) { font-size: 26px; }
  }
  @media (max-width: 480px) {
    .lead :global(.cards-2) { grid-template-columns: 1fr; }
  }
</style>
