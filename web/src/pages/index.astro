---
import Base from '../layouts/Base.astro';
import Bananadle from '../components/Bananadle.astro';
---
<Base wide section="home" title="All Things Banana · a daily banana puzzle, prices, recipes and a world league"
      description="Play today's Bananadle (Wikipedia page to Wikipedia page, all the way to Banana), peel for your country in the Banana Clicker league, and find banana recipes, prices and news.">
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'WebSite', name: 'All Things Banana', alternateName: 'allthingsbanana',
    url: 'https://allthingsbanana.com/', description: 'A daily banana puzzle, banana prices, recipes, news and games.',
  })} />
  <h1 class="sr-only">All Things Banana</h1>

  <div class="home">
    <div class="h-main">
      <!-- 1. today's puzzle, playable straight away -->
      <Bananadle variant="home" />

      <!-- 2. news, with pictures -->
      <section class="news" aria-labelledby="newsH">
        <div class="sec-head"><h2 id="newsH" data-banana="Fresh bananananana news">Fresh banana news</h2><a href="/news/">All news →</a></div>
        <div class="news-grid" id="newsGrid">
          <div class="sk sk-lead"></div>
          <div class="side-stories">{Array.from({ length: 3 }).map(() => <div class="sk sk-small"></div>)}</div>
        </div>
        <ul class="news-list" id="newsList"></ul>
      </section>

      <!-- 6. everything else, briefly -->
      <nav class="explore" aria-label="More on the site">
        <a href="/bananalytics/world/"><b>Banana World</b><span>Where 139 million tonnes a year grow, on a map</span></a>
        <a href="/topics/banana-bread/"><b>Banana bread</b><span>Its history, the science, the best recipes</span></a>
        <a href="/more/banana-cube/"><b>Banana Cube</b><span>A 3D puzzle solver</span></a>
        <a href="/recipes/"><b>All recipes</b><span>90 of ours, 5,203 from elsewhere</span></a>
      </nav>
    </div>

    <aside class="rail">
      <!-- 3. the clicker league -->
      <a class="card mint" href="/more/banana-clicker/" id="league">
        <span class="kicker"><i class="dot d-mint"></i>Clicker league</span>
        <h2 id="leagueLine">Bananas peeled, by country</h2>
        <ol class="league" id="leagueList"></ol>
        <span class="peel" id="peelBtn" data-banana="PEEL!!">Peel for your country</span>
      </a>

      <!-- 4. the banana price -->
      <a class="card sky" href="/bananalytics/" id="board" hidden>
        <span class="kicker"><i class="dot d-sky"></i>Banana price</span>
        <div class="price"><b id="bPrice"></b> <small>/ tonne</small></div>
        <p id="bChg"></p>
        <span id="bChart" class="spark-box"></span>
        <span class="more">All prices and the map →</span>
      </a>

      <!-- 5. recipe of the day -->
      <a class="card peach" href="/recipes/" id="rotd">
        <span class="kicker"><i class="dot d-peach"></i>Recipe of the day</span>
        <div class="rotd"><span class="rotd-img" id="rotdImg"></span><div><h2 id="rotdName">Banana recipes</h2><p id="rotdMeta">Breakfast to cocktails.</p></div></div>
      </a>
    </aside>
  </div>
</Base>

<script>
  import { sparkline } from '../scripts/charts';
  import { getMarket, getFeed, lookup, money, num, lastChange, monthOnly, esc, ago, type Market, type Feed, type Item } from '../scripts/market';
  import { tickTimes } from '../scripts/news';

  const $ = (s: string) => document.querySelector(s) as HTMLElement;
  const every = (ms: number, fn: () => void) => setInterval(() => { if (!document.hidden) fn(); }, ms);   // no refreshes in background tabs
  const time = (it: Item) => `<time datetime="${new Date(it.published).toISOString()}">${ago(it.published)}</time>`;
  const pic = (it: Item, cls: string) => `<img class="${cls}" src="${esc(it.thumb!)}" alt="" loading="lazy" decoding="async" onerror="this.remove()">`;

  // ---------- news: a lead story with a picture, three with thumbnails, then headlines ----------
  function renderNews(f: Feed) {
    const items = f.items;
    if (!items.length) { $('#newsGrid').innerHTML = '<p class="empty">The banana wires are quiet. Check back in a minute.</p>'; return; }
    const withPic = items.filter(i => i.thumb), used = new Set<string>();
    const lead = withPic[0] || items[0]; used.add(lead.id);
    const smalls = items.filter(i => !used.has(i.id) && i.thumb).slice(0, 3); smalls.forEach(i => used.add(i.id));
    const rest = items.filter(i => !used.has(i.id)).slice(0, 3);
    $('#newsGrid').innerHTML = `
      <a class="story" href="${esc(lead.url)}" target="_blank" rel="noopener nofollow">${lead.thumb ? pic(lead, 'story-img') : ''}<h3>${esc(lead.title)}</h3><span class="src">${esc(lead.source)} · ${time(lead)}</span></a>
      <div class="side-stories">${smalls.map(it => `<a class="small" href="${esc(it.url)}" target="_blank" rel="noopener nofollow">${pic(it, 'small-img')}<div><h3>${esc(it.title)}</h3><span class="src">${esc(it.source)} · ${time(it)}</span></div></a>`).join('')}</div>`;
    $('#newsList').innerHTML = rest.map(it => `<li><a href="${esc(it.url)}" target="_blank" rel="noopener nofollow">${esc(it.title)}</a><span>${esc(it.source)} · ${time(it)}</span></li>`).join('');
  }

  // ---------- the banana price ----------
  function renderPrice(m: Market) {
    const g = lookup(m, 'PBANSOP');
    if (!g) return;
    const last = g.pts[g.pts.length - 1], p = lastChange(g.pts) ?? 0;
    $('#board').hidden = false;
    $('#bPrice').textContent = money(g, last.y, 0);
    $('#bChg').innerHTML = `<span class="${p >= 0 ? 'up' : 'down'}">${p >= 0 ? '▲' : '▼'} ${num(Math.abs(p), 1)}%</span> in ${monthOnly(last.x)}. ${Math.abs(p) <= 0.5 ? 'Steady.' : p > 0 ? 'Slightly dearer.' : 'Slightly cheaper.'}`;
    $('#bChart').innerHTML = sparkline(g.pts.slice(-36).map(q => q.y), 300, 50);
  }

  // ---------- the clicker league: where your country stands ----------
  const regionName = new Intl.DisplayNames(['en'], { type: 'region' });
  const nameOf = (c: string) => (c === 'XX' ? 'Somewhere' : (() => { try { return regionName.of(c) || c; } catch { return c; } })());
  const short = (c: string) => ({ GB: 'the UK', US: 'the US' } as Record<string, string>)[c] || nameOf(c);
  const flag = (c: string) => (c === 'XX' ? '🏳️' : String.fromCodePoint(...[...c].map(ch => 127397 + ch.charCodeAt(0))));
  async function renderLeague() {
    try {
      const d = await (await fetch('/api/peel')).json();
      const rows = Object.entries(d.countries as Record<string, number>).sort((a, b) => b[1] - a[1]);
      const me = rows.findIndex(r => r[0] === d.country);
      const top = rows.slice(0, 4);
      if (me >= 4) top.push(rows[me]);
      $('#leagueList').innerHTML = top.map(([c, n]) => `<li class="${c === d.country ? 'you' : ''}"><span class="r">${rows.findIndex(r => r[0] === c) + 1}</span><span aria-hidden="true">${flag(c)}</span><span class="nm">${esc(nameOf(c))}</span><b>${num(n, 0)}</b></li>`).join('')
        || '<li class="none">Nobody has peeled a banana yet. Be first.</li>';
      const mine = d.country && d.country !== 'XX' ? d.country : null;
      let line = `${num(d.total || 0, 0)} bananas peeled so far`;
      if (mine && me === 0 && rows[1]) line = `${nameOf(mine)} leads. ${nameOf(rows[1][0])} is ${num(rows[0][1] - rows[1][1], 0)} behind.`;
      else if (mine && me === 0) line = `${nameOf(mine)} leads, unopposed. For now.`;
      else if (mine && me > 0) line = `${nameOf(mine)} is #${me + 1}, ${num(rows[me - 1][1] - rows[me][1] + 1, 0)} from passing ${nameOf(rows[me - 1][0])}.`;
      else if (mine) line = `${nameOf(mine)} hasn't peeled a single banana. Yet.`;
      $('#leagueLine').textContent = line;
      if (mine && !document.documentElement.matches('[data-theme="banana"]')) $('#peelBtn').textContent = `Peel for ${short(mine)}`;
    } catch { $('#league').hidden = true; }
  }

  // ---------- recipe of the day: the same one all day for everyone ----------
  try {
    const idx = JSON.parse(document.getElementById('recipe-index')!.textContent || '[]');
    if (idx.length) {
      const d = new Date(), day = Math.floor(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()) / 864e5);
      const r = idx[(day * 7919) % idx.length];
      $('#rotd').setAttribute('href', `/recipes/${r.s}/`);
      $('#rotdName').textContent = r.n;
      $('#rotdMeta').textContent = `${r.m} · ${r.o}`;
      if (r.p) $('#rotdImg').innerHTML = `<img src="${r.p}" alt="" loading="lazy" width="96" height="96">`;
    }
  } catch {}

  getMarket().then(renderPrice).catch(() => {});
  getFeed().then(renderNews).catch(() => { $('#newsGrid').innerHTML = '<p class="empty">Couldn’t reach the news. Trying again shortly.</p>'; });
  renderLeague();
  every(60_000, () => getFeed(true).then(renderNews).catch(() => {}));
  every(30_000, renderLeague);
  tickTimes();
</script>

<style>
  .home { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 28px; padding-top: 28px; align-items: start; }
  .h-main { display: flex; flex-direction: column; gap: 32px; min-width: 0; }
  .rail { display: flex; flex-direction: column; gap: 18px; position: sticky; top: 18px; }

  /* news */
  .sec-head { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; margin-bottom: 14px; }
  .sec-head h2 { font-size: 27px; margin: 0; }
  .sec-head a { font-weight: 700; text-underline-offset: 3px; }
  .news-grid { display: grid; grid-template-columns: 1.35fr 1fr; gap: 22px; }
  .news-grid :global(.story) { text-decoration: none; display: flex; flex-direction: column; gap: 8px; }
  .news-grid :global(.story-img) { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: var(--r-lg); display: block; background: var(--line); }
  .news-grid :global(.story h3) { font: 600 22px/1.25 var(--display); margin: 0; }
  .news-grid :global(.story:hover h3), .news-grid :global(.small:hover h3) { text-decoration: underline; text-decoration-color: var(--butter-d); text-decoration-thickness: 3px; }
  .news-grid :global(.src) { font-size: 14.5px; color: var(--ink-2); }
  .news-grid :global(.side-stories) { display: flex; flex-direction: column; gap: 16px; }
  .news-grid :global(.small) { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 14px; text-decoration: none; align-items: start; }
  .news-grid :global(.small-img) { width: 112px; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--r-md); display: block; background: var(--line); }
  .news-grid :global(.small h3) { font: 700 16.5px/1.35 var(--text); margin: 0; }
  .news-grid :global(.small .src) { display: block; margin-top: 3px; font-size: 14px; }
  .news-grid .sk { background: var(--paper-2); border-radius: var(--r-lg); }
  .sk-lead { aspect-ratio: 16 / 12; }
  .side-stories .sk-small { height: 84px; }
  .news-grid :global(.empty) { color: var(--ink-2); }
  .news-list { list-style: none; margin: 18px 0 0; padding: 0; border-top: 1px solid var(--line); }
  .news-list :global(li) { padding: 12px 0; border-bottom: 1px solid var(--line); display: flex; justify-content: space-between; gap: 16px; }
  .news-list :global(a) { text-decoration: none; font-weight: 700; }
  .news-list :global(a:hover) { text-decoration: underline; text-decoration-color: var(--butter-d); }
  .news-list :global(span) { color: var(--ink-2); font-size: 14.5px; white-space: nowrap; }

  /* rail cards */
  .card { border-radius: var(--r-lg); padding: 18px 20px; display: flex; flex-direction: column; gap: 8px; text-decoration: none; color: var(--ink); transition: transform .2s; }
  .card:hover { transform: translateY(-2px); }
  .card.mint { background: var(--mint); } .card.sky { background: var(--sky); } .card.peach { background: var(--peach); }
  .kicker { display: flex; align-items: center; gap: 8px; font-weight: 800; font-size: 14px; }
  .card h2 { font-size: 21px; margin: 0; }
  .card p { margin: 0; color: var(--ink-2); font-size: 15.5px; }
  .card .more { font-weight: 700; font-size: 15px; }
  .league { list-style: none; margin: 2px 0 0; padding: 0; display: grid; gap: 5px; }
  .league :global(li) { display: grid; grid-template-columns: 18px auto minmax(0, 1fr) auto; gap: 8px; align-items: center; font-weight: 700; font-size: 15.5px; padding: 7px 10px; border-radius: var(--r-sm); background: rgba(255, 255, 255, .7); }
  :global(:root[data-theme="dark"]) .league :global(li) { background: rgba(255, 255, 255, .05); }
  .league :global(.r) { color: var(--ink-2); font-size: 13.5px; }
  .league :global(.nm) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .league :global(b) { font-variant-numeric: tabular-nums; }
  .league :global(li.you) { box-shadow: inset 0 0 0 2px var(--mint-d); }
  .league :global(.none) { display: block; }
  .peel { align-self: flex-start; margin-top: 4px; padding: 11px 16px; border-radius: var(--r-md); background: var(--ink); color: var(--paper); font-weight: 800; font-size: 15.5px; }
  .price b { font: 600 34px/1 var(--display); }
  .price small { font-size: 15px; color: var(--ink-2); font-weight: 700; }
  .spark-box :global(svg) { width: 100%; height: 50px; }
  .spark-box :global(path) { stroke: var(--banana-ink) !important; stroke-width: 2.5; }
  .rotd { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 12px; align-items: center; }
  .rotd-img { width: 96px; height: 96px; border-radius: var(--r-md); overflow: hidden; background: rgba(255, 255, 255, .5); }
  .rotd-img :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .rotd h2 { font-size: 19px; }

  .explore { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  .explore a { text-decoration: none; padding: 16px 18px; border-radius: var(--r-lg); background: var(--card); box-shadow: var(--shadow); display: flex; flex-direction: column; gap: 2px; min-height: 44px; }
  .explore b { font: 600 18px var(--display); }
  .explore span { color: var(--ink-2); font-size: 15px; }
  .explore a:hover b { text-decoration: underline; text-decoration-color: var(--butter-d); }
  :global(:root[data-theme="banana"]) .explore a { border: 2px solid #3A2A0E; box-shadow: 4px 4px 0 #3A2A0E; }

  @media (max-width: 960px) {
    /* one column: puzzle, clicker league, news, price, recipe, more */
    .home { display: flex; flex-direction: column; gap: 24px; align-items: stretch; padding-top: 20px; }
    .h-main, .rail { display: contents; }
    .h-main > :global(.bd) { order: 1; } #league { order: 2; } .news { order: 3; } #board { order: 4; } #rotd { order: 5; } .explore { order: 6; }
    .news-grid { grid-template-columns: minmax(0, 1fr); }
    .explore { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .news-list :global(li) { flex-direction: column; gap: 0; }
    .news-grid :global(.small) { grid-template-columns: 96px minmax(0, 1fr); }
    .news-grid :global(.small-img) { width: 96px; }
  }
</style>
