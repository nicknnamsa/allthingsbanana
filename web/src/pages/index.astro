---
import Base from '../layouts/Base.astro';
import Bananadle from '../components/Bananadle.astro';
---
<Base wide section="home" ticker title="All Things Banana · a daily banana puzzle, prices, recipes and a world league"
      description="Play today's Bananadle, peel for your country in the Banana Clicker league, and check banana prices, recipes and news. A serious website about bananas.">
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'WebSite', name: 'All Things Banana', alternateName: 'allthingsbanana',
    url: 'https://allthingsbanana.com/', description: 'A daily banana puzzle, banana prices, recipes, news and games.',
  })} />
  <h1 class="sr-only">All Things Banana</h1>

  <div class="home">
    <!-- 1. today's puzzle, playable straight away -->
    <div class="h-puzzle"><Bananadle variant="home" /></div>

    <aside class="h-side">
      <!-- 2. the clicker league: where your country stands -->
      <section class="box league" id="league">
        <div class="box-head"><h2>Clicker league</h2><span class="live"><i></i>live</span></div>
        <p class="league-line" id="leagueLine">Bananas peeled, by country.</p>
        <ol class="league-list" id="leagueList"></ol>
        <a class="btn banana league-btn" href="/more/banana-clicker/" id="peelBtn">Peel for your country</a>
      </section>

      <!-- 3. the market board -->
      <section class="box board" id="board" hidden>
        <div class="box-head"><h2>Market board</h2><a href="/bananalytics/">Prices &amp; map →</a></div>
        <a class="board-main" id="bMain" href="/bananalytics/">
          <span class="label">Bananas, world price</span>
          <span class="board-big"><b id="bPrice"></b> <span id="bUnit">/ tonne</span></span>
          <span id="bChg" class="board-chg"></span>
          <span id="bChart" class="board-chart"></span>
          <span class="board-note" id="bNote"></span>
        </a>
        <div class="board-rows" id="bRows"></div>
      </section>
    </aside>

    <!-- 4. recipe of the day -->
    <a class="box rotd" id="rotd" href="/recipes/">
      <span class="rotd-img" id="rotdImg"></span>
      <span class="rotd-txt">
        <span class="label">Recipe of the day</span>
        <b id="rotdName">Banana recipes</b>
        <span id="rotdBlurb">Breakfast to cocktails, sorted by how ripe your bananas are.</span>
        <span class="rotd-meta" id="rotdMeta"></span>
      </span>
    </a>

    <!-- 5. news -->
    <section class="box news">
      <div class="box-head"><h2>Banana news</h2><span class="upd" id="updated"></span></div>
      <div class="news-list" id="newsList">{Array.from({ length: 5 }).map(() => <div class="sk"><span></span><span></span></div>)}</div>
      <div class="news-foot"><a href="/news/">All banana news →</a><span class="buzz-wrap"><span class="buzz-label">Stories per day</span><span id="buzz" class="buzz"></span></span></div>
    </section>

    <!-- 6. everything else, briefly -->
    <nav class="h-more" aria-label="More on the site">
      <a href="/bananalytics/world/"><b>Banana World</b><span>Where 139 million tonnes a year come from, on a map.</span></a>
      <a href="/topics/banana-bread/"><b>Banana bread</b><span>Its history, the science of brown bananas, the best recipes.</span></a>
      <a href="/more/banana-cube/"><b>Banana Cube</b><span>A 3D puzzle solver. Never more than 14 moves.</span></a>
      <a href="/recipes/"><b>All recipes</b><span>90 of ours, 5,203 from elsewhere. Filter by ripeness.</span></a>
    </nav>
  </div>
</Base>

<script>
  import { lineChart, barChart } from '../scripts/charts';
  import { getMarket, getFeed, lookup, allSeries, money, signed, num, lastChange, sliceYears, label, fmtDate, monthOnly, shortDate, marketLink, esc, type Market, type Feed } from '../scripts/market';
  import { meta, link, buzzDays, tickTimes } from '../scripts/news';

  const $ = (s: string) => document.querySelector(s) as HTMLElement;
  const every = (ms: number, fn: () => void) => setInterval(() => { if (!document.hidden) fn(); }, ms);   // skip refreshes in background tabs

  // ---------- news: five stories, small pictures ----------
  function renderNews(f: Feed) {
    const items = f.items.slice(0, 5);
    $('#updated').textContent = f.items.length ? `updated ${new Date(f.updated).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' })}` : '';
    $('#newsList').innerHTML = items.length
      ? items.map((it, i) => `<article class="n-item">${i < 3 && it.thumb ? `<a class="n-img" href="${esc(it.url)}" target="_blank" rel="noopener nofollow" tabindex="-1"><img src="${esc(it.thumb)}" alt="" loading="lazy" decoding="async" onerror="this.closest('a').remove()"></a>` : ''}<div>${link(it)}${meta(it)}</div></article>`).join('')
      : '<p class="empty">The banana wires are quiet. Check back in a minute.</p>';
    if (f.items.length >= 5) { $('#buzz').innerHTML = ''; barChart($('#buzz'), buzzDays(f.items), 44); }
  }

  // ---------- market board ----------
  function renderBoard(m: Market) {
    const g = lookup(m, 'PBANSOP');
    if (!g) return;
    const last = g.pts[g.pts.length - 1], prev = g.pts[g.pts.length - 2], p = lastChange(g.pts) ?? 0;
    $('#board').hidden = false;
    $('#bMain').setAttribute('href', marketLink('PBANSOP'));
    $('#bPrice').textContent = money(g, last.y);
    $('#bChg').innerHTML = `<span class="${p >= 0 ? 'up' : 'down'}">${p >= 0 ? '▲' : '▼'} ${num(Math.abs(p), 1)}% in ${monthOnly(last.x)}</span>`;
    $('#bNote').textContent = `Monthly average, ${shortDate(last.x)}. ${Math.abs(p) <= 0.5 ? 'Steady.' : p > 0 ? 'Dearer.' : 'Cheaper.'}`;
    const box = $('#bChart');
    box.innerHTML = '';
    lineChart(box, sliceYears(g.pts, 3), { height: 90, color: 'var(--series)', label: 'World banana price, last 3 years',
      fmt: v => `${money(g, v)} / tonne`, axisFmt: v => money(g, v, 0), dateFmt: x => fmtDate(x) });
    const rows = allSeries(m).filter(s => s.code !== 'PBANSOP').slice(0, 4);
    $('#bRows').innerHTML = rows.map(s => {
      const pts = s.pts, v = pts[pts.length - 1], c = lastChange(pts) ?? 0;
      return `<a class="b-row" href="${marketLink(s.code)}"><span>${esc(s.kind === 'US shop price' ? 'US ' + s.name : label(s))}</span><b>${money(s, v.y)}</b><em class="${c >= 0 ? 'up' : 'down'}">${c >= 0 ? '▲' : '▼'} ${num(Math.abs(c), 1)}%</em></a>`;
    }).join('');
  }

  // ---------- clicker league: where your country stands ----------
  const regionName = new Intl.DisplayNames(['en'], { type: 'region' });
  const nameOf = (c: string) => (c === 'XX' ? 'Somewhere' : (() => { try { return regionName.of(c) || c; } catch { return c; } })());
  const flag = (c: string) => (c === 'XX' ? '🏳️' : String.fromCodePoint(...[...c].map(ch => 127397 + ch.charCodeAt(0))));
  async function renderLeague() {
    try {
      const d = await (await fetch('/api/peel')).json();
      const rows = Object.entries(d.countries as Record<string, number>).sort((a, b) => b[1] - a[1]);
      const me = rows.findIndex(r => r[0] === d.country);
      const top = rows.slice(0, 4);
      if (me >= 4) top.push(rows[me]);
      $('#leagueList').innerHTML = top.map(([c, n]) => `<li class="${c === d.country ? 'you' : ''}"><span class="r">${rows.findIndex(r => r[0] === c) + 1}</span><span aria-hidden="true">${flag(c)}</span><span class="nm">${esc(nameOf(c))}${c === d.country ? ' <em>you</em>' : ''}</span><b>${num(n, 0)}</b></li>`).join('')
        || '<li class="none">Nobody has peeled a banana yet. Be first.</li>';
      // the line that makes it personal
      const mine = d.country && d.country !== 'XX' ? nameOf(d.country) : null;
      let line = `${num(d.total || 0, 0)} bananas peeled in ${plural(rows.length, 'country', 'countries')}.`;
      if (mine && me === 0 && rows[1]) line = `${mine} leads. ${nameOf(rows[1][0])} is ${num(rows[0][1] - rows[1][1], 0)} bananas behind. They know.`;
      else if (mine && me > 0) line = `${mine} is #${me + 1}, ${num(rows[me - 1][1] - rows[me][1] + 1, 0)} bananas from passing ${nameOf(rows[me - 1][0])}.`;
      else if (mine && me < 0) line = `${mine} hasn't peeled a single banana. Yet.`;
      $('#leagueLine').textContent = line;
      if (mine) $('#peelBtn').textContent = `Peel for ${mine}`;
    } catch { $('#league').hidden = true; }
  }
  const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;

  // ---------- recipe of the day: the same one all day for everyone ----------
  try {
    const idx = JSON.parse(document.getElementById('recipe-index')!.textContent || '[]');
    if (idx.length) {
      const d = new Date(), day = Math.floor(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()) / 864e5);
      const r = idx[(day * 7919) % idx.length];
      $('#rotd').setAttribute('href', `/recipes/${r.s}/`);
      $('#rotdName').textContent = r.n;
      $('#rotdBlurb').textContent = r.b;
      $('#rotdMeta').textContent = `${r.m} · ${r.o}`;
      if (r.p) $('#rotdImg').innerHTML = `<img src="${r.p}" alt="" loading="lazy" width="480" height="320">`;
      else $('#rotdImg').remove();
    }
  } catch {}

  getMarket().then(renderBoard).catch(() => {});
  getFeed().then(renderNews).catch(() => { $('#newsList').innerHTML = '<p class="empty">Couldn’t reach the news. Trying again shortly.</p>'; });
  renderLeague();
  every(60_000, () => getFeed(true).then(renderNews).catch(() => {}));
  every(30_000, renderLeague);
  tickTimes();
</script>

<style>
  .home { display: grid; grid-template-columns: minmax(0, 1fr) 340px; grid-template-areas: "puzzle side" "rotd side" "news news" "more more"; gap: 28px 32px; padding-top: 34px; align-items: start; }
  .h-puzzle { grid-area: puzzle; min-width: 0; }
  .h-side { grid-area: side; display: flex; flex-direction: column; gap: 22px; min-width: 0; }
  .rotd { grid-area: rotd; }
  .news { grid-area: news; }
  .h-more { grid-area: more; }

  /* clicker league */
  .live { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 700; color: var(--leaf); }
  .live i { width: 9px; height: 9px; border-radius: 50%; background: var(--leaf); }
  @media (prefers-reduced-motion: no-preference) { .live i { animation: pulse 2s infinite; } }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: .35; } }
  .league-line { margin: 10px 14px 4px; font-size: 15px; color: var(--ink-2); }
  .league-list { list-style: none; margin: 0; padding: 0 14px; }
  .league-list :global(li) { display: grid; grid-template-columns: 20px 26px minmax(0, 1fr) auto; align-items: center; gap: 4px; padding: 7px 0; border-bottom: 1px solid var(--line); font-size: 15.5px; }
  .league-list :global(li.you) { font-weight: 700; }
  .league-list :global(.r) { color: var(--ink-3); font-weight: 700; font-size: 13px; }
  .league-list :global(.nm) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; }
  .league-list :global(.nm em) { font-style: normal; font-size: 12px; font-weight: 700; background: var(--banana); color: var(--on-banana); padding: 1px 6px; margin-left: 4px; }
  .league-list :global(b) { font-variant-numeric: tabular-nums; }
  .league-list :global(.none) { display: block; color: var(--ink-3); }
  .league-btn { margin: 12px 14px 14px; width: calc(100% - 28px); }

  /* market board */
  .board-main { display: grid; padding: 12px 14px 10px; text-decoration: none; color: var(--ink); border-bottom: 2px solid var(--ink); }
  .board-big b { font: 400 34px/1.1 var(--display); }
  .board-big span { font-size: 14px; color: var(--ink-2); }
  .board-chg { font-weight: 700; font-size: 15px; }
  .board-chart { display: block; margin: 8px 0 2px; }
  .board-note { font-size: 13.5px; color: var(--ink-3); }
  .board-rows :global(.b-row) { display: grid; grid-template-columns: minmax(0, 1fr) auto 72px; gap: 8px; align-items: baseline; padding: 9px 14px; border-bottom: 1px solid var(--line); text-decoration: none; font-size: 15px; min-height: 44px; }
  .board-rows :global(.b-row:last-child) { border-bottom: 0; }
  .board-rows :global(.b-row:hover) { background: var(--paper-2); }
  .board-rows :global(.b-row span) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .board-rows :global(.b-row b) { font-variant-numeric: tabular-nums; }
  .board-rows :global(.b-row em) { font-style: normal; font-weight: 700; font-size: 14px; text-align: right; }

  /* recipe of the day */
  .rotd { display: grid; grid-template-columns: 220px minmax(0, 1fr); text-decoration: none; color: var(--ink); }
  .rotd-img { border-right: 2px solid var(--ink); background: var(--paper-2); min-height: 150px; overflow: hidden; min-width: 0; }
  .rotd-img :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .rotd-txt { display: flex; flex-direction: column; gap: 4px; padding: 14px 18px; }
  .rotd-txt b { font: 400 var(--t-2)/1.1 var(--display); }
  .rotd-txt span:not(.label) { color: var(--ink-2); font-size: 15.5px; }
  .rotd-meta { font-size: 14px !important; color: var(--ink-3) !important; margin-top: auto; }
  .rotd:hover b { text-decoration: underline; text-decoration-color: var(--banana-ink); }

  /* news */
  .upd { font-size: 13px; color: var(--ink-3); }
  .news-list { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .news-list :global(.n-item) { padding: 14px; border-right: 1px solid var(--line); display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .news-list :global(.n-item:last-child) { border-right: 0; }
  .news-list :global(.n-img img) { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border: 2px solid var(--ink); }
  .news-list :global(.hl) { font-weight: 700; font-size: 16px; line-height: 1.35; text-decoration: none; color: var(--ink); }
  .news-list :global(.hl:hover) { text-decoration: underline; }
  .news-list :global(.meta) { font-size: 13px; color: var(--ink-3); margin-top: 4px; }
  .news-list .sk { padding: 14px; display: grid; gap: 8px; }
  .news-list .sk span { height: 12px; background: var(--paper-2); }
  .news-list .sk span:last-child { width: 60%; }
  .empty { padding: 14px; color: var(--ink-3); grid-column: 1 / -1; }
  .news-foot { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 8px 14px; border-top: 2px solid var(--ink); flex-wrap: wrap; }
  .news-foot > a { font-weight: 700; min-height: 44px; display: inline-flex; align-items: center; }
  .buzz-wrap { display: flex; align-items: center; gap: 10px; }
  .buzz-label { font-size: 13px; color: var(--ink-3); }
  .buzz { width: 180px; display: block; }

  /* more */
  .h-more { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border: 2px solid var(--ink); }
  .h-more a { display: flex; flex-direction: column; gap: 4px; padding: 14px 16px; text-decoration: none; border-right: 2px solid var(--ink); min-height: 44px; }
  .h-more a:last-child { border-right: 0; }
  .h-more b { font: 400 20px/1.15 var(--display); }
  .h-more span { font-size: 14.5px; color: var(--ink-2); }
  .h-more a:hover { background: var(--paper-2); }

  @media (max-width: 1060px) {
    .news-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .news-list :global(.n-item) { border-bottom: 1px solid var(--line); }
    .h-more { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .h-more a:nth-child(2) { border-right: 0; }
    .h-more a:nth-child(-n+2) { border-bottom: 2px solid var(--ink); }
  }
  @media (max-width: 900px) {
    .home { grid-template-columns: 1fr; grid-template-areas: "puzzle" "side" "rotd" "news" "more"; padding-top: 30px; gap: 24px; }
  }
  @media (max-width: 600px) {
    .rotd { grid-template-columns: 112px minmax(0, 1fr); }
    .rotd-img { min-height: 0; }
    .rotd-txt { padding: 10px 12px; }
    .rotd-txt b { font-size: 21px; }
    .rotd-txt #rotdBlurb { display: none; }
    .news-list { grid-template-columns: 1fr; }
    .news-list :global(.n-item) { flex-direction: row; border-right: 0; }
    .news-list :global(.n-img) { flex: none; width: 96px; }
    .buzz-wrap { display: none; }
    .h-more { grid-template-columns: 1fr; }
    .h-more a { border-right: 0 !important; border-bottom: 2px solid var(--ink); }
    .h-more a:last-child { border-bottom: 0; }
  }
</style>
