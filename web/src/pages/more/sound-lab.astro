---
import Base from '../../layouts/Base.astro';
---
<Base wide section="more" title="Banana Sound Lab · a fast, bassy banana track you can tweak · All Things Banana"
      description="An experiment: a fast, bassy hard-dance loop with an 'oh-ee-ee-ah' chant, made live in your browser. Tweak the tempo, kick, bass and voice, and watch the banana spin.">
  <nav class="crumbs"><a href="/more/">More Bananas</a> › Banana Sound Lab</nav>

  <div class="lab">
    <section class="stage" id="stage">
      <div class="glow" id="glow"></div>
      <div class="spinner" aria-hidden="true"><span id="spin">🍌</span></div>
      <div class="chant" id="chant" aria-hidden="true"></div>
      <div class="transport">
        <button id="play" class="big">▶ Play</button>
        <button id="build" class="ghost" disabled>🚀 Build-up → Drop</button>
      </div>
      <p class="note">Everything is made live in your browser from oscillators and noise. Nothing is sampled. Turn your volume down a little first.</p>
    </section>

    <section class="panel">
      <div class="presets">
        <span>Presets</span>
        <button data-preset="spin">Spinning banana</button>
        <button data-preset="hard">Hardstyle</button>
        <button data-preset="bounce">Bouncy</button>
        <button data-preset="chill">Chill</button>
      </div>

      <div class="knobs">
        <label><span>Tempo <b id="v-bpm"></b></span><input type="range" id="k-bpm" min="130" max="175" step="1"></label>
        <label><span>Kick distortion <b id="v-drive"></b></span><input type="range" id="k-drive" min="0" max="10" step="1"></label>
        <label><span>Bass <b id="v-bass"></b></span><input type="range" id="k-bass" min="0" max="10" step="1"></label>
        <label><span>Voice <b id="v-voice"></b></span><input type="range" id="k-voice" min="0" max="10" step="1"></label>
        <label><span>Voice pitch <b id="v-pitch"></b></span><input type="range" id="k-pitch" min="-12" max="12" step="1"></label>
        <label><span>Filter <b id="v-cutoff"></b></span><input type="range" id="k-cutoff" min="0" max="10" step="0.5"></label>
        <label><span>Reverb <b id="v-reverb"></b></span><input type="range" id="k-reverb" min="0" max="10" step="1"></label>
      </div>

      <div class="parts">
        <span>Parts</span>
        <button data-part="kick">🥁 Kick</button>
        <button data-part="bass">🔊 Bass</button>
        <button data-part="hats">✨ Hats</button>
        <button data-part="clap">👏 Clap</button>
        <button data-part="voice">🗣️ Voice</button>
      </div>

      <div class="share">
        <span>Like a sound? Copy its settings and send them over:</span>
        <code id="code"></code>
        <button id="copy" class="ghost small">Copy</button>
      </div>
    </section>
  </div>
</Base>

<script>
  import { HardBass, DEFAULTS, type Settings } from '../../scripts/hardbass';

  const $ = (id: string) => document.getElementById(id)!;
  const engine = new HardBass();
  const KEYS = ['bpm', 'drive', 'bass', 'voice', 'pitch', 'cutoff', 'reverb'] as const;
  const PRESETS: Record<string, Partial<Settings>> = {
    spin: { bpm: 155, drive: 6, bass: 6, voice: 7, pitch: 0, cutoff: 10, reverb: 3, parts: { kick: true, bass: true, hats: true, clap: true, voice: true } },
    hard: { bpm: 158, drive: 10, bass: 8, voice: 4, pitch: -5, cutoff: 10, reverb: 4, parts: { kick: true, bass: true, hats: true, clap: true, voice: true } },
    bounce: { bpm: 145, drive: 3, bass: 7, voice: 8, pitch: 5, cutoff: 8, reverb: 2, parts: { kick: true, bass: true, hats: true, clap: false, voice: true } },
    chill: { bpm: 132, drive: 1, bass: 4, voice: 6, pitch: 3, cutoff: 5, reverb: 7, parts: { kick: true, bass: true, hats: false, clap: false, voice: true } },
  };

  // remember the last settings on this device
  try { const saved = JSON.parse(localStorage.getItem('atb-soundlab') || 'null'); if (saved) engine.s = { ...structuredClone(DEFAULTS), ...saved, parts: { ...DEFAULTS.parts, ...saved.parts } }; } catch {}
  const persist = () => { try { localStorage.setItem('atb-soundlab', JSON.stringify(engine.s)); } catch {} };

  function show() {
    const s = engine.s;
    for (const k of KEYS) {
      ($('k-' + k) as HTMLInputElement).value = String(s[k]);
      $('v-' + k).textContent = k === 'bpm' ? `${s.bpm} BPM` : k === 'pitch' ? `${s.pitch > 0 ? '+' : ''}${s.pitch}` : String(s[k]);
    }
    document.querySelectorAll<HTMLButtonElement>('[data-part]').forEach(b => b.classList.toggle('on', s.parts[b.dataset.part as keyof Settings['parts']]));
    const on = Object.entries(s.parts).filter(([, v]) => v).map(([k]) => k).join('+');
    $('code').textContent = `bpm ${s.bpm} · drive ${s.drive} · bass ${s.bass} · voice ${s.voice} · pitch ${s.pitch} · filter ${s.cutoff} · reverb ${s.reverb} · ${on}`;
  }

  for (const k of KEYS) $('k-' + k).addEventListener('input', e => {
    (engine.s as any)[k] = +(e.target as HTMLInputElement).value;
    engine.apply(); show(); persist();
  });
  document.querySelectorAll<HTMLButtonElement>('[data-part]').forEach(b => b.addEventListener('click', () => {
    const p = b.dataset.part as keyof Settings['parts'];
    engine.s.parts[p] = !engine.s.parts[p];
    show(); persist();
  }));
  document.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach(b => b.addEventListener('click', () => {
    engine.s = { ...structuredClone(DEFAULTS), ...structuredClone(PRESETS[b.dataset.preset!]) } as Settings;
    engine.apply(); show(); persist();
  }));
  $('play').addEventListener('click', () => {
    if (engine.playing) engine.stop(); else engine.start();
    $('play').textContent = engine.playing ? '■ Stop' : '▶ Play';
    ($('build') as HTMLButtonElement).disabled = !engine.playing;
    $('stage').classList.toggle('live', engine.playing);
  });
  $('build').addEventListener('click', () => engine.buildUp());
  $('copy').addEventListener('click', async () => {
    try { await navigator.clipboard.writeText($('code').textContent || ''); $('copy').textContent = 'Copied!'; setTimeout(() => ($('copy').textContent = 'Copy'), 1500); } catch {}
  });

  // the banana spins once per beat and jumps on every kick; the chant words flash with the voice
  let kickAt = 0;
  engine.onKick = () => { kickAt = performance.now(); };
  const spin = $('spin'), glow = $('glow'), chant = $('chant');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const WORDS = ['OI', 'II', 'AAA', '', '', '', '', '', 'OI', 'II', 'AAA', '', '', '', '', ''];
  let lastWord = -1;
  function frame() {
    const b = engine.beat();
    const sinceKick = (performance.now() - kickAt) / 1000;
    const bump = b.playing ? Math.max(0, 1 - sinceKick * 6) : 0;
    const angle = b.playing && !reduce ? (b.n + b.phase) * 360 : 0;
    spin.style.transform = `rotateY(${angle}deg) scale(${1 + bump * 0.18})`;
    glow.style.opacity = String(b.playing ? 0.25 + bump * 0.6 : 0);
    if (b.playing && engine.s.parts.voice && engine.s.voice > 0) {
      const step = Math.floor(b.phase * 4 + (b.n % 4) * 4) % 16;
      if (step !== lastWord) { lastWord = step; if (WORDS[step]) { chant.textContent = WORDS[step]; chant.classList.remove('pop'); void chant.offsetWidth; chant.classList.add('pop'); } }
    } else chant.textContent = '';
    requestAnimationFrame(frame);
  }
  show();
  requestAnimationFrame(frame);
</script>

<style>
  .crumbs { padding-top: 18px; font-size: 13px; color: var(--ink-3); }
  .crumbs a { color: var(--link); text-decoration: none; }
  .lab { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 20px; margin-top: 14px; align-items: stretch; }

  .stage { position: relative; overflow: hidden; border-radius: 22px; background: radial-gradient(circle at 50% 40%, #3a2a05, #120d02 70%); min-height: 460px;
    display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 24px; }
  .glow { position: absolute; inset: -20%; background: radial-gradient(circle at 50% 45%, rgba(255, 216, 77, .55), transparent 55%); opacity: 0; pointer-events: none; transition: opacity .05s; }
  .spinner { perspective: 600px; position: relative; }
  .spinner span { display: inline-block; font-size: 150px; line-height: 1; filter: drop-shadow(0 18px 30px rgba(0, 0, 0, .5)); will-change: transform; }
  .chant { position: absolute; top: 22px; left: 0; right: 0; text-align: center; font-size: 46px; font-weight: 900; letter-spacing: .04em; color: #ffd84d; text-shadow: 0 4px 0 #7a5400; pointer-events: none; }
  .chant.pop { animation: pop .25s ease-out; }
  @keyframes pop { from { transform: scale(1.5); opacity: .3; } }
  .transport { position: relative; display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; margin-top: 30px; }
  .big { font: 900 19px 'Inter', sans-serif; background: #ffd84d; color: #2a2118; border: none; border-radius: 16px; padding: 14px 30px; cursor: pointer; min-width: 150px; }
  .big:hover { transform: translateY(-1px); }
  .ghost { font: 700 14.5px 'Inter', sans-serif; background: rgba(255, 255, 255, .08); color: var(--ink); border: 1px solid rgba(255, 255, 255, .18); border-radius: 14px; padding: 12px 18px; cursor: pointer; }
  .ghost:disabled { opacity: .4; cursor: default; }
  .ghost.small { padding: 6px 12px; font-size: 13px; border-radius: 10px; }
  .note { position: relative; color: rgba(255, 255, 255, .55); font-size: 12.5px; text-align: center; max-width: 380px; margin: 18px 0 0; }

  .panel { background: var(--surface); border: 1px solid var(--border); border-radius: 22px; padding: 20px 22px; display: flex; flex-direction: column; gap: 18px; }
  .presets, .parts { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .presets > span, .parts > span, .share > span { width: 100%; font-size: 11.5px; font-weight: 800; text-transform: uppercase; letter-spacing: .07em; color: var(--ink-3); }
  .presets button, .parts button { font: 700 13.5px 'Inter', sans-serif; color: var(--ink-2); background: var(--chip); border: 1px solid var(--border); border-radius: 999px; padding: 7px 13px; cursor: pointer; }
  .presets button:hover { border-color: var(--brand); color: var(--ink); }
  .parts button { opacity: .5; }
  .parts button.on { opacity: 1; color: #2a2118; background: #ffd84d; border-color: #ffd84d; }
  .knobs { display: grid; gap: 12px; }
  .knobs label { display: grid; gap: 4px; }
  .knobs span { display: flex; justify-content: space-between; font-size: 13.5px; font-weight: 700; color: var(--ink-2); }
  .knobs b { color: var(--ink); font-variant-numeric: tabular-nums; }
  .knobs input { width: 100%; accent-color: #ffd84d; }
  .share { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .share > span { text-transform: none; letter-spacing: 0; font-weight: 600; font-size: 12.5px; }
  .share code { flex: 1; min-width: 0; font-size: 12px; background: var(--bg); border: 1px solid var(--border); border-radius: 8px; padding: 7px 9px; color: var(--ink-2); overflow-wrap: anywhere; }

  @media (max-width: 860px) {
    .lab { grid-template-columns: 1fr; }
    .stage { min-height: 360px; }
    .spinner span { font-size: 120px; }
    .chant { font-size: 36px; }
  }
</style>
