---
import Base from '../../layouts/Base.astro';
---
<Base wide section="more" title="Banana Clicker · peel bananas for your country · All Things Banana"
      description="Click the banana to peel it. Every banana you peel counts for your country on the live world leaderboard.">
  <nav class="crumbs"><a href="/more/">More Bananas</a> › Banana Clicker</nav>

  <div class="game">
    <section class="play">
      <div class="scores">
        <div><span class="lbl">You've peeled</span><b class="num" id="mine">0</b></div>
        <div><span class="lbl" id="countryLbl">Your country</span><b class="num" id="ours">—</b></div>
        <div><span class="lbl">The whole world</span><b class="num" id="world">—</b></div>
      </div>

      <button class="banana-btn" id="banana" aria-label="Peel the banana">
        <svg viewBox="0 0 200 330" width="220" height="363" aria-hidden="true">
          <defs>
            <linearGradient id="peelG" x1="0" x2="1">
              <stop offset="0" stop-color="#e9b923"/><stop offset=".45" stop-color="#ffe066"/><stop offset="1" stop-color="#d9a514"/>
            </linearGradient>
            <linearGradient id="fleshG" x1="0" x2="1">
              <stop offset="0" stop-color="#efe2b0"/><stop offset=".5" stop-color="#fff7d8"/><stop offset="1" stop-color="#e8d9a2"/>
            </linearGradient>
          </defs>
          <g id="whole">
            <!-- the fruit inside -->
            <path d="M100 34 C122 34 133 82 131 156 L69 156 C67 82 78 34 100 34 Z" fill="url(#fleshG)"/>
            <!-- lower peel and tip -->
            <path d="M68 150 C66 214 78 270 100 296 C122 270 134 214 132 150 Z" fill="url(#peelG)" stroke="#b8860b" stroke-width="2"/>
            <path d="M86 160 C84 210 90 250 100 280" stroke="#c9970f" stroke-width="2" fill="none" opacity=".5"/>
            <circle cx="100" cy="297" r="6" fill="#4b3420"/>
            <!-- the two peel flaps that open -->
            <g class="flap left"><path d="M100 26 C82 28 68 62 67 152 L101 152 Z" fill="url(#peelG)" stroke="#b8860b" stroke-width="2"/></g>
            <g class="flap right">
              <path d="M100 26 C118 28 132 62 133 152 L99 152 Z" fill="url(#peelG)" stroke="#b8860b" stroke-width="2"/>
              <rect x="94" y="8" width="12" height="22" rx="3" fill="#7a4b22"/>
            </g>
          </g>
        </svg>
      </button>
      <p class="hint">Click or tap the banana · or press <kbd>Space</kbd></p>
      <div id="pops" class="pops" aria-hidden="true"></div>
    </section>

    <aside class="board">
      <h2>World leaderboard <span class="live"><i></i>live</span></h2>
      <ol id="leaders" class="leaders"><li class="empty">Loading…</li></ol>
      <p class="note">Your country comes from your connection, as seen by our host, Cloudflare. We only store a total per country, nothing about you.</p>
    </aside>
  </div>
</Base>

<script>
  const $ = (s: string) => document.querySelector(s) as HTMLElement;
  const fmt = (n: number) => n.toLocaleString('en-US');
  const regionName = new Intl.DisplayNames(['en'], { type: 'region' });
  const nameOf = (c: string) => (c === 'XX' ? 'Unknown' : (() => { try { return regionName.of(c) || c; } catch { return c; } })());
  const flag = (c: string) => (c === 'XX' ? '🏳️' : String.fromCodePoint(...[...c].map(ch => 127397 + ch.charCodeAt(0))));

  type Tally = { country: string; total: number; countries: Record<string, number> };
  let tally: Tally | null = null;
  let pending = 0, sending = false, recent: number[] = [];
  let mine = 0;
  try { mine = Number(localStorage.getItem('atb-peeled')) || 0; } catch {}

  function render() {
    $('#mine').textContent = fmt(mine);
    if (!tally) return;
    const yours = tally.country, total = tally.total + pending, ours = (tally.countries[yours] || 0) + pending;
    $('#world').textContent = fmt(total);
    $('#ours').textContent = fmt(ours);
    $('#countryLbl').textContent = `${flag(yours)} ${nameOf(yours)}`;
    const rows = Object.entries({ ...tally.countries, [yours]: ours }).filter(([, n]) => n > 0).sort((a, b) => b[1] - a[1]);
    const top = rows[0]?.[1] || 1;
    $('#leaders').innerHTML = rows.length ? rows.slice(0, 15).map(([c, n], i) => `
      <li class="${c === yours ? 'you' : ''}">
        <span class="rank num">${i + 1}</span><span class="flag">${flag(c)}</span>
        <span class="name">${nameOf(c)}${c === yours ? ' <em>you</em>' : ''}</span><b class="num">${fmt(n)}</b>
        <span class="bar" style="width:${Math.max(2, (n / top) * 100)}%"></span>
      </li>`).join('') : '<li class="empty">No bananas peeled yet. Be the first!</li>';
  }

  // ---------- the peel ----------
  const btn = $('#banana');
  const whole = btn.querySelector('#whole') as SVGGElement;
  const left = btn.querySelector('.flap.left') as SVGGElement, right = btn.querySelector('.flap.right') as SVGGElement;
  const running: Animation[] = [];
  function peelAnimation() {
    running.splice(0).forEach(a => a.cancel());
    // linear overall; each step has its own easing (an overall easing would squash the whole sequence)
    const timing = { duration: 620 }, out = 'cubic-bezier(.2,.7,.3,1)';
    const flap = (deg: number) => [{ transform: 'rotate(0deg)', easing: out }, { transform: `rotate(${deg}deg)`, offset: .32 },
      { transform: `rotate(${deg}deg)`, offset: .78 }, { transform: 'rotate(0deg)', offset: .8 }, { transform: 'rotate(0deg)' }];
    running.push(
      left.animate(flap(-150), timing),
      right.animate(flap(150), timing),
      // pop, then the peeled banana shrinks away and a fresh one appears
      whole.animate([{ transform: 'scale(1)', opacity: 1, easing: out }, { transform: 'scale(1.05)', offset: .32 }, { transform: 'scale(1.02)', opacity: 1, offset: .62, easing: 'ease-in' },
        { transform: 'scale(.55) translateY(40px)', opacity: 0, offset: .79 }, { transform: 'scale(.8)', opacity: 0, offset: .8, easing: out }, { transform: 'scale(1)', opacity: 1 }], timing),
    );
  }
  function popPlusOne(x: number, y: number) {
    const el = document.createElement('span');
    el.className = 'pop';
    el.textContent = '+1';
    el.style.left = `${x}px`; el.style.top = `${y}px`;
    $('#pops').append(el);
    el.animate([{ transform: 'translate(-50%, 0) scale(.8)', opacity: 1 }, { transform: 'translate(-50%, -90px) scale(1.2)', opacity: 0 }], { duration: 800, easing: 'ease-out' })
      .onfinish = () => el.remove();
  }

  function peel(e?: MouseEvent) {
    const now = performance.now();
    recent = recent.filter(t => now - t < 1000);
    if (recent.length >= 20) return;   // fair play: at most 20 bananas a second
    recent.push(now);
    mine++; pending++;
    try { localStorage.setItem('atb-peeled', String(mine)); } catch {}
    peelAnimation();
    const box = $('.play').getBoundingClientRect(), b = btn.getBoundingClientRect();
    const x = e && e.clientX ? e.clientX - box.left : b.left - box.left + b.width / 2 + (Math.random() - .5) * 60;
    const y = e && e.clientY ? e.clientY - box.top : b.top - box.top + b.height * .3;
    popPlusOne(x, y);
    render();
  }
  btn.addEventListener('click', e => peel(e as MouseEvent));
  addEventListener('keydown', e => {
    if (e.code === 'Space' && !(e.target as HTMLElement).closest('input, textarea')) { e.preventDefault(); if (!e.repeat) peel(); }
  });

  // ---------- talking to the server ----------
  async function flush() {
    if (sending || !pending) return;
    sending = true;
    const n = Math.min(pending, 60);
    try {
      const res = await fetch('/api/peel', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ n }) });
      if (res.ok) { tally = await res.json(); pending -= n; }
    } catch {}
    sending = false;
    render();
  }
  async function refresh() {
    if (pending) return flush();
    try { tally = await (await fetch('/api/peel')).json(); render(); } catch {}
  }
  setInterval(flush, 1500);
  setInterval(refresh, 5000);
  // send any last clicks when leaving the page
  addEventListener('pagehide', () => {
    if (pending) navigator.sendBeacon('/api/peel', new Blob([JSON.stringify({ n: Math.min(pending, 60) })], { type: 'application/json' }));
  });
  render();
  refresh();
</script>

<style>
  .crumbs { padding-top: 18px; font-size: 13px; color: var(--ink-3); }
  .crumbs a { color: var(--link); text-decoration: none; }
  .game { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 28px; padding-top: 12px; align-items: start; }
  .play { position: relative; background: radial-gradient(700px 420px at 50% 55%, #3a2f0e, var(--surface) 70%); border: 1px solid var(--border); border-radius: 16px;
    padding: 22px 20px 26px; display: flex; flex-direction: column; align-items: center; overflow: hidden; user-select: none; min-height: 600px; }
  .scores { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); width: 100%; gap: 10px; text-align: center; }
  .scores div { background: rgba(0, 0, 0, .25); border-radius: 12px; padding: 10px 6px; }
  .lbl { display: block; font-size: 12px; color: var(--ink-3); font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .scores b { display: block; font-size: 30px; font-weight: 800; letter-spacing: -0.02em; }
  #mine { color: var(--brand); }
  .banana-btn { margin-top: 26px; background: none; border: none; cursor: pointer; padding: 10px; border-radius: 50%; -webkit-tap-highlight-color: transparent; touch-action: manipulation; }
  .banana-btn:focus-visible { outline: 3px solid var(--brand); outline-offset: 6px; }
  .banana-btn svg { display: block; filter: drop-shadow(0 18px 24px rgba(0, 0, 0, .45)); transform: rotate(-12deg); transition: transform .15s; }
  .banana-btn:hover svg { transform: rotate(-8deg) scale(1.02); }
  .banana-btn:active svg { transform: rotate(-12deg) scale(.97); }
  #whole { transform-box: fill-box; transform-origin: 50% 60%; }
  .flap { transform-box: fill-box; }
  .flap.left { transform-origin: 0% 100%; }
  .flap.right { transform-origin: 100% 100%; }
  .hint { color: var(--ink-3); font-size: 13px; margin: 18px 0 0; }
  kbd { font: 600 11px 'Inter', sans-serif; background: var(--chip); border-radius: 4px; padding: 1px 6px; }
  .pops { position: absolute; inset: 0; pointer-events: none; }
  .pops :global(.pop) { position: absolute; font-weight: 800; font-size: 26px; color: var(--brand); text-shadow: 0 2px 8px rgba(0, 0, 0, .5); }

  .board { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 16px 18px; position: sticky; top: 16px; }
  .board h2 { font-size: 17px; font-weight: 800; margin: 0 0 10px; display: flex; align-items: center; justify-content: space-between; }
  .live { font-size: 12px; font-weight: 600; color: var(--ink-3); display: flex; align-items: center; gap: 6px; }
  .live i { width: 7px; height: 7px; border-radius: 50%; background: var(--up); animation: pulse 2s infinite; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--up) 55%, transparent); } 70% { box-shadow: 0 0 0 6px transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }
  .leaders { list-style: none; margin: 0; padding: 0; }
  .leaders :global(li) { position: relative; display: grid; grid-template-columns: 26px 26px minmax(0, 1fr) auto; align-items: center; gap: 6px; padding: 8px 6px; border-radius: 8px; font-size: 14px; }
  .leaders :global(li + li) { margin-top: 2px; }
  .leaders :global(.rank) { color: var(--ink-3); font-weight: 700; font-size: 12px; }
  .leaders :global(.flag) { font-size: 18px; }
  .leaders :global(.name) { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-weight: 600; }
  .leaders :global(.name em) { font-style: normal; font-size: 10.5px; font-weight: 800; text-transform: uppercase; color: #1d1600; background: var(--brand); border-radius: 4px; padding: 1px 5px; margin-left: 4px; }
  .leaders :global(b) { font-weight: 800; }
  .leaders :global(.bar) { position: absolute; left: 0; bottom: 0; height: 3px; border-radius: 2px; background: var(--brand); opacity: .55; }
  .leaders :global(li.you) { background: color-mix(in srgb, var(--brand) 12%, transparent); }
  .leaders :global(.empty) { display: block; color: var(--ink-3); padding: 12px 0; }
  .note { color: var(--ink-3); font-size: 12px; margin: 12px 0 0; }

  @media (max-width: 900px) {
    .game { grid-template-columns: 1fr; }
    .board { position: static; }
    .play { min-height: 0; }
  }
  @media (max-width: 480px) {
    .play { padding: 14px 10px 20px; }
    .scores { gap: 6px; }
    .lbl { font-size: 11px; }
    .scores b { font-size: 22px; }
    .banana-btn svg { width: 180px; height: 297px; }
  }
</style>
