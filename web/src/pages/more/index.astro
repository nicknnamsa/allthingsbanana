---
import Base from '../../layouts/Base.astro';
---
<Base wide section="more" title="All banana games · Bananadle, the Banana Clicker and the Banana Cube · All Things Banana"
      description="Every banana game on the site: Bananadle, the daily Wikipedia puzzle; the Banana Clicker world league; and the Banana Cube, a 3D puzzle solver.">
  <header class="head">
    <h1>All the games</h1>
    <p>Three ways to waste time on bananas. One of them resets every day.</p>
  </header>

  <ol class="games">
    <li>
      <a href="/bananadle/">
        <span class="num">1</span>
        <span class="txt">
          <b>Bananadle</b>
          <span>Start on today's Wikipedia page and reach Banana by naming pages it links to or mentions, from memory. Par is 4.</span>
          <em>New crate every day</em>
        </span>
        <span class="go">Play →</span>
      </a>
    </li>
    <li>
      <a href="/more/banana-clicker/">
        <span class="num">2</span>
        <span class="txt">
          <b>Banana Clicker</b>
          <span>Peel bananas for your country and climb the world league. Keep going and the page turns into a rave.</span>
          <em id="peelStat">A crate of 100 a day</em>
        </span>
        <span class="go">Peel →</span>
      </a>
    </li>
    <li>
      <a href="/more/banana-cube/">
        <span class="num">3</span>
        <span class="txt">
          <b>Banana Cube</b>
          <span>A 3D solver for a banana-shaped twisty puzzle. Enter your position and it tells you the fewest moves to solved.</span>
          <em>241,920 positions, never more than 14 moves</em>
        </span>
        <span class="go">Twist →</span>
      </a>
    </li>
  </ol>
</Base>

<script>
  fetch('/api/peel').then(r => r.json()).then(d => {
    const countries = Object.keys(d.countries || {}).length;
    if (d.total) document.getElementById('peelStat')!.textContent = `${d.total.toLocaleString('en-US')} bananas peeled in ${countries} ${countries === 1 ? 'country' : 'countries'} so far`;
  }).catch(() => {});
</script>

<style>
  .head { padding: 34px 0 18px; }
  .head h1 { margin: 0; font-size: var(--t-1); }
  .head p { margin: 6px 0 0; color: var(--ink-2); }
  .games { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .games a { display: grid; grid-template-columns: 64px minmax(0, 1fr) auto; gap: 18px; align-items: center; padding: 22px 24px; border-radius: var(--r-lg); text-decoration: none; color: var(--ink); transition: transform .2s; }
  .games li:nth-child(1) a { background: var(--butter); } .games li:nth-child(2) a { background: var(--mint); } .games li:nth-child(3) a { background: var(--sky); }
  .games a:hover { transform: translateY(-2px); }
  .games a:hover b { text-decoration: underline; text-decoration-color: var(--ink-3); text-underline-offset: 4px; }
  :global(:root[data-theme="banana"]) .games a { border: 2px solid #3A2A0E; box-shadow: 4px 4px 0 #3A2A0E; }
  .num { width: 56px; height: 56px; border-radius: 50%; background: var(--card); color: var(--ink); display: grid; place-items: center; font: 600 26px var(--display); transform: rotate(-6deg); }
  .txt { display: flex; flex-direction: column; gap: 4px; }
  .txt b { font: 600 var(--t-2)/1.1 var(--display); }
  .txt span { color: var(--ink-2); max-width: 64ch; }
  .txt em { font-style: normal; font-weight: 800; font-size: 15px; color: var(--ink); }
  .go { font-weight: 800; font-size: 16px; white-space: nowrap; }
  @media (max-width: 600px) {
    .games a { grid-template-columns: 48px minmax(0, 1fr); gap: 14px; padding: 18px 16px; }
    .num { width: 44px; height: 44px; font-size: 21px; }
    .go { display: none; }
  }
</style>
