---
import Base from '../../layouts/Base.astro';
import { topics, upcoming } from '../../data/topics';
---
<Base wide section="topics" title="Banana topics: everything about bananas, gathered in one place · All Things Banana"
      description="Hubs for every banana subject: the short answer with sources, the best recipes, live news, the numbers and the best of the internet, all on one page.">
  <header class="head">
    <h1>Topics</h1>
    <p>One page for each banana subject, with everything we can find about it gathered in one place: a short, sourced answer, our recipes and the internet's favourites, live news, the numbers, and hand-picked links to the best of the web.</p>
  </header>

  <ul class="list">
    {topics.map(t => (
      <li><a href={`/topics/${t.slug}/`}>
        <b>{t.title}</b>
        <span>{t.tagline}</span>
        <em>Open the hub →</em>
      </a></li>
    ))}
  </ul>
  <p class="next">More hubs on the way. Banana bread got there first, obviously.</p>
</Base>

<style>
  .head { padding: 34px 0 18px; }
  .head h1 { margin: 0; font-size: var(--t-1); }
  .head p { color: var(--ink-2); max-width: 760px; margin: 8px 0 0; }
  .list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 380px), 1fr)); gap: 16px; }
  .list a { display: flex; flex-direction: column; gap: 4px; padding: 20px 22px; border-radius: var(--r-lg); background: var(--peach); text-decoration: none; color: var(--ink); transition: transform .2s; }
  .list a:hover { transform: translateY(-2px); }
  :global(:root[data-theme="banana"]) .list a { border: 2px solid #3A2A0E; box-shadow: 4px 4px 0 #3A2A0E; }
  .list b { font: 600 var(--t-2)/1.1 var(--display); }
  .list span { color: var(--ink-2); max-width: 70ch; }
  .list em { font-style: normal; font-weight: 700; margin-top: 4px; }
  .next { color: var(--ink-3); margin-top: 14px; }
</style>
