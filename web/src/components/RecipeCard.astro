---
import { formatTime, MEALS, recipePhoto, type Recipe } from '../data/recipes';
interface Props { recipe: Recipe }
const { recipe: r } = Astro.props;
const photo = recipePhoto(r.slug);
const mealLabel = (id: string) => MEALS.find(m => m.id === id)?.label ?? id;
// everything the filters on the Banacipes page need, as data attributes
const search = [r.name, r.blurb, r.origin, ...r.ingredients].join(' ').toLowerCase();
// recipes without a photo get a tile in the colour of the bananas they want
const ripeTone = { green: 'var(--r1)', yellow: 'var(--r4)', spotty: 'var(--r5)', brown: 'var(--r7)' }[r.ripeness[0]] ?? 'var(--r4)';
---
<a class="rc" href={`/recipes/${r.slug}/`}
   data-meals={r.meals.join(' ')} data-ripe={r.ripeness.join(' ')} data-diet={r.diet.join(' ')}
   data-mins={r.mins} data-level={r.level} data-ings={r.ingredients.length} data-name={r.name.toLowerCase()} data-search={search}>
  {photo
    ? <div class="rc-art"><img src={photo.thumb} alt="" loading="lazy" decoding="async" width="480" height="320"></div>
    : <div class="rc-art rc-plain" style={`background:${ripeTone}`} aria-hidden="true">
        <svg viewBox="0 0 32 32"><path d="M5.5 8.5c1.5 11 11 18.5 22 14.5-1.5 3.5-5.5 5.5-10.5 5.5C9.5 28.5 4 20 5.5 8.5z" fill="#FFD23F" stroke="#231A10" stroke-width="1.6" stroke-linejoin="round"/><path d="M5.5 8.5 4.6 4.4l3 1.3" fill="none" stroke="#231A10" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>}
  <div class="rc-body">
    <div class="rc-tags">{r.meals.slice(0, 2).map(mealLabel).join(' · ')} · <span>{r.origin}</span></div>
    <h3>{r.name}</h3>
    <p>{r.blurb}</p>
    <div class="rc-foot">
      <span class="pips" title={`Banana-o-meter: ${r.level} of 5`} aria-label={`Banana-o-meter ${r.level} of 5`}>
        {[1, 2, 3, 4, 5].map(i => <i class={i <= r.level ? 'on' : ''}></i>)}
      </span>
      <span>{formatTime(r.mins)}</span>
    </div>
  </div>
</a>

<style>
  .rc { display: flex; flex-direction: column; background: var(--card); border: 2px solid var(--ink); text-decoration: none; color: var(--ink); min-width: 0; }
  .rc:hover h3 { text-decoration: underline; text-decoration-color: var(--banana-ink); text-underline-offset: 3px; }
  .rc-art { height: 150px; border-bottom: 2px solid var(--ink); overflow: hidden; background: var(--paper-2); }
  .rc-art img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .rc-plain { display: grid; place-items: center; }
  .rc-plain svg { width: 72px; height: 72px; transform: rotate(-8deg); }
  .rc-body { padding: 12px 14px 14px; display: flex; flex-direction: column; gap: 4px; flex: 1; }
  .rc-tags { font-size: 13px; font-weight: 600; color: var(--ink-2); }
  .rc-tags span { color: var(--ink-3); font-weight: 500; }
  .rc h3 { margin: 2px 0 0; font: 400 20px/1.15 var(--display); }
  .rc p { margin: 0; color: var(--ink-2); font-size: 15px; line-height: 1.45; }
  .rc-foot { margin-top: auto; padding-top: 10px; display: flex; justify-content: space-between; align-items: center; font-size: 14px; color: var(--ink-2); font-weight: 600; }
  /* phones: two compact cards per row */
  @media (max-width: 560px) {
    .rc-art { height: 100px; }
    .rc-plain svg { width: 48px; height: 48px; }
    .rc-body { padding: 9px 10px 10px; }
    .rc-tags span, .rc p { display: none; }
    .rc-tags { font-size: 12px; }
    .rc h3 { font-size: 16.5px; }
    .rc-foot { font-size: 13px; flex-wrap: wrap; gap: 4px; }
  }
</style>
