---
// bare: the page fills the full width under the header (used by the Banana Cube)
// image: the picture shown when the page is shared (1200×630, in public/og/)
// ticker: show the market strip under the header (home page and Prices only)
import '../styles/site.css';
interface Props { title: string; description: string; wide?: boolean; section?: string; bare?: boolean; image?: string; ticker?: boolean }
const { title, description, wide = false, section = '', bare = false, image = '/og/default.jpg', ticker = false } = Astro.props;
const path = Astro.url.pathname;
import { recipes, recipePhoto, formatTime } from '../data/recipes';
// a small index of recipes for the header search and the home page's recipe of the day
const recipeIndex = recipes.map(r => ({ n: r.name, s: r.slug, e: r.emoji, b: r.blurb, p: recipePhoto(r.slug)?.thumb, m: formatTime(r.mins), o: r.origin,
  t: `${r.name} ${r.origin} ${r.meals.join(' ')} ${r.diet.join(' ')}`.toLowerCase() }));
// the logo goes home; four tabs, each with a one-line descriptor on wide screens
const tabs = [
  { id: 'bananadle', href: '/bananadle/', label: 'Bananadle', desc: 'daily puzzle' },
  { id: 'clicker', href: '/more/banana-clicker/', label: 'Clicker', desc: 'world league' },
  { id: 'recipes', href: '/recipes/', label: 'Recipes', desc: `${recipes.length} + 5,203` },
  { id: 'prices', href: '/bananalytics/', label: 'Prices', desc: '& the map' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={new URL(path, Astro.site)}>
  <meta property="og:site_name" content="All Things Banana">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={new URL(path, Astro.site)}>
  <meta property="og:image" content={new URL(image, Astro.site)}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={new URL(image, Astro.site)}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#FBF4E2" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#16110A" media="(prefers-color-scheme: dark)">
  <!-- the visitor's chosen theme, before anything is drawn (so the page never flashes the wrong one) -->
  <script is:inline>try { var t = localStorage.getItem('atb-theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch (e) {}</script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <header class="mast">
    <div class="wrap wide mast-in">
      <a class="logo" href="/" aria-label="All Things Banana, home">
        <svg class="mark" viewBox="0 0 32 32" aria-hidden="true"><path d="M5.5 8.5c1.5 11 11 18.5 22 14.5-1.5 3.5-5.5 5.5-10.5 5.5C9.5 28.5 4 20 5.5 8.5z" fill="var(--banana)" stroke="var(--ink)" stroke-width="2.2" stroke-linejoin="round"/><path d="M5.5 8.5 4.6 4.4l3 1.3" fill="none" stroke="var(--ink)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span class="word">allthingsbanana</span>
      </a>
      <nav class="tabs" aria-label="Main">
        {tabs.map(t => <a href={t.href} class={section === t.id ? 'on' : ''} aria-current={section === t.id ? 'page' : undefined}><span class="t-l">{t.label}</span><span class="t-d">{t.desc}</span></a>)}
      </nav>
      <div class="tools">
        <button class="icon" id="searchBtn" aria-label="Search recipes, prices and news" aria-expanded="false" aria-controls="search">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        </button>
        <button class="icon" id="themeBtn" aria-label="Switch theme">
          <svg class="moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg>
          <svg class="sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"/></svg>
        </button>
      </div>
    </div>
    <div class="search" id="search" hidden>
      <div class="wrap wide">
        <input id="q" type="search" placeholder="Search recipes, prices or banana news" autocomplete="off" aria-label="Search" aria-controls="qres">
        <div class="qres" id="qres" hidden></div>
      </div>
    </div>
  </header>
  {ticker && (
    <div class="board-strip" aria-label="Market board">
      <div class="wrap wide tk-in" id="tickers">
        {Array.from({ length: 6 }).map(() => <div class="tk sk"><span></span><span></span></div>)}
      </div>
    </div>
  )}

  <main class={bare ? 'bare' : wide ? 'wrap wide' : 'wrap'}><slot /></main>
  <script type="application/json" id="recipe-index" set:html={JSON.stringify(recipeIndex)} />

  <footer class="foot">
    <div class="wrap wide">
      <nav class="foot-links" aria-label="More">
        <a href="/bananadle/">Bananadle</a><a href="/more/banana-clicker/">Banana Clicker</a><a href="/recipes/">Recipes</a>
        <a href="/bananalytics/">Prices</a><a href="/bananalytics/world/">Banana World map</a><a href="/news/">News</a>
        <a href="/topics/">Topics</a><a href="/more/banana-cube/">Banana Cube</a><a href="/more/">All games</a>
        <a href="/about/">About</a><a href="/privacy/">Privacy</a>
      </nav>
      <p class="small">© {new Date().getFullYear()} All Things Banana. Prices are delayed or monthly averages. Not financial advice, obviously.</p>
    </div>
  </footer>
</body>
</html>

<script>
  import { getMarket, getFeed, allSeries, lookup, label, tickerCode, money, signed, lastChange, marketLink, esc, ago, type Sel, type Feed } from '../scripts/market';
  import { sparkline } from '../scripts/charts';

  // ---------- banana popularity: one anonymous page view per page ----------
  if (!navigator.webdriver) fetch('/api/visits', { method: 'POST', keepalive: true }).catch(() => {});   // skips automated browsers

  // ---------- theme: follows the system unless the visitor picks one ----------
  const root = document.documentElement, themeBtn = document.getElementById('themeBtn')!;
  const isDark = () => (root.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')) === 'dark';
  const syncTheme = () => { themeBtn.setAttribute('aria-label', isDark() ? 'Switch to light theme' : 'Switch to dark theme'); root.classList.toggle('is-dark', isDark()); };
  themeBtn.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('atb-theme', next); } catch {}
    syncTheme();
  });
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', syncTheme);
  syncTheme();

  // ---------- market strip (only on pages that ask for it) ----------
  const tickers = document.getElementById('tickers');
  if (tickers) {
    const TICKERS = ['PBANSOP', 'APU0000711211', 'PORANG', 'PCOCO', 'PCOFFOTM', 'PSUGAISA', 'DOLE', 'FDP'];
    Promise.all([getMarket(), getFeed().catch(() => null)]).then(([m, f]) => {
      const quotes = new Map((f?.stocks || []).map(q => [q.symbol, q]));
      const html = (TICKERS.map(c => lookup(m, c)).filter(Boolean) as Sel[]).map(s => {
        const pts = s.pts, last = pts[pts.length - 1], prev = pts[pts.length - 2], q = quotes.get(s.code);
        const price = q?.price ?? last.y, ch = q?.change ?? last.y - prev.y, chp = q?.changePct ?? lastChange(pts) ?? 0;
        return `<a class="tk" href="${marketLink(s.code)}">
          <span class="tk-n">${esc(label(s))}</span>
          <span class="tk-v num">${money(s, price)}</span>
          <span class="tk-c num ${chp >= 0 ? 'up' : 'down'}">${chp >= 0 ? '▲' : '▼'} ${signed(chp).replace(/^[+-]/, '')}%</span>
          ${sparkline(pts.slice(s.daily ? -40 : -12).map(p => p.y), 56, 26)}
        </a>`;
      }).join('');
      tickers.innerHTML = html || '<span class="muted">Market data is unavailable right now.</span>';
    }).catch(() => { tickers.innerHTML = '<span class="muted">Market data is unavailable right now.</span>'; });
  }

  // ---------- search (opens from the magnifier) ----------
  const panel = document.getElementById('search')!, searchBtn = document.getElementById('searchBtn')!;
  const input = document.getElementById('q') as HTMLInputElement, box = document.getElementById('qres')!;
  const openSearch = (open: boolean) => {
    panel.hidden = !open;
    searchBtn.setAttribute('aria-expanded', String(open));
    if (open) input.focus(); else box.hidden = true;
  };
  searchBtn.addEventListener('click', () => openSearch(panel.hidden));
  let series: Sel[] = [], feed: Feed | null = null, first: string | null = null;
  type R = { n: string; s: string; e: string; b: string; t: string };
  let recipeIdx: R[] = [];
  try { recipeIdx = JSON.parse(document.getElementById('recipe-index')!.textContent || '[]'); } catch {}
  input.addEventListener('focus', () => {
    getMarket().then(m => (series = allSeries(m))).catch(() => {});
    getFeed().then(f => (feed = f)).catch(() => {});
  }, { once: true });
  function results() {
    const q = input.value.trim().toLowerCase();
    if (!q) { box.hidden = true; first = null; return; }
    const prices = series.filter(s => `${label(s)} ${s.code} ${s.desc} ${tickerCode(s)}`.toLowerCase().includes(q)).slice(0, 6);
    const news = (feed?.items || []).filter(it => it.title.toLowerCase().includes(q)).slice(0, 6);
    const recs = recipeIdx.filter(r => r.t.includes(q)).slice(0, 5);
    first = recs[0] ? `/recipes/${recs[0].s}/` : prices[0] ? marketLink(prices[0].code) : news[0]?.url ?? null;
    box.innerHTML = (recs.length ? `<div class="qh">Recipes</div>` + recs.map(r => `<a href="/recipes/${r.s}/">
        <b>${esc(r.n)}</b><span>${esc(r.b)}</span></a>`).join('') + (recipeIdx.filter(r => r.t.includes(q)).length > 5 ? `<a href="/recipes/?q=${encodeURIComponent(input.value.trim())}"><b>See all matching recipes →</b></a>` : '') : '')
      + (prices.length ? `<div class="qh">Prices</div>` + prices.map(s => `<a href="${marketLink(s.code)}">
        <b>${esc(label(s))}</b><span>${esc(s.desc)}</span><em class="num">${money(s, s.pts[s.pts.length - 1].y)}</em></a>`).join('') : '')
      + (news.length ? `<div class="qh">News</div>` + news.map(it => `<a href="${esc(it.url)}" target="_blank" rel="noopener nofollow">
        <b class="nt">${esc(it.title)}</b><span>${esc(it.source)} · ${ago(it.published)}</span></a>`).join('') : '')
      || `<div class="qnone">Nothing banana-shaped matches “${esc(input.value.trim())}”.</div>`;
    box.hidden = false;
  }
  input.addEventListener('input', results);
  input.addEventListener('keydown', e => {
    if (e.key === 'Enter' && first) { if (first.startsWith('http')) window.open(first, '_blank', 'noopener'); else location.href = first; }
    if (e.key === 'Escape') openSearch(false);
  });
  document.addEventListener('click', e => { if (!panel.hidden && !(e.target as HTMLElement).closest('#search, #searchBtn')) openSearch(false); });
</script>

<style is:global>
  /* ---------- header ---------- */
  .mast { background: var(--paper); border-bottom: 2px solid var(--ink); position: relative; z-index: 20; }
  .mast-in { display: flex; align-items: center; gap: 18px; min-height: 64px; }
  .logo { display: flex; align-items: center; gap: 8px; text-decoration: none; color: var(--ink); flex: none; }
  .logo .mark { width: 30px; height: 30px; }
  .logo .word { font: 400 21px/1 var(--display); }
  .tabs { display: flex; gap: 4px; margin-left: auto; }
  .tabs a { display: flex; flex-direction: column; justify-content: center; text-decoration: none; padding: 8px 12px; min-height: 48px; color: var(--ink-2); }
  .tabs .t-l { font: 700 15.5px/1.15 var(--text); }
  .tabs .t-d { font: 500 12.5px/1.2 var(--text); color: var(--ink-3); }
  .tabs a:hover { color: var(--ink); }
  .tabs a.on { color: var(--ink); box-shadow: inset 0 -4px 0 var(--banana-ink); }
  .tools { display: flex; gap: 4px; }
  .icon { width: 44px; height: 44px; display: grid; place-items: center; border-radius: var(--r-ctl); border: 2px solid transparent; background: none; color: var(--ink); cursor: pointer; }
  .icon:hover, .icon[aria-expanded="true"] { border-color: var(--ink); }
  .icon .sun { display: none; }
  .is-dark .icon .sun { display: block; }
  .is-dark .icon .moon { display: none; }

  .search { border-top: 2px solid var(--ink); background: var(--card); padding: 12px 0; position: absolute; left: 0; right: 0; top: 100%; border-bottom: 2px solid var(--ink); }
  .search .wrap { position: relative; }
  .search input { width: 100%; height: 48px; border: 2px solid var(--ink); border-radius: var(--r-ctl); background: var(--paper); color: var(--ink); padding: 0 14px; font: 500 17px var(--text); outline: none; }
  .search input:focus { box-shadow: 0 0 0 3px var(--banana); }
  .qres { margin-top: 8px; max-height: 65vh; overflow: auto; }
  .qres .qh { font: 700 var(--t-label) var(--text); letter-spacing: .12em; text-transform: uppercase; color: var(--ink-3); padding: 10px 4px 4px; }
  .qres a { display: grid; grid-template-columns: 1fr auto; gap: 0 12px; padding: 10px 6px; text-decoration: none; border-bottom: 1px solid var(--line); min-height: 44px; }
  .qres a:hover { background: var(--paper-2); }
  .qres b { font-size: 15px; }
  .qres b.nt { grid-column: 1 / -1; font-weight: 600; }
  .qres span { font-size: 13px; color: var(--ink-3); grid-column: 1; }
  .qres em { font-style: normal; font-weight: 700; font-size: 14px; grid-column: 2; grid-row: 1 / span 2; align-self: center; }
  .qnone { padding: 14px 4px; color: var(--ink-3); }

  /* ---------- market strip (home and Prices) ---------- */
  .board-strip { border-bottom: 2px solid var(--ink); background: var(--card); }
  .tk-in { display: flex; overflow-x: auto; scrollbar-width: none; }
  .tk-in::-webkit-scrollbar { display: none; }
  .tk { display: grid; grid-template-columns: auto auto; column-gap: 12px; padding: 9px 18px 9px 0; margin-right: 18px; text-decoration: none; min-width: 150px; border-right: 2px solid var(--line); flex: none; }
  .tk:last-child { border-right: none; }
  .tk-n { font: 700 12px var(--text); letter-spacing: .1em; text-transform: uppercase; color: var(--ink-2); white-space: nowrap; }
  .tk-v { font: 400 19px/1.15 var(--display); grid-column: 1; }
  .tk-c { font-size: 13px; font-weight: 700; grid-column: 1; white-space: nowrap; }
  .tk .spark { grid-column: 2; grid-row: 1 / span 3; align-self: center; }
  .tk:hover .tk-n { text-decoration: underline; }
  .tk.sk { display: flex; flex-direction: column; gap: 6px; padding: 12px 0; }
  .tk.sk span { display: block; width: 110px; height: 10px; border-radius: 3px; background: var(--paper-2); }

  /* ---------- footer ---------- */
  .foot { border-top: 2px solid var(--ink); margin-top: 48px; padding: 18px 0 26px; }
  .foot-links { display: flex; flex-wrap: wrap; gap: 0 4px; margin-bottom: 8px; }
  .foot-links a { font-weight: 600; font-size: 15px; padding: 10px 10px 10px 0; min-height: 44px; display: inline-flex; align-items: center; text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 3px; margin-right: 8px; }
  .foot-links a:hover { text-decoration-color: var(--banana-ink); }
  .foot .small { margin: 0; color: var(--ink-3); font-size: var(--t-small); }

  /* ---------- phones: two short rows, four equal tabs, no sideways scrolling ---------- */
  @media (max-width: 820px) {
    .mast-in { flex-wrap: wrap; gap: 0 8px; min-height: 0; padding-top: 6px; }
    .logo { order: 1; }
    .tools { order: 2; margin-left: auto; }
    .tabs { order: 3; flex-basis: 100%; margin: 0 -16px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; border-top: 2px solid var(--ink); }
    .tabs a { align-items: center; padding: 8px 2px; min-height: 46px; border-right: 2px solid var(--line); }
    .tabs a:last-child { border-right: 0; }
    .tabs .t-d { display: none; }
    .tabs .t-l { font-size: 15px; }
    .logo .word { font-size: 19px; }
  }
</style>
