---
// bare: the page fills the full width under the header (used by the Banana Cube)
// image: the picture shown when the page is shared (1200×630, in public/og/)
// ticker: show the market strip under the header (Prices only)
// noindex: keep a page out of search engines (pages still being tested)
import '../styles/site.css';
interface Props { title: string; description: string; wide?: boolean; section?: string; bare?: boolean; image?: string; ticker?: boolean; noindex?: boolean }
const { title, description, wide = false, section = '', bare = false, image = '/og/default.jpg', ticker = false, noindex = false } = Astro.props;
const path = Astro.url.pathname;
import { recipes, recipePhoto, formatTime } from '../data/recipes';
// a small index of recipes for the header search and the home page's recipe of the day
const recipeIndex = recipes.map(r => ({ n: r.name, s: r.slug, e: r.emoji, b: r.blurb, p: recipePhoto(r.slug)?.thumb, m: formatTime(r.mins), o: r.origin,
  t: `${r.name} ${r.origin} ${r.meals.join(' ')} ${r.diet.join(' ')}`.toLowerCase() }));
// the logo goes home; four sections, each with its own colour dot
const links = [
  { id: 'bananadle', href: '/bananadle/', label: 'Bananadle', dot: 'd-butter' },
  { id: 'clicker', href: '/more/banana-clicker/', label: 'Clicker', dot: 'd-mint' },
  { id: 'recipes', href: '/recipes/', label: 'Recipes', dot: 'd-peach' },
  { id: 'prices', href: '/bananalytics/', label: 'Prices', dot: 'd-sky' },
  { id: 'banadaw', href: '/banadaw/', label: 'BanaDAW', dot: 'd-lilac' },
];
const mark = `<svg viewBox="0 0 32 32" aria-hidden="true"><path d="M6 9c1.5 10.5 10.5 17.5 21 13.8-1.6 3.4-5.5 5.4-10.2 5.4C10 28.2 4.6 20 6 9z" fill="#F2CF5B" stroke="#3B3127" stroke-width="2" stroke-linejoin="round"/><path d="M6 9 5.2 5l2.8 1.2" fill="none" stroke="#3B3127" stroke-width="2" stroke-linecap="round"/></svg>`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex">}
  <link rel="canonical" href={new URL(path, Astro.site)}>
  <meta property="og:site_name" content="All Things Banana">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={new URL(path, Astro.site)}>
  <meta property="og:image" content={new URL(image, Astro.site)}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={new URL(image, Astro.site)}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#FFFBF2" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#1D1A16" media="(prefers-color-scheme: dark)">
  <!-- the visitor's chosen theme, before anything is drawn (so the page never flashes the wrong one) -->
  <script is:inline>try { var t = localStorage.getItem('atb-theme'); if (t === 'light' || t === 'dark' || t === 'banana') document.documentElement.dataset.theme = t; } catch (e) {}</script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
  <div class="drift" aria-hidden="true"><i style="left:2%;top:18%"></i><i style="left:95%;top:30%;animation-delay:-3s"></i><i style="left:4%;top:72%;animation-delay:-5s;width:60px;height:60px"></i><i style="left:93%;top:82%;animation-delay:-1.5s"></i></div>
  <header class="mast">
    <div class="wrap wide mast-in">
      <a class="logo" href="/" aria-label="All Things Banana, home"><span class="mark" set:html={mark}></span><span class="word">allthingsbanana</span></a>
      <nav class="links" aria-label="Main">
        {links.map(l => <a href={l.href} class={section === l.id ? 'on' : ''} aria-current={section === l.id ? 'page' : undefined}><i class={`dot ${l.dot}`}></i>{l.label}</a>)}
      </nav>
      <div class="tools">
        <button class="icon" id="searchBtn" aria-label="Search recipes, prices and news" aria-expanded="false" aria-controls="search">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        </button>
        <button class="icon" id="themeBtn" aria-label="Switch theme" title="Light, dark or banana">
          <svg class="i-moon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg>
          <svg class="i-banana" width="22" height="22" viewBox="0 0 32 32" aria-hidden="true"><path d="M6 9c1.5 10.5 10.5 17.5 21 13.8-1.6 3.4-5.5 5.4-10.2 5.4C10 28.2 4.6 20 6 9z" fill="#F2CF5B" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/><path d="M6 9 5.2 5l2.8 1.2" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
          <svg class="i-sun" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"/></svg>
        </button>
      </div>
    </div>
    <div class="search" id="search" hidden>
      <div class="wrap wide">
        <input id="q" type="search" placeholder="Search recipes, prices or banana news" autocomplete="off" aria-label="Search" aria-controls="qres">
        <div class="qres" id="qres" hidden></div>
      </div>
    </div>
  </header>
  {ticker && (
    <div class="board-strip" aria-label="Market board">
      <div class="wrap wide tk-in" id="tickers">
        {Array.from({ length: 6 }).map(() => <div class="tk sk"><span></span><span></span></div>)}
      </div>
    </div>
  )}

  <main class={bare ? 'bare' : wide ? 'wrap wide' : 'wrap'}><slot /></main>
  <script type="application/json" id="recipe-index" set:html={JSON.stringify(recipeIndex)} />

  <footer class="foot">
    <div class="wrap wide">
      <nav class="foot-links" aria-label="More">
        <a href="/bananadle/">Bananadle</a><a href="/more/banana-clicker/">Banana Clicker</a><a href="/recipes/">Recipes</a>
        <a href="/bananalytics/">Prices</a><a href="/bananalytics/world/">Banana World map</a><a href="/news/">News</a>
        <a href="/topics/">Topics</a><a href="/more/banana-cube/">Banana Cube</a><a href="/banadaw/">BanaDAW</a><a href="/more/">All games</a>
        <a href="/about/">About</a><a href="/privacy/">Privacy</a>
      </nav>
      <p class="small" data-banana="© All Things Banana. A website about bananas, by bananas, for bananas.">© {new Date().getFullYear()} All Things Banana. Prices are delayed or monthly averages. Not financial advice, obviously.</p>
    </div>
  </footer>

  <!-- phones: the four sections in a bar at the bottom, in reach of a thumb -->
  <nav class="dock" aria-label="Main">
    {links.map(l => <a href={l.href} class={section === l.id ? 'on' : ''} aria-current={section === l.id ? 'page' : undefined}><i class={`dot ${l.dot}`}></i>{l.label}</a>)}
  </nav>
  <div class="theme-note" id="themeNote" role="status"></div>
</body>
</html>

<script>
  import { getMarket, getFeed, allSeries, lookup, label, tickerCode, money, signed, lastChange, marketLink, esc, ago, type Sel, type Feed } from '../scripts/market';
  import { sparkline } from '../scripts/charts';

  // ---------- banana popularity: one anonymous page view per page ----------
  if (!navigator.webdriver) fetch('/api/visits', { method: 'POST', keepalive: true }).catch(() => {});   // skips automated browsers

  // ---------- themes: light → dark → banana ----------
  const root = document.documentElement, themeBtn = document.getElementById('themeBtn')!, note = document.getElementById('themeNote')!;
  const ORDER = ['light', 'dark', 'banana'] as const;
  type Theme = typeof ORDER[number];
  const LABEL: Record<Theme, string> = { light: 'Light', dark: 'Dark', banana: 'Banana mode' };
  const current = (): Theme => (root.dataset.theme as Theme) || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  const swapped = new Map<Element, string>();
  // banana mode: every B becomes a banana, and a few lines of copy go silly
  function swapCopy(on: boolean) {
    document.querySelectorAll<HTMLElement>('[data-banana]').forEach(el => {
      if (on) { if (!swapped.has(el)) swapped.set(el, el.textContent || ''); el.textContent = el.dataset.banana!; }
      else if (swapped.has(el)) { el.textContent = swapped.get(el)!; swapped.delete(el); }
    });
  }
  function bananify(on: boolean) {
    if (!on) { document.querySelectorAll('banana-run').forEach(r => r.replaceWith(document.createTextNode(r.textContent || ''))); document.body.normalize(); return; }
    const walk = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
      acceptNode: n => n.parentElement!.closest('script, style, svg, input, textarea, select, option, banana-run, [data-no-banana]') || !/[bB]/.test(n.nodeValue || '') ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT,
    });
    const nodes: Text[] = []; while (walk.nextNode()) nodes.push(walk.currentNode as Text);
    for (const n of nodes) {
      const run = document.createElement('banana-run');
      // words with a B stay in one piece, so a line never breaks between the banana and the rest of the word
      (n.nodeValue || '').split(/(\S*[bB]\S*)/).forEach(chunk => {
        if (!/[bB]/.test(chunk)) { if (chunk) run.append(chunk); return; }
        const word = document.createElement('banana-w');
        chunk.split(/([bB])/).forEach(part => {
          if (part === 'b' || part === 'B') { const b = document.createElement('banana-b'); if (part === 'B') b.className = 'big'; b.textContent = part; word.append(b); }
          else if (part) word.append(part);
        });
        run.append(word);
      });
      n.replaceWith(run);
    }
  }
  let banana = false;
  function applyTheme(announce: boolean) {
    const t = current();
    themeBtn.dataset.theme = t;
    themeBtn.setAttribute('aria-label', `Theme: ${LABEL[t]}. Switch to ${LABEL[ORDER[(ORDER.indexOf(t) + 1) % 3]]}`);
    if ((t === 'banana') !== banana) { banana = t === 'banana'; if (!banana) bananify(false); swapCopy(banana); if (banana) bananify(true); }
    if (announce) { note.textContent = t === 'banana' ? 'Banana mode. You asked for this.' : `${LABEL[t]} mode`; note.classList.add('show'); setTimeout(() => note.classList.remove('show'), 1600); }
  }
  themeBtn.addEventListener('click', () => {
    const next = ORDER[(ORDER.indexOf(current()) + 1) % 3];
    root.dataset.theme = next;
    try { localStorage.setItem('atb-theme', next); } catch {}
    applyTheme(true);
  });
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => applyTheme(false));
  applyTheme(false);
  // content that arrives later (news, the puzzle) gets bananas too
  let pending = 0;
  new MutationObserver(() => { if (banana && !pending) pending = requestAnimationFrame(() => { pending = 0; bananify(true); }); }).observe(document.querySelector('main')!, { childList: true, subtree: true, characterData: true });

  // ---------- market strip (Prices only) ----------
  const tickers = document.getElementById('tickers');
  if (tickers) {
    const TICKERS = ['PBANSOP', 'APU0000711211', 'PORANG', 'PCOCO', 'PCOFFOTM', 'PSUGAISA', 'DOLE', 'FDP'];
    Promise.all([getMarket(), getFeed().catch(() => null)]).then(([m, f]) => {
      const quotes = new Map((f?.stocks || []).map(q => [q.symbol, q]));
      const html = (TICKERS.map(c => lookup(m, c)).filter(Boolean) as Sel[]).map(s => {
        const pts = s.pts, last = pts[pts.length - 1], q = quotes.get(s.code);
        const price = q?.price ?? last.y, chp = q?.changePct ?? lastChange(pts) ?? 0;
        return `<a class="tk" href="${marketLink(s.code)}">
          <span class="tk-n">${esc(label(s))}</span>
          <span class="tk-v num">${money(s, price)}</span>
          <span class="tk-c num ${chp >= 0 ? 'up' : 'down'}">${chp >= 0 ? '▲' : '▼'} ${signed(chp).replace(/^[+-]/, '')}%</span>
          ${sparkline(pts.slice(s.daily ? -40 : -12).map(p => p.y), 56, 26)}
        </a>`;
      }).join('');
      tickers.innerHTML = html || '<span class="muted">Market data is unavailable right now.</span>';
    }).catch(() => { tickers.innerHTML = '<span class="muted">Market data is unavailable right now.</span>'; });
  }

  // ---------- search (opens from the magnifier) ----------
  const panel = document.getElementById('search')!, searchBtn = document.getElementById('searchBtn')!;
  const input = document.getElementById('q') as HTMLInputElement, box = document.getElementById('qres')!;
  const openSearch = (open: boolean) => {
    panel.hidden = !open;
    searchBtn.setAttribute('aria-expanded', String(open));
    if (open) input.focus(); else box.hidden = true;
  };
  searchBtn.addEventListener('click', () => openSearch(panel.hidden));
  let series: Sel[] = [], feed: Feed | null = null, first: string | null = null;
  type R = { n: string; s: string; e: string; b: string; t: string };
  let recipeIdx: R[] = [];
  try { recipeIdx = JSON.parse(document.getElementById('recipe-index')!.textContent || '[]'); } catch {}
  input.addEventListener('focus', () => {
    getMarket().then(m => (series = allSeries(m))).catch(() => {});
    getFeed().then(f => (feed = f)).catch(() => {});
  }, { once: true });
  function results() {
    const q = input.value.trim().toLowerCase();
    if (!q) { box.hidden = true; first = null; return; }
    const prices = series.filter(s => `${label(s)} ${s.code} ${s.desc} ${tickerCode(s)}`.toLowerCase().includes(q)).slice(0, 6);
    const news = (feed?.items || []).filter(it => it.title.toLowerCase().includes(q)).slice(0, 6);
    const recs = recipeIdx.filter(r => r.t.includes(q)).slice(0, 5);
    first = recs[0] ? `/recipes/${recs[0].s}/` : prices[0] ? marketLink(prices[0].code) : news[0]?.url ?? null;
    box.innerHTML = (recs.length ? `<div class="qh">Recipes</div>` + recs.map(r => `<a href="/recipes/${r.s}/">
        <b>${esc(r.n)}</b><span>${esc(r.b)}</span></a>`).join('') + (recipeIdx.filter(r => r.t.includes(q)).length > 5 ? `<a href="/recipes/?q=${encodeURIComponent(input.value.trim())}"><b>See all matching recipes →</b></a>` : '') : '')
      + (prices.length ? `<div class="qh">Prices</div>` + prices.map(s => `<a href="${marketLink(s.code)}">
        <b>${esc(label(s))}</b><span>${esc(s.desc)}</span><em class="num">${money(s, s.pts[s.pts.length - 1].y)}</em></a>`).join('') : '')
      + (news.length ? `<div class="qh">News</div>` + news.map(it => `<a href="${esc(it.url)}" target="_blank" rel="noopener nofollow">
        <b class="nt">${esc(it.title)}</b><span>${esc(it.source)} · ${ago(it.published)}</span></a>`).join('') : '')
      || `<div class="qnone">Nothing banana-shaped matches “${esc(input.value.trim())}”.</div>`;
    box.hidden = false;
  }
  input.addEventListener('input', results);
  input.addEventListener('keydown', e => {
    if (e.key === 'Enter' && first) { if (first.startsWith('http')) window.open(first, '_blank', 'noopener'); else location.href = first; }
    if (e.key === 'Escape') openSearch(false);
  });
  document.addEventListener('click', e => { if (!panel.hidden && !(e.target as HTMLElement).closest('#search, #searchBtn')) openSearch(false); });
</script>

<style is:global>
  /* ---------- header ---------- */
  .mast { border-bottom: 1px solid var(--line); background: var(--paper); position: relative; z-index: 20; }
  :root[data-theme="banana"] .mast { background: transparent; border-bottom-color: #3A2A0E; }
  .mast-in { display: flex; align-items: center; gap: 28px; height: 70px; }
  .logo { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ink); flex: none; }
  .logo .mark { width: 36px; height: 36px; border-radius: var(--r-md); background: var(--butter); display: grid; place-items: center; }
  .logo .mark svg { width: 24px; height: 24px; }
  :root[data-theme="banana"] .logo .mark { background: #FFF4BF; transform: rotate(-12deg); }
  @media (prefers-reduced-motion: no-preference) { :root[data-theme="banana"] .logo .mark { animation: wobble 2.4s ease-in-out infinite; } }
  @keyframes wobble { 50% { transform: rotate(10deg); } }
  .logo .word { font: 600 22px/1 var(--display); }
  .links { display: flex; gap: 26px; }
  .links a { display: flex; align-items: center; gap: 8px; text-decoration: none; font-weight: 700; font-size: 16px; color: var(--ink-2); padding: 12px 0; position: relative; }
  .links a:hover, .links a.on { color: var(--ink); }
  .links a.on::after { content: ''; position: absolute; left: 18px; right: 0; bottom: 4px; height: 3px; border-radius: 3px; background: var(--butter-d); }
  .tools { margin-left: auto; display: flex; gap: 8px; }
  .icon { width: 44px; height: 44px; border-radius: var(--r-md); border: 1px solid var(--line); background: var(--card); color: var(--ink); display: grid; place-items: center; cursor: pointer; }
  .icon:hover, .icon[aria-expanded="true"] { border-color: var(--butter-d); }
  #themeBtn svg { display: none; }
  #themeBtn[data-theme="light"] .i-moon, #themeBtn[data-theme="dark"] .i-banana, #themeBtn[data-theme="banana"] .i-sun { display: block; }

  .search { border-top: 1px solid var(--line); background: var(--card); padding: 14px 0; position: absolute; left: 0; right: 0; top: 100%; box-shadow: var(--shadow); }
  .search input { width: 100%; height: 50px; border: 1px solid var(--line); border-radius: var(--r-md); background: var(--paper); color: var(--ink); padding: 0 16px; font: 600 17px var(--text); outline: none; }
  .search input:focus { box-shadow: 0 0 0 3px var(--butter-d); }
  .qres { margin-top: 8px; max-height: 65vh; overflow: auto; }
  .qres .qh { font: 800 var(--t-label) var(--text); color: var(--ink-2); padding: 10px 4px 4px; }
  .qres a { display: grid; grid-template-columns: 1fr auto; gap: 0 12px; padding: 10px 8px; text-decoration: none; border-radius: var(--r-sm); min-height: 44px; }
  .qres a:hover { background: var(--paper-2); }
  .qres b { font-size: 16px; }
  .qres b.nt { grid-column: 1 / -1; font-weight: 700; }
  .qres span { font-size: 14px; color: var(--ink-2); grid-column: 1; }
  .qres em { font-style: normal; font-weight: 800; font-size: 15px; grid-column: 2; grid-row: 1 / span 2; align-self: center; }
  .qnone { padding: 14px 4px; color: var(--ink-2); }

  /* ---------- market strip (Prices) ---------- */
  .board-strip { border-bottom: 1px solid var(--line); }
  .tk-in { display: flex; overflow-x: auto; scrollbar-width: none; gap: 12px; padding-top: 12px; padding-bottom: 12px; }
  .tk-in::-webkit-scrollbar { display: none; }
  .tk { display: grid; grid-template-columns: auto auto; column-gap: 12px; padding: 8px 14px; text-decoration: none; min-width: 160px; flex: none; background: var(--card); border-radius: var(--r-md); box-shadow: var(--shadow); }
  .tk-n { font: 800 13px var(--text); color: var(--ink-2); white-space: nowrap; }
  .tk-v { font: 600 18px/1.2 var(--display); grid-column: 1; }
  .tk-c { font-size: 13.5px; font-weight: 800; grid-column: 1; white-space: nowrap; }
  .tk .spark { grid-column: 2; grid-row: 1 / span 3; align-self: center; }
  .tk.sk { display: flex; flex-direction: column; gap: 6px; padding: 14px; }
  .tk.sk span { display: block; width: 110px; height: 10px; border-radius: 4px; background: var(--paper-2); }

  /* ---------- footer ---------- */
  .foot { border-top: 1px solid var(--line); margin-top: 48px; padding: 20px 0 28px; position: relative; z-index: 1; }
  :root[data-theme="banana"] .foot { border-top-color: #3A2A0E; }
  .foot-links { display: flex; flex-wrap: wrap; gap: 0 20px; margin-bottom: 6px; }
  .foot-links a { font-weight: 700; font-size: 15.5px; padding: 10px 0; min-height: 44px; display: inline-flex; align-items: center; text-decoration: none; }
  .foot-links a:hover { text-decoration: underline; text-decoration-color: var(--butter-d); text-decoration-thickness: 2px; }
  .foot .small { margin: 0; color: var(--ink-2); font-size: var(--t-small); }

  .theme-note { position: fixed; left: 50%; top: 84px; transform: translateX(-50%); z-index: 60; background: var(--ink); color: var(--paper); font-weight: 800; padding: 9px 18px; border-radius: var(--r-md); opacity: 0; pointer-events: none; transition: opacity .3s; }
  .theme-note.show { opacity: 1; }

  /* ---------- phones: logo and icons on top, the sections in a bar at the bottom ---------- */
  .dock { display: none; }
  @media (max-width: 760px) {
    .links { display: none; }
    .mast-in { height: 62px; gap: 12px; }
    .logo .word { font-size: 20px; }
    body { padding-bottom: 82px; }
    .dock { display: grid; grid-template-columns: repeat(5, 1fr); position: fixed; left: 10px; right: 10px; bottom: 10px; z-index: 30; background: var(--card); border: 1px solid var(--line); border-radius: 16px; box-shadow: 0 6px 24px rgba(60, 45, 15, .16); padding: 6px; }
    :root[data-theme="banana"] .dock { border: 2px solid #3A2A0E; }
    .dock a { display: flex; flex-direction: column; align-items: center; gap: 4px; text-decoration: none; font-weight: 800; font-size: 12.5px; padding: 8px 0; border-radius: 12px; color: var(--ink-2); min-height: 52px; justify-content: center; }
    .dock a .dot { width: 24px; height: 8px; border-radius: 999px; opacity: .6; }
    .dock a.on { color: var(--ink); background: var(--butter); }
    .dock a.on .dot { opacity: 1; }
  }
</style>
